                  class={`w-3 h-3 rounded-full border border-gray-400 transition-all ${i === 0 ? 'bg-gray-900 border-gray-900' : 'bg-transparent hover:bg-gray-300'}`}
                  data-reviews-dot
                  data-index={i}
                  aria-label={`Go to review ${i + 1}`}
                ></button>
              ))}
            </div>

            {/* CTA */}
            <div class="text-center mt-10">
              <a
                href="/free-estimate"
                class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
              >
                Get Your Quote
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
