                  <text x="500" y="255" font-family="system-ui" font-size="8" font-weight="700" fill="#475569">Daytona</text>
                </g>

                {/* Highway markers (subtle) — I-75 vertical, I-4 going to Orlando */}
                <g stroke="#fbbf24" stroke-width="1.5" fill="none" opacity="0.4" stroke-dasharray="6,3">
                  <path d="M 222 130 Q 218 170 215 220 Q 212 270 200 320"/>
                  <path d="M 230 220 Q 290 260 350 290"/>
                </g>

                {/* I-75 label */}
                <g opacity="0.6" transform="translate(202, 260)">
                  <rect x="-7" y="-5" width="14" height="10" fill="#fbbf24" stroke="#92400e" stroke-width="0.5" rx="2"/>
                  <text x="0" y="3" font-family="system-ui" font-size="6" font-weight="800" fill="#7c2d12" text-anchor="middle">I-75</text>
                </g>

                {/* I-4 label */}
                <g opacity="0.6" transform="translate(310, 280)">
                  <rect x="-6" y="-5" width="12" height="10" fill="#fbbf24" stroke="#92400e" stroke-width="0.5" rx="2"/>
                  <text x="0" y="3" font-family="system-ui" font-size="6" font-weight="800" fill="#7c2d12" text-anchor="middle">I-4</text>
                </g>

                {/* Compass rose (top right) */}
                <g transform="translate(560, 95)" opacity="0.7">
                  <circle r="18" fill="white" stroke="#9ca3af" stroke-width="1"/>
                  <text x="0" y="-5" font-family="system-ui" font-size="11" font-weight="800" fill="#136229" text-anchor="middle">N</text>
                  <path d="M 0 -11 L 3 -3 L 0 -2 L -3 -3 Z" fill="#136229"/>
                  <text x="0" y="13" font-family="system-ui" font-size="7" font-weight="700" fill="#9ca3af" text-anchor="middle">S</text>
                  <line x1="-12" y1="0" x2="12" y2="0" stroke="#9ca3af" stroke-width="0.5"/>
                  <text x="-13" y="2" font-family="system-ui" font-size="7" font-weight="700" fill="#9ca3af" text-anchor="end">W</text>
                  <text x="13" y="2" font-family="system-ui" font-size="7" font-weight="700" fill="#9ca3af" text-anchor="start">E</text>
                </g>

                {/* Scale bar */}
                <g transform="translate(40, 415)" opacity="0.7">
                  <rect x="0" y="-4" width="50" height="8" fill="white" stroke="#374151" stroke-width="1"/>
                  <rect x="0" y="-4" width="25" height="8" fill="#374151"/>
                  <text x="-3" y="15" font-family="system-ui" font-size="8" font-weight="700" fill="#374151" text-anchor="end">0</text>
                  <text x="25" y="15" font-family="system-ui" font-size="8" font-weight="700" fill="#374151" text-anchor="middle">25</text>
                  <text x="55" y="15" font-family="system-ui" font-size="8" font-weight="700" fill="#374151" text-anchor="start">50 MI</text>
                </g>
              </svg>

              {/* Floating "+18 more cities" badge */}
              <div class="absolute top-3 right-3 bg-highlight text-primary-900 text-[10px] lg:text-xs uppercase tracking-wider font-extrabold px-3 py-1.5 shadow-md">
                + {BUSINESS.extendedCoverage.additionalCities.length} more cities
              </div>
            </div>

            {/* Map legend */}
            <div class="border-t border-gray-200 px-5 py-4 bg-white">
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-3 h-3 rounded-full bg-primary border-2 border-white shadow-sm"></span>
                  <span class="text-gray-700 font-semibold">Primary cities</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-highlight border border-accent"></span>
                  <span class="text-gray-700 font-semibold">Extended coverage</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block w-3 h-3 rounded-full border-2 border-primary bg-primary/20"></span>
                  <span class="text-gray-700 font-semibold">{BUSINESS.extendedCoverage.radiusMiles}-mile radius</span>
                </div>
              </div>
            </div>

            {/* Extended cities list */}
            <div class="border-t border-gray-200 px-5 py-5 bg-gray-50">
              <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-gray-500 mb-3">Also serving</p>
              <p class="text-sm text-gray-700 leading-relaxed">
                {BUSINESS.extendedCoverage.additionalCities.map((c) => c.name).join(' · ')}
              </p>
              <a
                href="/areas"
                class="inline-flex items-center gap-1.5 mt-4 text-primary hover:text-primary-700 text-xs uppercase tracking-wider font-extrabold transition-colors"
              >
                View Full Coverage Map
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Open invitation — call CTA centered below */}
      <div class="mt-10 lg:mt-14 max-w-2xl mx-auto text-center">
        <p class="text-base lg:text-lg text-gray-700 leading-relaxed">
          <strong class="text-primary-900">Don't see your specific area?</strong> Just call — chances are we cover it.
        </p>
        <a href={`tel:${BUSINESS.phoneE164}`} class="inline-flex items-center gap-2 mt-3 text-primary hover:text-primary-700 font-extrabold text-xl lg:text-2xl transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515L10.42 8.03a2 2 0 01-.45 1.95l-1.27 1.27a11 11 0 005.05 5.05l1.27-1.27a2 2 0 011.95-.45l3.515.879A2 2 0 0122 17.72V20a2 2 0 01-2 2h-1C9.611 22 2 14.389 2 5V5a2 2 0 011-2z"/></svg>
          {BUSINESS.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container-page max-w-3xl">
      <div class="text-center mb-10">
        <span class="badge-highlight mb-4">FAQ</span>
        <h2 class="mb-3 text-balance">Frequently asked questions</h2>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- Still on the Fence? — 8 closing reasons (Big Jerry's-style) -->
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <h2 class="mb-4 text-balance">Still on the fence?</h2>
        <p class="text-gray-600 text-lg italic">
          Eight more reasons to let Ocala Fence Install build your perfect fence.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 lg:gap-x-10 lg:gap-y-16">
        {[
          {
            n: 1,
            title: 'Personalized Service',
            body: 'Every project starts with Andry visiting your property in person — measuring, listening, and tailoring the solution to your needs.',
          },
          {
            n: 2,
            title: '5+ Years in Marion County',
            body: 'Locally owned and operated since 2021. We know Florida soil, the permits, the HOAs, and the wildlife.',
          },
          {
            n: 3,
            title: 'Florida Fence Specialists',
            body: 'Vinyl privacy, vinyl picket, and hurricane-rated aluminum — one team, three premium materials, all built for Florida weather.',
          },
          {
            n: 4,
            title: 'Free On-Site Estimates',
            body: 'No phone games, no surprise charges. We come measure within 24-48 hours and give you a written quote on the spot.',
          },
          {
            n: 5,
            title: 'Premium Materials Only',
            body: 'Premium vinyl and hurricane-rated aluminum. Lifetime materials warranty — no bargain shortcuts.',
          },
          {
            n: 6,
            title: 'Real People, Real Quotes',
            body: 'No automated online pricing. Every quote is personalized by Andry, who has taken the time to understand your project.',
          },
          {
            n: 7,
            title: '$0 Down Financing',
            body: 'Six lender partners. Pre-qualify in 60 seconds with no credit impact. Most fences end up between $80-$200/month.',
          },
          {
            n: 8,
            title: 'Satisfaction Guaranteed',
            body: 'Walk-through when 100% happy. Lifetime materials warranty + 1-year workmanship. Transferable to the next homeowner.',
          },
        ].map((item) => (
          <div class="flex gap-3 lg:gap-4">
            <div class="shrink-0 text-4xl lg:text-5xl font-extrabold text-gray-300 leading-none">
              {item.n}
            </div>
            <div class="flex-1">
              <h3 class="text-base lg:text-lg font-extrabold text-gray-900 mb-3 leading-tight">
                {item.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                {item.body}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/* CTA */}
      <div class="text-center mt-16 lg:mt-20">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <FinalCTA />
</PageLayout>
