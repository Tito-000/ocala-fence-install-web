---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import TrustBar from '@components/TrustBar.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CityCard from '@components/CityCard.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import FinancingCalculator from '@components/FinancingCalculator.astro';
import ReviewCard from '@components/ReviewCard.astro';
import FAQ from '@components/FAQ.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { BLOG_POSTS } from '@data/blog-posts';

const recentBlogPosts = [...BLOG_POSTS]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);

const homeGalleryImages = [
  { src: '/images/gallery/vinyl-privacy-white-gate.webp', alt: 'White vinyl privacy fence with double gate — Marion Oaks FL', cat: 'Vinyl Privacy', city: 'Marion Oaks' },
  { src: '/images/gallery/durafence-white-side.webp', alt: 'White Dura Fence install — Marion Oaks FL', cat: 'Dura Fence', city: 'Marion Oaks' },
  { src: '/images/gallery/vinyl-privacy-white-long-run.webp', alt: 'White vinyl privacy fence long run with American flag — Ocala FL', cat: 'Vinyl Privacy', city: 'Ocala' },
  { src: '/images/gallery/aluminum-driveway-gate.webp', alt: 'Black aluminum double driveway gate — The Villages FL', cat: 'Aluminum', city: 'The Villages' },
  { src: '/images/gallery/vinyl-picket-white.webp', alt: 'White vinyl picket fence front yard — Silver Springs FL', cat: 'Vinyl Picket', city: 'Silver Springs' },
  { src: '/images/gallery/durafence-bronze-long-run.webp', alt: 'Bronze Dura Fence long run — Ocala FL', cat: 'Dura Fence', city: 'Ocala' },
  { src: '/images/gallery/aluminum-black-yard.webp', alt: 'Black aluminum ornamental fence — Lady Lake FL', cat: 'Aluminum', city: 'Lady Lake' },
  { src: '/images/gallery/durafence-black-long-run.webp', alt: 'Black Dura Fence long run — Marion County FL', cat: 'Dura Fence', city: 'Marion County' },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FenceContractor',
  '@id': 'https://ocalafenceinstall.com#business',
  name: BUSINESS.name,
  url: 'https://ocalafenceinstall.com',
  telephone: BUSINESS.phoneE164,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.latitude,
    longitude: BUSINESS.geo.longitude,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: BUSINESS.hours.phone.open,
    closes: BUSINESS.hours.phone.close,
  }],
  priceRange: '$$$',
  areaServed: BUSINESS.serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.name}, ${a.state}`,
  })),
  image: 'https://ocalafenceinstall.com/images/logo/master.webp',
};

const faqs = [
  { q: 'How long does fence installation take in Ocala?', a: 'Most installations are completed in <strong>less than 7 days</strong> from the signed contract. For urgent projects we can install in 2-3 days.' },
  { q: 'Do you offer financing?', a: 'Yes — <strong>$0 down financing</strong> with no credit impact pre-qualification. We partner with Aqua, Synchrony, Affirm, Klarna, Launch, and United Financial. Pre-qualify in 60 seconds.' },
  { q: 'How long does the materials warranty last?', a: 'Vinyl carries a <strong>lifetime materials warranty</strong> from the manufacturer. Aluminum carries 25+ years. Workmanship is warranted by us for 1 year. Warranty transfers to the next homeowner if you sell.' },
  { q: 'What ZIP codes do you serve?', a: 'We serve all of Marion County (34470-34491), plus The Villages (32162), Lady Lake (32159), and up to 100 miles south of Ocala.' },
  { q: 'Do I need a permit for my fence?', a: 'In unincorporated Marion County, no permit is needed for fences under 6ft. In City of Ocala limits, most fences require a permit. <strong>We handle the permit process for you</strong> either way.' },
  { q: 'What\'s the warranty on materials?', a: 'Lifetime warranty on vinyl, aluminum, and Dura Fence from the manufacturer. 1-year warranty on workmanship from us. Warranty transfers to the next homeowner if you sell.' },
];
---

<PageLayout
  title="Fence Installation Ocala FL | $0 Down · Done in Less Than 7 Days"
  description="Marion County's family-owned fence installation team. Vinyl, aluminum, and Dura Fence installed in less than 7 days. $0 down financing. Free same-day estimate. Call (863) 377-0928."
  activeNav="Home"
  schemaJsonLd={localBusinessSchema}
>
  <Hero
    tag="Marion County · Family-Owned · Licensed & Insured"
    title="Fence Installation in <span class='text-highlight'>Ocala, FL</span> — Done in Less Than 7 Days"
    subtitle="Premium vinyl, aluminum, and Dura Fence installation across Ocala and Marion County. $0 down financing, same-day estimates, lifetime materials warranty. Most fences installed in less than 7 days."
    primaryCta={{ label: 'Get Your Quote', href: '/free-estimate' }}
    secondaryCta={{ label: `Call ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneE164}` }}
  />

  <TrustBar />

  <!-- Services -->
  <section class="section">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Our Services</span>
        <h2 class="mb-3 text-balance">Fences built for Florida homes</h2>
        <p class="text-gray-600 text-lg">Four fence types built for Florida homes. Lifetime materials warranty.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6 max-w-6xl mx-auto">
        {BUSINESS.services.map((s) => (
          <ServiceCard
            slug={s.slug}
            name={s.shortName}
            tagline={s.tagline}
            image={s.image}
            priceFromMonthly={s.priceFromMonthly}
            popular={s.popular}
          />
        ))}
      </div>

      {/* CTA below services grid (Big Jerry's-style) */}
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Protection Story (lifestyle / emotional pull) -->
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Image collage left: main photo + 3 wildlife thumbnails -->
        <div class="relative order-2 lg:order-1">
          <div class="grid grid-cols-3 gap-2 max-w-lg mx-auto mb-3">
            <div class="relative aspect-square overflow-hidden shadow-lg group">
              <img
                src="/images/wildlife/florida-black-bear.webp"
                alt="Florida black bear standing at the edge of an Ocala property — wildlife threat that fences keep out"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="512"
                height="512"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-2">
                <span class="text-white text-[10px] uppercase tracking-wider font-extrabold">Black Bear</span>
              </div>
            </div>
            <div class="relative aspect-square overflow-hidden shadow-lg group">
              <img
                src="/images/wildlife/florida-coyote.webp"
                alt="Florida coyote prowling near a Marion County backyard — wildlife threat that fences keep out"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="512"
                height="512"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-2">
                <span class="text-white text-[10px] uppercase tracking-wider font-extrabold">Coyote</span>
              </div>
            </div>
            <div class="relative aspect-square overflow-hidden shadow-lg group">
              <img
                src="/images/wildlife/florida-alligator.webp"
                alt="American alligator emerging from a Florida retention pond near homes — wildlife threat that fences keep out"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="512"
                height="512"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-2">
                <span class="text-white text-[10px] uppercase tracking-wider font-extrabold">Gator</span>
              </div>
            </div>
          </div>

          <div class="relative rounded-none overflow-hidden shadow-2xl aspect-[16/10] max-w-lg mx-auto">
            <img
              src="/images/lifestyle/kids-dog-protected-backyard.webp"
              alt="Two children and a golden retriever playing safely inside an Ocala backyard secured by a tall white vinyl privacy fence — Florida fence installation"
              class="w-full h-full object-cover"
              loading="lazy"
              width="800"
              height="500"
            />
            <div class="absolute top-3 left-3 bg-primary text-white text-[10px] uppercase tracking-wider font-extrabold px-2.5 py-1">
              ✓ Safe inside the fence
            </div>
          </div>

          <!-- Floating stat badge -->
          <div class="hidden md:block absolute -bottom-6 -right-2 lg:right-6 bg-white rounded-none shadow-2xl p-4 border-l-4 border-highlight max-w-[240px]">
            <div class="text-3xl font-extrabold text-primary leading-none">&lt; 7 days</div>
            <div class="text-xs text-gray-600 mt-1 font-semibold uppercase tracking-wider">From contract to fence</div>
          </div>
        </div>

        <!-- Text right -->
        <div class="order-1 lg:order-2">
          <span class="badge-highlight mb-5">Protection</span>
          <h2 class="mb-5 text-balance">Built to protect <span class="text-primary">what matters most</span></h2>
          <p class="text-gray-700 text-lg leading-relaxed mb-5">
            Florida is wild. <strong>Bears, Coyotes, Gators</strong> — they don't stop at property lines. A real fence does.
          </p>
          <p class="text-gray-600 text-base leading-relaxed mb-8">
            We install premium <strong>Vinyl, Aluminum, and Dura Fence</strong> built to outlast Florida's weather and wildlife. Family-owned and locally operated.
          </p>

          <!-- Bullet trust list -->
          <ul class="space-y-3 mb-10">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>Wind-rated</strong> up to 160 MPH (Aluminum + Dura Fence)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>Lifetime warranty</strong> on materials, transferable to next homeowner</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>$0 down financing</strong> — 6 lenders, pre-qualify in 60 seconds</span>
            </li>
          </ul>

          <a
            href="/free-estimate"
            class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base px-10 py-4 rounded-none shadow-lg hover:shadow-xl transition-all"
          >
            Get Your Free Estimate
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Financing Calculator (Big Jerry's-style with gradient bg for section separation) -->
  <section class="section relative overflow-hidden bg-gradient-to-b from-gray-100 via-gray-50 to-gray-100 border-y border-gray-200">
    <!-- Subtle blueprint-style pattern -->
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: linear-gradient(0deg, transparent 24px, #136229 25px, transparent 26px), linear-gradient(90deg, transparent 24px, #136229 25px, transparent 26px); background-size: 25px 25px;"></div>
    <!-- Soft radial highlight in center -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at center top, rgba(255,255,255,0.6) 0%, transparent 60%);"></div>

    <div class="container-page relative">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Financing Available</span>
        <h2 class="mb-5 text-balance">Finance your project</h2>
        <p class="text-gray-600 text-lg lg:text-xl leading-relaxed mb-8">
          Need financing? <strong>Bad credit? No problem.</strong> Apply in 60 seconds and start receiving multiple competitive offers directly from lenders with <strong class="text-primary">ZERO impact to your credit.</strong>
        </p>

        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-10 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
          data-track="click_qualify_financing"
        >
          See If You Qualify For Financing
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Calculator -->
      <FinancingCalculator />

      <!-- Lender partners — infinite carousel marquee -->
      <div class="mt-12 lg:mt-16">
        <p class="text-center text-xs uppercase tracking-[0.2em] text-gray-500 font-bold mb-6">Our Lending Partners</p>

        <div class="relative overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
          <div class="flex gap-12 lg:gap-20 animate-scroll-x py-4 hover:[animation-play-state:paused]" style="width: max-content;">
            {/* First set */}
            {BUSINESS.financingPartners.map((p) => (
              <div class="flex items-center justify-center shrink-0 w-32 lg:w-40 h-12 lg:h-14">
                <img
                  src={p.logo}
                  alt={`${p.name} financing partner`}
                  class="max-h-full w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                  loading="lazy"
                />
              </div>
            ))}
            {/* Duplicate set for seamless loop */}
            {BUSINESS.financingPartners.map((p) => (
              <div class="flex items-center justify-center shrink-0 w-32 lg:w-40 h-12 lg:h-14" aria-hidden="true">
                <img
                  src={p.logo}
                  alt=""
                  class="max-h-full w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-highlight-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Our Process</span>
        <h2 class="mb-3 text-balance">Four easy steps to your perfect fence</h2>
        <p class="text-gray-600 text-lg">No phone games. No surprise charges. Same-day quotes Mon through Sun.</p>
      </div>

      <ProcessSteps />

      <!-- CTA below process -->
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Strip — brand promises (5 verified badges) -->
  <section class="py-12 lg:py-16 bg-white border-y border-gray-200">
    <div class="container-page">
      <p class="text-center text-xs uppercase tracking-[0.25em] text-gray-500 font-bold mb-10">Trusted &amp; Certified</p>

      <div class="trust-strip flex justify-center lg:grid lg:grid-cols-3 gap-3 lg:gap-12 items-stretch max-w-4xl mx-auto overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none scroll-smooth px-1 -mx-1 lg:mx-auto">

        {/* 1. Florida State Licensed */}
        <div class="trust-badge group">
          <div class="trust-badge-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 4L6 12V24C6 33 12 41 24 44C36 41 42 33 42 24V12L24 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/>
              <path d="M16 24L21 29L32 18" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="trust-badge-title">Florida<br/>Licensed</div>
          <div class="trust-badge-sub">DBPR · State of FL</div>
        </div>

        {/* 2. Fully Insured */}
        <div class="trust-badge group">
          <div class="trust-badge-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 4C24 4 8 10 8 18V26C8 36 16 42 24 44C32 42 40 36 40 26V18C40 10 24 4 24 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/>
              <path d="M24 16V28M18 22H30" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="trust-badge-title">Fully<br/>Insured</div>
          <div class="trust-badge-sub">Liability + Workers Comp</div>
        </div>

        {/* 3. Lifetime Materials Warranty */}
        <div class="trust-badge group">
          <div class="trust-badge-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="20" r="14" stroke="currentColor" stroke-width="2.5" fill="currentColor" fill-opacity="0.08"/>
              <path d="M14 32L10 44L18 40L24 44L30 40L38 44L34 32" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
              <path d="M24 14L26.5 19L32 19.5L28 23L29 28.5L24 26L19 28.5L20 23L16 19.5L21.5 19L24 14Z" fill="currentColor"/>
            </svg>
          </div>
          <div class="trust-badge-title">Lifetime<br/>Warranty</div>
          <div class="trust-badge-sub">On materials · Transferable</div>
        </div>

      </div>
    </div>
  </section>

  <!-- Choosing the Right Fence Company (Big Jerry's-style — bullets + video placeholder) -->
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <span class="badge-highlight mb-4">Why Choose Us</span>
        <h2 class="mb-3 text-balance">Choosing the right fence company</h2>
        <p class="text-gray-600 text-lg">Six reasons Marion County homeowners pick us — and stick with us.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">
        {/* Bullets left */}
        <div class="flex flex-col">
          <ul class="space-y-5 lg:space-y-6">
            {[
              '5+ Years in Marion County',
              'Licensed & Insured',
              'Lifetime Materials Warranty',
              'Premium Brands We Install',
              '$0 Down Financing',
              'Done in Less Than 7 Days',
            ].map((title) => (
              <li class="flex items-center gap-4">
                <div class="shrink-0 w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-primary flex items-center justify-center">
                  <svg class="w-5 h-5 lg:w-6 lg:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="text-lg lg:text-2xl font-extrabold text-gray-900">{title}</h3>
              </li>
            ))}
          </ul>
        </div>

        {/* Video card (poster only) — opens fullscreen modal on click */}
        <div class="relative flex flex-col">
          <button
            type="button"
            id="open-video-modal"
            class="relative flex-1 min-h-[400px] rounded-none overflow-hidden shadow-2xl bg-black group cursor-pointer w-full text-left"
            aria-label="Play explainer video"
          >
            {/* Poster image fills the card with cover */}
            <img
              src="/videos/ocala-fence-explainer-poster.jpg"
              alt="Ocala Fence Install team"
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />

            {/* Gradient overlay */}
            <div class="absolute inset-0 bg-gradient-to-br from-primary-900/55 via-primary-700/30 to-primary-900/65 group-hover:from-primary-900/35 group-hover:to-primary-900/50 transition-all"></div>

            {/* Subtle pattern */}
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>

            {/* Play button + label */}
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
              {/* Pulsing rings */}
              <div class="relative mb-5">
                <span class="absolute inset-0 rounded-full bg-white/30 video-ring-pulse"></span>
                <span class="absolute inset-0 rounded-full bg-white/20 video-ring-pulse" style="animation-delay: 0.5s;"></span>
                <div class="relative w-24 h-24 lg:w-28 lg:h-28 rounded-full bg-white flex items-center justify-center shadow-[0_20px_60px_-10px_rgba(0,0,0,0.6)] group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-11 h-11 lg:w-14 lg:h-14 text-primary ml-1.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              <p class="text-white text-base lg:text-lg font-extrabold uppercase tracking-[0.15em] drop-shadow-lg">
                Watch how we work
              </p>
              <p class="text-white/90 text-xs lg:text-sm mt-2 font-semibold drop-shadow tracking-wide">
                35 sec · Same crew · Done in &lt; 7 days
              </p>
            </div>
          </button>

          {/* Floating accent badge */}
