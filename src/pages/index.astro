                  type="button"
                  class={`w-3 h-3 rounded-full border border-gray-400 transition-all ${i === 0 ? 'bg-gray-900 border-gray-900' : 'bg-transparent hover:bg-gray-300'}`}
                  data-reviews-dot
                  data-index={i}
                  aria-label={`Go to review ${i + 1}`}
                ></button>
              ))}
