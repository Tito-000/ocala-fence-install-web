---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import TrustBar from '@components/TrustBar.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CityCard from '@components/CityCard.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import FinancingCalculator from '@components/FinancingCalculator.astro';
import ReviewCard from '@components/ReviewCard.astro';
import FAQ from '@components/FAQ.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { BLOG_POSTS } from '@data/blog-posts';

const recentBlogPosts = [...BLOG_POSTS]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);

const homeGalleryImages = [
  { src: '/images/gallery/vinyl-privacy-tan.webp', alt: 'Tan vinyl privacy fence install in Ocala FL', cat: 'Vinyl Privacy', city: 'Ocala' },
  { src: '/images/gallery/composite-cedar-tone.webp', alt: 'Cedar-tone composite fence with wood grain — Belleview FL', cat: 'Composite Fence', city: 'Belleview' },
  { src: '/images/gallery/pool-fence-aluminum.webp', alt: 'Black aluminum pool-code fence in Summerfield FL', cat: 'Pool Fence', city: 'Summerfield' },
  { src: '/images/gallery/aluminum-driveway-gate.webp', alt: 'Black aluminum double driveway gate — The Villages FL', cat: 'Aluminum', city: 'The Villages' },
  { src: '/images/gallery/vinyl-picket-white.webp', alt: 'White vinyl picket fence front yard — Silver Springs FL', cat: 'Vinyl Picket', city: 'Silver Springs' },
  { src: '/images/gallery/vinyl-privacy-shadowbox.webp', alt: 'Tan vinyl privacy shadowbox fence — Dunnellon FL', cat: 'Vinyl Privacy', city: 'Dunnellon' },
  { src: '/images/gallery/composite-modern-gray.webp', alt: 'Modern gray horizontal composite fence — Lady Lake FL', cat: 'Composite Fence', city: 'Lady Lake' },
  { src: '/images/gallery/aluminum-3-rail.webp', alt: 'Black aluminum 3-rail estate fence — Marion County FL', cat: 'Aluminum', city: 'Marion County' },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FenceContractor',
  '@id': 'https://ocalafenceinstall.com#business',
  name: BUSINESS.name,
  url: 'https://ocalafenceinstall.com',
  telephone: BUSINESS.phoneE164,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.latitude,
    longitude: BUSINESS.geo.longitude,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: BUSINESS.hours.phone.open,
    closes: BUSINESS.hours.phone.close,
  }],
  priceRange: '$$$',
  areaServed: BUSINESS.serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.name}, ${a.state}`,
  })),
  image: 'https://ocalafenceinstall.com/images/logo/master.webp',
};

const faqs = [
  { q: 'How long does fence installation take in Ocala?', a: 'Most installations are completed in <strong>less than 7 days</strong> from the signed contract. For urgent projects we can install in 2-3 days.' },
  { q: 'Do you offer financing?', a: 'Yes — <strong>$0 down financing</strong> with no credit impact pre-qualification. We partner with Aqua, Synchrony, Affirm, Klarna, Launch, and United Financial. Pre-qualify in 60 seconds.' },
  { q: 'How long does the materials warranty last?', a: 'Vinyl and composite carry a <strong>lifetime materials warranty</strong> from the manufacturer. Aluminum carries 25+ years. Workmanship is warranted by us for 1 year. Warranty transfers to the next homeowner if you sell.' },
  { q: 'What ZIP codes do you serve?', a: 'We serve all of Marion County (34470-34491), plus The Villages (32162), Lady Lake (32159), and up to 100 miles south of Ocala.' },
  { q: 'Do I need a permit for my fence?', a: 'In unincorporated Marion County, no permit is needed for fences under 6ft. In City of Ocala limits, most fences require a permit. <strong>We handle the permit process for you</strong> either way.' },
  { q: 'What\'s the warranty on materials?', a: 'Lifetime warranty on vinyl and aluminum from the manufacturer. 1-year warranty on workmanship from us. Warranty transfers to the next homeowner if you sell.' },
];
---

<PageLayout
  title="Fence Installation Ocala FL | $0 Down · Done in Less Than 7 Days"
  description="Marion County's family-owned fence installation team. Vinyl, composite, aluminum, and pool fences installed in less than 7 days. $0 down financing. Free same-day estimate. Call (863) 377-0928."
  activeNav="Home"
  schemaJsonLd={localBusinessSchema}
>
  <Hero
    tag="Marion County · Family-Owned · Licensed & Insured"
    title="Fence Installation in <span class='text-highlight'>Ocala, FL</span> — Done in Less Than 7 Days"
    subtitle="Premium vinyl, composite, aluminum, and pool fence installation across Ocala and Marion County. $0 down financing, same-day estimates, lifetime materials warranty. Most fences installed in less than 7 days."
    primaryCta={{ label: 'Get Your Quote', href: '/free-estimate' }}
    secondaryCta={{ label: `Call ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneE164}` }}
  />

  <TrustBar />

  <!-- Services -->
  <section class="section">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Our Services</span>
        <h2 class="mb-3 text-balance">Fences built for Florida homes</h2>
        <p class="text-gray-600 text-lg">Five fence types, all installed by our own crew. No subcontractors. Lifetime materials warranty.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6">
        {BUSINESS.services.map((s) => (
          <ServiceCard
            slug={s.slug}
            name={s.shortName}
            tagline={s.tagline}
            image={s.image}
            priceFromMonthly={s.priceFromMonthly}
            popular={s.popular}
          />
        ))}
      </div>

      {/* CTA below services grid (Big Jerry's-style) */}
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Protection Story (lifestyle / emotional pull) -->
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Image left -->
        <div class="relative order-2 lg:order-1">
          <div class="relative rounded-none overflow-hidden shadow-2xl aspect-[4/5] lg:aspect-[4/5] max-w-lg mx-auto">
            <img
              src="/images/lifestyle/kids-dog-protected-backyard.webp"
              alt="Two children and a golden retriever playing safely inside an Ocala backyard secured by a tall white vinyl privacy fence — Florida fence installation"
              class="w-full h-full object-cover"
              loading="lazy"
              width="800"
              height="1000"
            />
          </div>
          <!-- Floating stat badge -->
          <div class="hidden md:block absolute -bottom-6 -right-2 lg:right-6 bg-white rounded-none shadow-2xl p-4 border-l-4 border-highlight max-w-[240px]">
            <div class="text-3xl font-extrabold text-primary leading-none">&lt; 7 days</div>
            <div class="text-xs text-gray-600 mt-1 font-semibold uppercase tracking-wider">From contract to fence</div>
          </div>
        </div>

        <!-- Text right -->
        <div class="order-1 lg:order-2">
          <span class="badge-highlight mb-5">Protection</span>
          <h2 class="mb-5 text-balance">Built to protect <span class="text-primary">what matters most</span></h2>
          <p class="text-gray-700 text-lg leading-relaxed mb-5">
            Florida is wild. <strong>Bears, coyotes, gators</strong> — they don't stop at property lines. A real fence does.
          </p>
          <p class="text-gray-600 text-base leading-relaxed mb-8">
            We install premium <strong>vinyl, composite, aluminum, and pool fences</strong> with our own crew — no subcontractors, no shortcuts. Family-owned, locally operated, and built to outlast Florida's weather and wildlife.
          </p>

          <!-- Bullet trust list -->
          <ul class="space-y-3 mb-10">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>Wind-rated</strong> up to 160 MPH (composite + aluminum)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>Lifetime warranty</strong> on materials, transferable to next homeowner</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>$0 down financing</strong> — 6 lenders, pre-qualify in 60 seconds</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-700"><strong>Same crew start to finish</strong> — no subcontractors, ever</span>
            </li>
          </ul>

          <a
            href="/free-estimate"
            class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base px-10 py-4 rounded-none shadow-lg hover:shadow-xl transition-all"
          >
            Get Your Free Estimate
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Financing Calculator (Big Jerry's-style with gradient bg for section separation) -->
  <section class="section relative overflow-hidden bg-gradient-to-b from-gray-100 via-gray-50 to-gray-100 border-y border-gray-200">
    <!-- Subtle blueprint-style pattern -->
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: linear-gradient(0deg, transparent 24px, #136229 25px, transparent 26px), linear-gradient(90deg, transparent 24px, #136229 25px, transparent 26px); background-size: 25px 25px;"></div>
    <!-- Soft radial highlight in center -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at center top, rgba(255,255,255,0.6) 0%, transparent 60%);"></div>

    <div class="container-page relative">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Financing Available</span>
        <h2 class="mb-5 text-balance">Finance your project</h2>
        <p class="text-gray-600 text-lg lg:text-xl leading-relaxed mb-8">
          Need financing? <strong>Bad credit? No problem.</strong> Apply in 60 seconds and start receiving multiple competitive offers directly from lenders with <strong class="text-primary">ZERO impact to your credit.</strong>
        </p>

        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-10 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
          data-track="click_qualify_financing"
        >
          See If You Qualify For Financing
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Calculator -->
      <FinancingCalculator />

      <!-- Lender partners — infinite carousel marquee -->
      <div class="mt-12 lg:mt-16">
        <p class="text-center text-xs uppercase tracking-[0.2em] text-gray-500 font-bold mb-6">Our Lending Partners</p>

        <div class="relative overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
          <div class="flex gap-12 lg:gap-20 animate-scroll-x py-4 hover:[animation-play-state:paused]" style="width: max-content;">
            {/* First set */}
            {BUSINESS.financingPartners.map((p) => (
              <div class="flex items-center justify-center shrink-0 w-32 lg:w-40 h-12 lg:h-14">
                <img
                  src={p.logo}
                  alt={`${p.name} financing partner`}
                  class="max-h-full w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                  loading="lazy"
                />
              </div>
            ))}
            {/* Duplicate set for seamless loop */}
            {BUSINESS.financingPartners.map((p) => (
              <div class="flex items-center justify-center shrink-0 w-32 lg:w-40 h-12 lg:h-14" aria-hidden="true">
                <img
                  src={p.logo}
                  alt=""
                  class="max-h-full w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-highlight-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Our Process</span>
        <h2 class="mb-3 text-balance">Four easy steps to your perfect fence</h2>
        <p class="text-gray-600 text-lg">No phone games. No surprise charges. Same-day quotes Mon through Sun.</p>
      </div>

      <ProcessSteps />

      <!-- CTA below process -->
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Strip — placeholder for certifications/brand logos (Andry to provide real ones) -->
  <section class="py-12 lg:py-16 bg-white border-y border-gray-200">
    <div class="container-page">
      <p class="text-center text-xs uppercase tracking-[0.25em] text-gray-500 font-bold mb-8">Trusted &amp; Certified</p>

      {/* Placeholder logos — to be replaced with real certifications when Andry provides them */}
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-10 items-center max-w-5xl mx-auto">
        {[1, 2, 3, 4, 5].map(() => (
          <div class="flex items-center justify-center h-20 px-4 border-2 border-dashed border-gray-200 rounded-none bg-gray-50/50">
            <span class="text-xs uppercase tracking-wider text-gray-400 text-center">Logo<br/>placeholder</span>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-gray-400 mt-6 italic">
        Logos to be added: FL Contractor License · Insurance Provider · Composite Fence Certified · BBB · Marion County Chamber
      </p>
    </div>
  </section>

  <!-- Choosing the Right Fence Company (Big Jerry's-style — bullets + video placeholder) -->
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <span class="badge-highlight mb-4">Why Choose Us</span>
        <h2 class="mb-3 text-balance">Choosing the right fence company</h2>
        <p class="text-gray-600 text-lg">Six reasons Marion County homeowners pick us — and stick with us.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">
        {/* Bullets left */}
        <div class="flex flex-col">
          <ul class="space-y-5 lg:space-y-6">
            {[
              '5+ Years in Marion County',
              'Licensed & Insured',
              'Lifetime Materials Warranty',
              'Premium Brands We Install',
              '$0 Down Financing',
              'Done in Less Than 7 Days',
            ].map((title) => (
              <li class="flex items-center gap-4">
                <div class="shrink-0 w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-primary flex items-center justify-center">
                  <svg class="w-5 h-5 lg:w-6 lg:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="text-lg lg:text-2xl font-extrabold text-gray-900">{title}</h3>
              </li>
            ))}
          </ul>
        </div>

        {/* Video placeholder right — stretches to match left column height */}
        <div class="relative flex flex-col">
          <div class="relative flex-1 min-h-[400px] rounded-none overflow-hidden shadow-2xl bg-gradient-to-br from-primary-900 via-primary-700 to-primary-900 group cursor-pointer">
            {/* Subtle pattern */}
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>

            {/* Play button */}
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
              <div class="w-20 h-20 lg:w-24 lg:h-24 rounded-full bg-white/95 flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform mb-5">
                <svg class="w-10 h-10 lg:w-12 lg:h-12 text-primary ml-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <p class="text-white text-sm lg:text-base font-bold uppercase tracking-wider drop-shadow">
                Watch how we work
              </p>
              <p class="text-white/70 text-xs lg:text-sm mt-2 italic">
                (Video coming soon)
              </p>
            </div>
          </div>

          {/* Floating accent badge */}
          <div class="hidden md:block absolute -bottom-4 -right-4 bg-white rounded-none shadow-2xl px-5 py-3 border-l-4 border-highlight">
            <div class="text-2xl font-extrabold text-primary leading-none">5+ years</div>
            <div class="text-xs text-gray-600 mt-1 font-semibold uppercase tracking-wider">in Marion County</div>
          </div>
        </div>
      </div>

      {/* Centered CTA below the grid */}
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href="/free-estimate"
          class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base lg:text-lg px-12 py-5 rounded-none shadow-lg hover:shadow-xl transition-all"
        >
          Get Your Quote
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews — Carousel (Big Jerry's-style with dots) -->
  <section class="section">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Reviews</span>
        <h2 class="mb-3 text-balance">Real reviews from real customers</h2>
      </div>

      {(() => {
        const reviews = [
          {
            name: 'Margaret Dolan',
            initial: 'M',
            avatarBg: 'bg-blue-500',
            time: '3 months ago',
            rating: 5,
            body: "Ocala Fence Install made the whole process simple from start to finish. They came out the same week we called, gave us a written quote on the spot, and the crew finished the job in 5 days. Honest pricing, no surprises.",
          },
          {
            name: 'Danielle Lafountain',
            initial: 'D',
            avatarBg: 'bg-purple-500',
            time: '8 months ago',
            rating: 5,
            body: "We needed a new fence and working with Andry was easy. The quote process was quick and the prices were competitive. We picked our color and the final product is beautiful and high quality.",
          },
          {
            name: 'Maria G.',
            initial: 'M',
            avatarBg: 'bg-pink-500',
            time: '5 months ago',
            rating: 5,
            body: "Andry's team finished our vinyl fence in 4 days. Same crew start to finish. We're really happy with the result and the price was honest from the first visit.",
          },
          {
            name: 'James T.',
            initial: 'J',
            avatarBg: 'bg-emerald-500',
            time: '2 months ago',
            rating: 5,
            body: "We needed a pool fence to meet code before our inspection. Andry came out the same day, quoted, installed in a week, and walked us through the gate self-close test. Could not ask for more.",
          },
          {
            name: 'Carlos R.',
            initial: 'C',
            avatarBg: 'bg-amber-500',
            time: '1 month ago',
            rating: 5,
            body: "Andry walked me through every detail of the financing. $0 down and my monthly payment came out very manageable. Honest pricing from the first visit.",
          },
        ];
        return (
          <div data-reviews-carousel>
            <div class="overflow-hidden" data-reviews-track-wrapper>
              <div class="flex transition-transform duration-500 ease-out" data-reviews-track>
                {reviews.map((r) => (
                  <div class="w-full lg:w-1/2 shrink-0 px-3 lg:px-4">
                    <div class="text-center max-w-md mx-auto py-6">
                      {/* Avatar */}
                      <div class={`w-16 h-16 lg:w-20 lg:h-20 ${r.avatarBg} rounded-full flex items-center justify-center mx-auto mb-4 shadow-md`}>
                        <span class="text-white text-2xl lg:text-3xl font-extrabold">{r.initial}</span>
                      </div>
                      {/* Name */}
                      <h3 class="text-xl font-extrabold text-gray-900 mb-2">{r.name}</h3>
                      {/* Stars + time */}
                      <div class="flex items-center justify-center gap-2 mb-5">
                        <div class="flex gap-0.5 text-yellow-400">
                          {Array.from({ length: 5 }).map((_, i) => (
