    </div>

    <script is:inline>
      (() => {
        const carousel = document.querySelector('[data-reviews-carousel]');
        if (!carousel) return;
        const track = carousel.querySelector('[data-reviews-track]');
        const dots = carousel.querySelectorAll('[data-reviews-dot]');
        const total = dots.length;
        let current = 0;
        let autoplayId;

        const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
        const slideWidth = () => isDesktop() ? 50 : 100;
        const maxIndex = () => isDesktop() ? Math.max(0, total - 2) : total - 1;

        function go(i) {
          current = Math.min(Math.max(0, i), maxIndex());
          track.style.transform = `translateX(-${current * slideWidth()}%)`;
          dots.forEach((d, idx) => {
            const active = idx === current;
            d.classList.toggle('bg-gray-900', active);
            d.classList.toggle('border-gray-900', active);
            d.classList.toggle('bg-transparent', !active);
          });
        }

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            go(parseInt(dot.dataset.index));
            resetAutoplay();
          });
        });

        function startAutoplay() {
          autoplayId = setInterval(() => {
            const next = current >= maxIndex() ? 0 : current + 1;
            go(next);
          }, 6000);
        }
        function resetAutoplay() {
          clearInterval(autoplayId);
          startAutoplay();
        }

        window.addEventListener('resize', () => go(current));
        carousel.addEventListener('mouseenter', () => clearInterval(autoplayId));
        carousel.addEventListener('mouseleave', startAutoplay);

        go(0);
        startAutoplay();
      })();
    </script>
