---
import PageLayout from '@layouts/PageLayout.astro';
import CityCard from '@components/CityCard.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';

// Group additional cities by county for cleaner display
const citiesByCounty: Record<string, typeof BUSINESS.extendedCoverage.additionalCities[number][]> = {};
BUSINESS.extendedCoverage.additionalCities.forEach((c) => {
  if (!citiesByCounty[c.county]) citiesByCounty[c.county] = [];
  citiesByCounty[c.county].push(c);
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://ocalafenceinstall.com/areas' },
  ],
};

const totalAreas = BUSINESS.serviceAreas.length + BUSINESS.extendedCoverage.additionalCities.length;
---

<PageLayout
  title={`Service Areas | ${BUSINESS.name} | All Cities We Serve in Central Florida`}
  description={`We install fences across Marion County and within 50 miles of Ocala — Marion Oaks, Ocala, Belleview, Crystal River, Gainesville, Leesburg, The Villages and more. ${totalAreas}+ cities covered.`}
  activeNav="Areas"
  schemaJsonLd={[breadcrumbSchema]}
>
  {/* HERO */}
  <section class="relative bg-gradient-to-r from-primary-900 via-primary to-primary-700 py-16 lg:py-24">
    <div class="container-page text-center text-white">
      <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-highlight mb-4">
        Service Areas
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[0.95] tracking-tight mb-5 text-balance drop-shadow-2xl">
        Where We Install
      </h1>
      <p class="text-base lg:text-xl text-white/95 max-w-3xl mx-auto leading-relaxed font-semibold">
        We serve Marion County and within {BUSINESS.extendedCoverage.radiusMiles} miles of Marion Oaks — across {BUSINESS.extendedCoverage.counties.length} counties and {totalAreas}+ cities in central Florida.
      </p>
    </div>
  </section>

  {/* PRIMARY CITIES — with dedicated pages */}
  <section class="bg-white py-14 lg:py-20">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
        <span class="badge-highlight mb-4">Primary Cities</span>
        <h2 class="mb-3 text-balance">Cities with dedicated install service</h2>
        <p class="text-gray-600 text-lg">Click your city for local pricing, ZIP codes, and HOA info.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {BUSINESS.serviceAreas.map((a) => (
          <CityCard
            slug={a.slug}
            name={a.name}
            state={a.state}
            county={a.county}
            primaryZip={a.primaryZip}
            image={a.image}
            imageAlt={a.imageAlt}
          />
        ))}
      </div>
    </div>
  </section>

  {/* EXTENDED COVERAGE — additional cities by county */}
  <section class="bg-gray-50 py-14 lg:py-20 border-t border-gray-200">
    <div class="container-page">
      <div class="grid lg:grid-cols-[1fr_1fr] gap-10 lg:gap-16 items-start max-w-7xl mx-auto">

        {/* LEFT — Coverage map (sticky on desktop) */}
        <div class="lg:sticky lg:top-24">
          <div class="bg-white border-2 border-primary/15 shadow-md overflow-hidden">
            <div class="relative aspect-[4/3] bg-gradient-to-br from-gray-100 via-white to-gray-50 overflow-hidden">
              <svg viewBox="0 0 400 300" class="w-full h-full" preserveAspectRatio="xMidYMid meet" aria-label="Coverage map showing Marion Oaks Florida and surrounding service areas">
                <defs>
                  <pattern id="ext-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e5e7eb" stroke-width="0.5"/>
                  </pattern>
                  <radialGradient id="ext-circleGrad" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#136229" stop-opacity="0.35"/>
                    <stop offset="70%" stop-color="#136229" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="#136229" stop-opacity="0.05"/>
                  </radialGradient>
                </defs>
                <rect width="400" height="300" fill="url(#ext-grid)"/>

                {/* Florida abstract outline */}
                <path
                  d="M 60 40 Q 100 30 140 50 Q 180 60 220 50 Q 280 45 340 70 Q 360 90 350 130 Q 360 170 340 210 Q 310 250 270 260 Q 220 270 180 255 Q 130 250 90 230 Q 50 200 50 150 Q 45 90 60 40 Z"
                  fill="#f3f4f6"
                  stroke="#d1d5db"
                  stroke-width="1.5"
                />

                {/* 50-mile coverage circle */}
                <circle cx="200" cy="160" r="105" fill="url(#ext-circleGrad)" stroke="#136229" stroke-width="2.5" />

                {/* Animated pulse */}
                <circle cx="200" cy="160" r="105" fill="none" stroke="#136229" stroke-width="2" opacity="0.4">
                  <animate attributeName="r" from="105" to="125" dur="2.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" from="0.4" to="0" dur="2.5s" repeatCount="indefinite"/>
                </circle>

                {/* Extended cities pins (cream) */}
                <g fill="#D1B487" stroke="#62522E" stroke-width="0.8">
                  <circle cx="160" cy="100" r="3.5"/>
                  <circle cx="120" cy="170" r="3.5"/>
                  <circle cx="135" cy="200" r="3.5"/>
                  <circle cx="150" cy="220" r="3.5"/>
                  <circle cx="270" cy="140" r="3.5"/>
                  <circle cx="280" cy="170" r="3.5"/>
                  <circle cx="265" cy="200" r="3.5"/>
                  <circle cx="250" cy="225" r="3.5"/>
                  <circle cx="235" cy="200" r="3.5"/>
                  <circle cx="230" cy="240" r="3.5"/>
                  <circle cx="195" cy="115" r="3.5"/>
                  <circle cx="220" cy="105" r="3.5"/>
                  <circle cx="180" cy="105" r="3.5"/>
                  <circle cx="240" cy="135" r="3.5"/>
                  <circle cx="250" cy="150" r="3.5"/>
                  <circle cx="270" cy="180" r="3.5"/>
                  <circle cx="170" cy="135" r="3.5"/>
                  <circle cx="185" cy="125" r="3.5"/>
                </g>

                {/* Primary cities pins (green) */}
                <g fill="#136229" stroke="white" stroke-width="1.5">
                  <circle cx="180" cy="155" r="4.5"/>
                  <circle cx="200" cy="190" r="4.5"/>
                  <circle cx="215" cy="200" r="4.5"/>
                  <circle cx="215" cy="160" r="4.5"/>
                  <circle cx="155" cy="180" r="4.5"/>
                  <circle cx="245" cy="215" r="4.5"/>
                  <circle cx="235" cy="220" r="4.5"/>
                </g>

                {/* Marion Oaks star */}
                <g transform="translate(200, 175)">
                  <circle r="11" fill="white" stroke="#136229" stroke-width="2.5"/>
                  <path d="M 0 -7 L 1.6 -2.2 L 6.7 -2.2 L 2.5 0.9 L 4.1 5.7 L 0 2.7 L -4.1 5.7 L -2.5 0.9 L -6.7 -2.2 L -1.6 -2.2 Z"
                        fill="#136229"/>
                </g>

                {/* Marion Oaks label */}
                <g>
                  <rect x="155" y="195" width="90" height="22" fill="#136229" rx="2"/>
                  <text x="200" y="210" font-family="system-ui, sans-serif" font-size="11" font-weight="800" fill="white" text-anchor="middle" letter-spacing="0.5">MARION OAKS</text>
                </g>
              </svg>

              {/* Floating "+18 more" badge */}
              <div class="absolute top-3 right-3 bg-highlight text-primary-900 text-[10px] lg:text-xs uppercase tracking-wider font-extrabold px-3 py-1.5 shadow-md">
                + {BUSINESS.extendedCoverage.additionalCities.length} more cities
              </div>
            </div>

            {/* Legend */}
            <div class="border-t border-gray-200 px-5 py-4 bg-white">
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-3 h-3 rounded-full bg-primary border-2 border-white shadow-sm"></span>
                  <span class="text-gray-700 font-semibold">Primary cities</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-highlight border border-accent"></span>
                  <span class="text-gray-700 font-semibold">Extended coverage</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block w-3 h-3 rounded-full border-2 border-primary bg-primary/20"></span>
                  <span class="text-gray-700 font-semibold">{BUSINESS.extendedCoverage.radiusMiles}-mile radius</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* RIGHT — Persuasive copy + counties + cities list */}
        <div>
          <span class="badge-highlight mb-4">Extended Coverage</span>
          <h2 class="text-3xl lg:text-4xl xl:text-5xl font-extrabold text-primary-900 leading-[1.05] mb-5">
            Beyond Marion Oaks — we go where you need us
          </h2>
          <p class="text-base lg:text-lg text-gray-700 leading-relaxed mb-3">
            Marion Oaks is our home base, but we travel up to <strong class="text-primary">{BUSINESS.extendedCoverage.radiusMiles} miles</strong> in any direction. <strong class="text-primary-900">Same pricing, same crew, same install times</strong> — we just don't have a dedicated page for every town yet.
          </p>
          <p class="text-base text-gray-600 leading-relaxed mb-8">
            We regularly install fences across <strong>{BUSINESS.extendedCoverage.counties.length} counties</strong> in central Florida, including these {BUSINESS.extendedCoverage.additionalCities.length} additional cities and communities:
          </p>

          {/* Counties as pills */}
          <div class="flex flex-wrap gap-2 mb-8">
            {BUSINESS.extendedCoverage.counties.map((c) => (
              <span class={`inline-block text-xs font-extrabold uppercase tracking-wider px-3 py-1.5 ${c.primary ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800'}`}>
                {c.name}
              </span>
            ))}
          </div>

          {/* Cities grouped by county — visual cards */}
          <div class="space-y-3">
            {Object.entries(citiesByCounty).map(([county, cities]) => (
              <div class="group/county bg-white border border-gray-200 hover:border-primary hover:shadow-md transition-all duration-300 overflow-hidden">
                {/* County header bar */}
                <div class="flex items-center justify-between px-5 py-3 bg-gradient-to-r from-primary/5 to-transparent border-b border-gray-100">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-primary/10 group-hover/county:bg-primary text-primary group-hover/county:text-white flex items-center justify-center transition-colors">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                    </div>
                    <h3 class="text-sm lg:text-base font-extrabold text-primary uppercase tracking-wider">{county}</h3>
                  </div>
                  <span class="text-[10px] lg:text-xs font-extrabold text-white bg-primary px-2.5 py-1 uppercase tracking-wider">
                    {cities.length} {cities.length === 1 ? 'city' : 'cities'}
                  </span>
                </div>

                {/* Cities chips */}
                <div class="px-5 py-4 flex flex-wrap gap-2">
                  {cities.map((c) => (
                    <span class="inline-flex items-baseline gap-1.5 bg-gray-50 hover:bg-highlight/30 border border-gray-200 hover:border-highlight px-3 py-1.5 transition-colors">
                      <span class="text-sm font-bold text-gray-800">{c.name}</span>
                      <span class="text-[10px] font-mono text-gray-500">{c.zip}</span>
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          {/* Highlight box */}
          <div class="mt-6 bg-highlight/20 border-l-4 border-highlight p-5">
            <p class="text-sm lg:text-base text-gray-800 leading-relaxed">
              <strong class="text-primary-900">Don't see your area?</strong> We expand based on demand. If you're a Florida homeowner near central Florida, give us a call — we'll come measure your yard.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <FinalCTA
    title="Ready for your fence install?"
    subtitle="Same-day quote · $0 down financing · Less than 7 days install"
  />
</PageLayout>
