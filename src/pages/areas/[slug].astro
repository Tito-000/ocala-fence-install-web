---
import PageLayout from '@layouts/PageLayout.astro';
import FAQ from '@components/FAQ.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { CITIES_CONTENT } from '@data/cities-content';

export function getStaticPaths() {
  return BUSINESS.serviceAreas.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const content = CITIES_CONTENT[city.slug];
const otherCities = BUSINESS.serviceAreas.filter((c) => c.slug !== city.slug);

// Per-service bullets for the "Select The Perfect Fence" section (BJF style)
const SERVICE_BULLETS: Record<string, string[]> = {
  'vinyl-privacy-fence': ['Total privacy & 6ft height', 'Hurricane-rated 130 MPH', 'Lifetime materials warranty'],
  'vinyl-picket-fence': ['Decorative front-yard look', 'Maintenance-free vinyl', '25+ year lifespan'],
  'composite-fence': ['160 MPH wind-rated', 'Looks like real stone', 'Lifetime warranty'],
  'aluminum-fence': ['Florida §515 pool-code ready', 'Maintenance-free metal', 'Modern, sleek look'],
  'horse-fence': ['3-rail vinyl ranch fencing', 'Horse-safe (flexes on impact)', 'For 1-50+ acre Marion County farms'],
};

// Schemas
const localSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${BUSINESS.name} — ${city.name}`,
  url: `https://ocalafenceinstall.com/areas/${city.slug}`,
  telephone: BUSINESS.phoneE164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  areaServed: {
    '@type': 'City',
    name: `${city.name}, ${city.state}`,
    containedInPlace: { '@type': 'AdministrativeArea', name: city.county },
  },
  priceRange: '$$$',
  description: content.metaDescription,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://ocalafenceinstall.com/areas' },
    { '@type': 'ListItem', position: 3, name: `${city.name}, ${city.state}`, item: `https://ocalafenceinstall.com/areas/${city.slug}` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]*>/g, '') },
  })),
};

// Stats bar (BJF style)
const STATS = [
  { number: '500+', label: 'Fences Installed' },
  { number: '5+', label: 'Years in Marion' },
  { number: '< 7', label: 'Days to Install' },
  { number: '$0', label: 'Down Financing' },
];

// Latest news posts (BJF "Latest News" style — 3 blog cards)
const LATEST_NEWS = [
  {
    slug: 'fence-installation-timeline-ocala',
    title: 'How Long Does Fence Installation Take in Ocala, FL?',
    image: '/images/services/vinyl-privacy.webp',
  },
  {
    slug: 'pool-fence-code-florida-515',
    title: 'Florida §515 Pool Fence Code: What Marion County Homeowners Need to Know',
    image: '/images/services/aluminum.webp',
  },
  {
    slug: 'vinyl-vs-composite-florida-heat',
    title: 'Vinyl vs Composite Fence: Which Holds Up Best in Florida Heat?',
    image: '/images/services/composite-fence.webp',
  },
];
---

<PageLayout
  title={content.metaTitle}
  description={content.metaDescription}
  activeNav="Areas"
  schemaJsonLd={[localSchema, breadcrumbSchema, faqSchema]}
>
  {/* Breadcrumb */}
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <a href="/areas" class="hover:text-primary">Service Areas</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">{city.name}, {city.state}</span>
      </nav>
    </div>
  </div>

  {/* HERO — BJF style: aerial bg + big white title + 4 bullets */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={city.image}
        alt={city.imageAlt || `${city.name}, ${city.state} aerial view`}
        class="w-full h-full object-cover"
        loading="eager"
        width="1920"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
    </div>

    <div class="container-page relative py-20 lg:py-32">
      <div class="max-w-3xl text-white">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-extrabold leading-[0.95] tracking-tight mb-8 text-balance drop-shadow-2xl">
          Fence Installation in <span class="text-highlight">{city.name}</span>
        </h1>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 mb-10 max-w-2xl">
          <li class="flex items-center gap-3 text-lg lg:text-xl font-semibold">
            <svg class="w-6 h-6 text-highlight shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Fast & Accurate Quotes
          </li>
          <li class="flex items-center gap-3 text-lg lg:text-xl font-semibold">
            <svg class="w-6 h-6 text-highlight shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Efficient Fence Installation
          </li>
          <li class="flex items-center gap-3 text-lg lg:text-xl font-semibold">
            <svg class="w-6 h-6 text-highlight shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Hassle-Free Experience
          </li>
          <li class="flex items-center gap-3 text-lg lg:text-xl font-semibold">
            <svg class="w-6 h-6 text-highlight shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Residential & Commercial
          </li>
        </ul>

        <div class="flex flex-wrap gap-3">
          <a href="/free-estimate" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-10 py-5 shadow-lg transition-colors">
            Get Your Free Estimate
          </a>
          <a href={`tel:${BUSINESS.phoneE164}`} class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white border-2 border-white/60 font-extrabold uppercase tracking-wider text-sm px-10 py-5 transition-colors" data-track="phone_click">
            Call {BUSINESS.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* STATS BAR — BJF dark green with cream big numbers */}
  <section class="relative bg-primary-900 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src={city.image} alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container-page relative py-14 lg:py-20">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {STATS.map((s) => (
          <div>
            <div class="text-5xl lg:text-7xl font-extrabold text-highlight leading-none mb-3">{s.number}</div>
            <div class="text-xs lg:text-sm uppercase tracking-[0.2em] text-white font-bold">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SELECT THE PERFECT FENCE — BJF style: image with LEARN MORE bar + title + bullets below */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <h2 class="text-center text-4xl lg:text-5xl font-extrabold text-primary-900 mb-12 lg:mb-16 text-balance">
        Select The Perfect Fence For Your Property
      </h2>

      <div class="flex flex-wrap justify-center gap-x-8 gap-y-12">
        {BUSINESS.services.map((s) => (
          <div class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.334rem)]">
            <a href={`/services/${s.slug}`} class="group block">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={s.image}
                  alt={s.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute bottom-0 left-0 right-0 bg-primary group-hover:bg-primary-700 text-white text-center py-4 font-extrabold uppercase tracking-[0.2em] text-sm transition-colors">
                  Learn More
                </div>
              </div>
            </a>

            <h3 class="text-2xl lg:text-3xl font-extrabold mt-7 mb-4 text-primary-900">{s.name}</h3>

            <ul class="space-y-3">
              {(SERVICE_BULLETS[s.slug] || []).map((bullet) => (
                <li class="flex items-start gap-3 text-base text-gray-700">
                  <span class="w-3 h-3 bg-primary rounded-full shrink-0 mt-1.5"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* WHY CHOOSE US — BJF style: left CTA card + right vertical icon list */}
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        {/* LEFT — title + CTA */}
        <div>
          <h2 class="text-5xl lg:text-6xl font-extrabold text-primary-900 mb-8 leading-[0.95]">
            Why Choose Us?
          </h2>
          <p class="text-lg text-gray-700 mb-8 leading-relaxed">
            {city.name} homeowners trust us because we treat every fence install like it's at our own home. Local crew, local permits, local accountability.
          </p>
          <a href="/free-estimate" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-10 py-5 shadow-md transition-colors">
            Get Your Free Estimate
          </a>
        </div>

        {/* RIGHT — Why local cards (vertical) */}
        <div class="bg-highlight-50 p-8 lg:p-10 space-y-8">
          {content.whyLocal.map((card) => (
            <div class="flex gap-5">
              <div class="w-14 h-14 rounded-full border-2 border-primary flex items-center justify-center text-primary shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <div>
                <h3 class="text-2xl font-extrabold mb-2 text-primary-900">{card.title}</h3>
                <p class="text-gray-700 leading-relaxed">{card.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* INTRO — kept as a content section */}
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-page max-w-4xl">
      <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-8 text-balance">{content.intro.heading}</h2>
      {content.intro.paragraphs.map((p) => (
        <p class="text-gray-700 text-lg leading-relaxed mb-5">{p}</p>
      ))}
    </div>
  </section>

  {/* NEIGHBORHOODS & ZIPS — visual map-style with neighborhood cards + ZIP grid */}
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-4 text-balance">
          We cover all of {city.name}
        </h2>
        <p class="text-lg text-gray-600">
          Every neighborhood. Every ZIP code. Same crew, same 7-day install promise.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 max-w-6xl mx-auto">
        {/* LEFT — coverage stat card (dark) */}
        <div class="lg:col-span-4 bg-primary-900 text-white p-8 lg:p-10 relative overflow-hidden">
          <div class="absolute inset-0 opacity-10">
            <img src={city.image} alt="" class="w-full h-full object-cover" />
          </div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <svg class="w-8 h-8 text-highlight" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
              <span class="text-xs uppercase tracking-[0.2em] font-bold text-highlight">Coverage Area</span>
            </div>

            <div class="space-y-6 mb-8">
              <div>
                <div class="text-5xl lg:text-6xl font-extrabold text-highlight leading-none">{content.zips.length}</div>
                <div class="text-sm uppercase tracking-wider mt-2 text-white/90 font-bold">ZIP Codes Covered</div>
              </div>
              <div>
                <div class="text-5xl lg:text-6xl font-extrabold text-highlight leading-none">{content.neighborhoods.length}+</div>
                <div class="text-sm uppercase tracking-wider mt-2 text-white/90 font-bold">Neighborhoods Served</div>
              </div>
            </div>

            <div class="border-t border-white/20 pt-6">
              <div class="text-xs uppercase tracking-[0.2em] text-highlight font-bold mb-3">All ZIPs</div>
              <div class="flex flex-wrap gap-1.5">
                {content.zips.map((zip) => (
                  <span class="inline-flex items-center px-2.5 py-1 bg-white/10 border border-white/20 text-white text-xs font-mono font-semibold">
                    {zip}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        {/* RIGHT — neighborhoods as map-pin cards */}
        <div class="lg:col-span-8">
          <h3 class="text-xs uppercase tracking-[0.2em] text-gray-500 font-bold mb-5">Neighborhoods we serve in {city.name}</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 lg:gap-4">
            {content.neighborhoods.map((n) => (
              <div class="group bg-white border border-gray-200 hover:border-primary hover:shadow-md transition-all px-4 py-4 flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-primary-50 group-hover:bg-primary flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4 text-primary group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                </div>
                <div class="text-sm lg:text-base font-bold text-gray-900 leading-tight">{n}</div>
              </div>
            ))}
          </div>

          <p class="text-sm text-gray-500 mt-5 italic">
            Don't see your neighborhood? <a href={`tel:${BUSINESS.phoneE164}`} class="text-primary font-semibold hover:underline">Call us</a> — chances are we still cover you.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* LATEST NEWS — BJF style: 3 blog cards with photo + title + Read More */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-10 lg:mb-14">Latest News</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {LATEST_NEWS.map((post) => (
          <article>
            <a href={`/blog/${post.slug}`} class="block group">
              <div class="aspect-[4/3] overflow-hidden mb-6">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <h3 class="text-2xl font-extrabold text-primary-900 leading-tight mb-5 group-hover:text-primary transition-colors">
                {post.title}
              </h3>
            </a>
            <a href={`/blog/${post.slug}`} class="inline-flex items-center bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-6 py-3 transition-colors">
              Read More
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* NEWSLETTER STRIP — BJF green bar with name + email + signup */}
  <section class="bg-primary py-12 lg:py-14">
    <div class="container-page">
      <div class="text-center mb-7">
        <h2 class="text-2xl lg:text-3xl font-extrabold text-white">
          Monthly Tips, News &amp; Florida Fence Insider Info
        </h2>
      </div>

      <form
        class="grid md:grid-cols-[1fr_2fr_auto] gap-3 max-w-4xl mx-auto"
        action={BUSINESS.ghlWebhookUrl || '#'}
        method="POST"
      >
        <input
          type="text"
          name="name"
          placeholder="Name"
          required
          class="px-5 py-4 bg-white text-gray-900 placeholder-gray-500 font-medium border-0 focus:outline-none focus:ring-2 focus:ring-highlight"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          required
          class="px-5 py-4 bg-white text-gray-900 placeholder-gray-500 font-medium border-0 focus:outline-none focus:ring-2 focus:ring-highlight"
        />
        <button
          type="submit"
          class="px-10 py-4 bg-white hover:bg-gray-50 text-primary font-extrabold uppercase tracking-wider text-sm transition-colors border-2 border-white"
        >
          Sign Up
        </button>
      </form>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-gray-50 py-16 lg:py-20">
    <div class="container-page max-w-3xl">
      <h2 class="text-center text-4xl lg:text-5xl font-extrabold text-primary-900 mb-10 text-balance">
        {city.name} fence questions
      </h2>
      <FAQ items={content.faqs} />
    </div>
  </section>

  {/* OTHER LOCATIONS — BJF "Franchises" style: image cards with city name overlay */}
  <section class="bg-highlight-50 py-16 lg:py-24">
    <div class="container-page">
      <h2 class="text-center text-4xl lg:text-5xl font-extrabold text-primary-900 mb-12 text-balance">
        We also serve nearby cities
      </h2>

      <div class="flex flex-wrap justify-center gap-4 lg:gap-6 max-w-6xl mx-auto">
        {otherCities.map((c) => (
          <a href={`/areas/${c.slug}`} class="group block relative overflow-hidden shadow-md hover:shadow-xl transition-shadow w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.667rem)] lg:w-[calc(25%-1.125rem)]">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={c.image}
                alt={c.imageAlt || `${c.name}, ${c.state}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="bg-primary group-hover:bg-primary-700 text-white text-center py-4 font-extrabold uppercase tracking-wider text-sm transition-colors">
              {c.name}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    title={`Ready for your ${city.name} fence estimate?`}
    subtitle="Same-day quote · $0 down financing · Less than 7 days install"
  />
</PageLayout>
