---
import PageLayout from '@layouts/PageLayout.astro';
import PhotoPlaceholder from '@components/PhotoPlaceholder.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';

const steps = [
  {
    n: 1,
    title: 'Request a Quote',
    body: 'Click the green "Free Estimate" button or call Andri direct at (863) 377-0928. Tell us your ZIP code and what kind of fence you have in mind. Takes about 60 seconds. We answer Mon through Sun, 9am to 9pm.',
    cta: { label: 'Get Your Quick Quote', href: '/free-estimate' },
    photo: { description: 'Andri shaking hands with a homeowner at the front door of a Marion County home, daytime.', aspect: 'square' as const },
    flip: false,
  },
  {
    n: 2,
    title: 'Free On-Site Visit',
    body: 'We come measure your property in person — same day or next day. We walk the line, listen to what matters most (privacy, pets, pool code, HOA), and take notes. No high-pressure pitch, no charge.',
    photo: { description: 'Andri or crew member measuring a backyard with a tape measure, holding a clipboard. Daylight, wide angle.', aspect: 'wide' as const },
    flip: true,
  },
  {
    n: 3,
    title: 'Get a Written Estimate — On the Spot',
    body: 'Before we leave your property you have a printed price in your hand. Linear footage, materials, labor, permit, gates, removal of old fence — all on one page. No phone games. No surprise add-ons later.',
    photo: { description: 'Close-up: hands holding a printed estimate sheet on a clipboard, fence project diagram visible.', aspect: '4-3' as const },
    flip: false,
  },
  {
    n: 4,
    title: 'Pre-Qualify for $0 Down Financing (Optional)',
    body: 'Want to break the project into monthly payments? Pre-qualify in 60 seconds with no impact on your credit. We work with six lenders — Aqua, Synchrony, Affirm, Klarna, Launch, and United Financial — so more applications get approved.',
    cta: { label: 'See If You Qualify', href: '/financing' },
    photo: { description: 'Phone screen showing financing pre-qualification form, with Ocala Fence branding visible.', aspect: 'square' as const },
    flip: true,
  },
  {
    n: 5,
    title: 'We Pull the Permit',
    body: 'Marion County permit needed? We file it. City of Ocala paperwork? We handle it. HOA approval? We submit the spec sheet. Your only job is to choose the color.',
    photo: { description: 'Close-up of a Marion County / FL permit document with a pen, branded folder visible.', aspect: '4-3' as const },
    flip: false,
  },
  {
    n: 6,
    title: 'Install in Less Than 7 Days',
    body: 'Most fences are completely finished within a week of signing. Need it sooner — pool inspection deadline, new puppy, HOA letter? We can move in 2 to 3 days for urgent jobs. Our crew, not subcontractors. Same faces start to finish.',
    photo: { description: 'Crew installing vinyl posts in a yard, action shot, daylight, branded truck visible in background.', aspect: '16-9' as const },
    flip: true,
  },
  {
    n: 7,
    title: 'Final Walk-Through & Warranty',
    body: 'When we finish, you walk every foot of the fence with us. Anything looks off, we fix it before we leave. You sign off only when 100% happy. Lifetime materials warranty stays with the home — even if you sell. 1-year workmanship warranty backed by us.',
    cta: { label: 'Start Your Project', href: '/free-estimate' },
    photo: { description: 'Family standing in front of a finished white vinyl fence at their Ocala home, smiling, golden-hour light. Wide horizontal.', aspect: 'wide' as const },
    flip: false,
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Our Process', item: 'https://ocalafenceinstall.com/our-process' },
  ],
};
---

<PageLayout
  title="Our Process — From Quote to Installed Fence in Less Than 7 Days | Ocala Fence Install"
  description="Step-by-step: request a quote, get a free on-site visit, written estimate, $0 down financing, permit pulled by us, install in under 7 days, lifetime warranty. Marion County, FL."
  activeNav="About"
  schemaJsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="relative bg-gradient-to-br from-primary-900 via-primary-800 to-primary text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <!-- Subtle texture overlay -->
    <div class="absolute inset-0 opacity-30 mix-blend-overlay" style="background: linear-gradient(135deg, transparent 0%, rgba(0,0,0,0.4) 100%);"></div>

    <div class="container-page relative py-20 lg:py-28 text-center">
      <span class="inline-block badge bg-highlight/20 text-highlight border border-highlight/30 mb-6 backdrop-blur-sm">
        How we work
      </span>
      <h1 class="text-balance mb-5 text-white tracking-tight">
        The Ocala Fence Install <span class="block text-highlight">Process</span>
      </h1>
      <p class="text-xl lg:text-2xl text-white/85 max-w-3xl mx-auto text-balance leading-relaxed">
        From the first phone call to the final walk-through — here's exactly how we get a premium fence installed in your yard in less than 7 days.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/free-estimate" class="btn bg-highlight hover:bg-highlight-200 text-gray-900 font-bold text-base px-8 py-4">
          Start My Free Estimate
        </a>
        <a href={`tel:${BUSINESS.phoneE164}`} class="btn bg-white/10 hover:bg-white/20 text-white border-2 border-white/30 backdrop-blur-sm text-base px-8 py-4" data-track="click_phone">
          Call {BUSINESS.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- INTRO STRIP -->
  <section class="bg-highlight-50 border-b border-highlight-200">
    <div class="container-page py-10 lg:py-12">
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8 text-center">
        <div>
          <div class="text-4xl lg:text-5xl font-extrabold text-primary mb-1">7</div>
          <div class="text-sm uppercase tracking-wider text-accent font-bold">Steps, end to end</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-extrabold text-primary mb-1">&lt; 7</div>
          <div class="text-sm uppercase tracking-wider text-accent font-bold">Days from sign to install</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-extrabold text-primary mb-1">$0</div>
          <div class="text-sm uppercase tracking-wider text-accent font-bold">Down financing available</div>
        </div>
      </div>
    </div>
  </section>

  <!-- STEPS -->
  {steps.map((step, idx) => (
    <section class={`py-16 lg:py-24 ${idx % 2 === 1 ? 'bg-gray-50' : 'bg-white'}`}>
      <div class="container-page">
        <div class={`grid lg:grid-cols-2 gap-10 lg:gap-16 items-center ${step.flip ? 'lg:[&>*:first-child]:order-2' : ''}`}>
          <!-- Text -->
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 lg:w-16 lg:h-16 bg-primary text-white rounded-full flex items-center justify-center font-extrabold text-2xl lg:text-3xl shadow-lg shrink-0">
                {step.n}
              </div>
              <div class="h-px flex-1 bg-gradient-to-r from-primary/40 to-transparent"></div>
            </div>
            <h2 class="text-3xl lg:text-4xl font-extrabold tracking-tight mb-5 uppercase">
              {step.title}
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              {step.body}
            </p>
            {step.cta && (
              <a href={step.cta.href} class="btn-primary inline-flex">
                {step.cta.label}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            )}
          </div>

          <!-- Image -->
          <div>
            <PhotoPlaceholder
              description={step.photo.description}
              aspect={step.photo.aspect}
            />
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- TRUST RECAP -->
  <section class="bg-accent text-white">
    <div class="container-page py-14 lg:py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-extrabold mb-5 text-balance">
          That's it. No surprises. No phone games.
        </h2>
        <p class="text-lg lg:text-xl text-white/90 mb-8 text-balance">
          One call to Andri. One on-site visit. One written price. Then we build.
          Same family-owned team start to finish — no subcontractors, no surprises.
        </p>
        <div class="grid sm:grid-cols-3 gap-4 max-w-2xl mx-auto text-left">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-highlight shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm">Licensed & insured FL contractor</span>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-highlight shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm">5+ years serving Marion County</span>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-highlight shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm">Lifetime materials warranty</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    title="Ready to start step 1?"
    subtitle="Get your free on-site estimate today — written price on the spot."
  />
</PageLayout>
