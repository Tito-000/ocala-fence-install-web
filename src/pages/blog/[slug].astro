---
import PageLayout from '@layouts/PageLayout.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { BLOG_POSTS } from '@data/blog-posts';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const sortedPosts = [...BLOG_POSTS].sort((a, b) => (a.date < b.date ? 1 : -1));
const otherPosts = sortedPosts.filter((p) => p.slug !== post.slug).slice(0, 5);
const relatedPosts = sortedPosts.filter((p) => p.slug !== post.slug && p.category === post.category).slice(0, 3);
const fallbackRelated = sortedPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
const finalRelated = relatedPosts.length >= 3 ? relatedPosts : fallbackRelated;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://ocalafenceinstall.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: `https://ocalafenceinstall.com/blog/${post.slug}` },
  ],
};

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.metaDescription,
  image: `https://ocalafenceinstall.com${post.image}`,
  datePublished: post.date,
  author: {
    '@type': 'Person',
    name: post.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: BUSINESS.name,
    logo: {
      '@type': 'ImageObject',
      url: 'https://ocalafenceinstall.com/images/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://ocalafenceinstall.com/blog/${post.slug}`,
  },
};
---

<PageLayout
  title={`${post.title} | ${BUSINESS.name} Blog`}
  description={post.metaDescription}
  activeNav="Blog"
  schemaJsonLd={[breadcrumbSchema, blogPostingSchema]}
>
  {/* HERO — full bleed cover image with gradient + title */}
  <section class="relative">
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={post.image}
        alt={post.imageAlt}
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/60 to-black/30"></div>
    </div>

    <div class="container-page relative pt-24 lg:pt-36 pb-16 lg:pb-20">
      <div class="max-w-4xl">
        <a href="/blog" class="inline-flex items-center gap-2 text-highlight hover:text-white text-xs uppercase tracking-[0.3em] font-bold mb-6 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Back to Blog
        </a>
        <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-highlight mb-4">{post.category}</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-[1.05] tracking-tight text-white text-balance drop-shadow-2xl mb-6">
          {post.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-white/90 text-sm">
          <span class="font-bold">{post.author.name}</span>
          <span class="text-white/40">·</span>
          <span>{post.dateDisplay}</span>
          <span class="text-white/40">·</span>
          <span>{post.readTime}</span>
        </div>
      </div>
    </div>
  </section>

  {/* CONTENT + SIDEBAR */}
  <section class="bg-white py-12 lg:py-16">
    <div class="container-page">
      <div class="grid lg:grid-cols-[2fr_1fr] gap-10 lg:gap-14 max-w-7xl mx-auto">

        {/* MAIN CONTENT */}
        <article class="prose-fence">
          <p class="text-xl lg:text-2xl text-primary-900 font-semibold leading-relaxed mb-10 pb-8 border-b border-gray-200">
            {post.excerpt}
          </p>

          <div class="blog-content" set:html={post.body}></div>

          {/* Author bio */}
          <div class="mt-16 pt-10 border-t border-gray-200 flex items-center gap-5">
            <div class="w-20 h-20 rounded-full overflow-hidden shrink-0 shadow-md">
              <img src="/images/about/founder-portrait.webp" alt={post.author.name} class="w-full h-full object-cover"/>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.2em] font-bold text-primary mb-1">Written by</p>
              <p class="text-lg font-extrabold text-primary-900">{post.author.name}</p>
              <p class="text-sm text-gray-600">{post.author.role}</p>
            </div>
          </div>
        </article>

        {/* SIDEBAR */}
        <aside class="self-start lg:sticky lg:top-24 space-y-6">
          {/* Recent posts */}
          <div class="bg-gray-50 border border-gray-200 p-6 lg:p-7">
            <h3 class="text-xl font-extrabold text-primary-900 mb-5 leading-tight">More from the blog</h3>
            <div class="space-y-5">
              {otherPosts.map((p) => (
                <a href={`/blog/${p.slug}`} class="group flex gap-4 items-start border-b border-gray-200 last:border-b-0 pb-5 last:pb-0">
                  <div class="w-20 h-16 overflow-hidden shrink-0">
                    <img src={p.image} alt={p.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="100" height="80"/>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-[10px] uppercase tracking-wider font-bold text-gray-500 mb-1">{p.dateDisplay}</p>
                    <h4 class="text-sm font-extrabold text-primary-900 group-hover:text-primary leading-snug transition-colors">{p.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* CTA */}
          <a href="/free-estimate" class="block relative aspect-[3/2] overflow-hidden shadow-lg group">
            <img src="/images/about/draw-your-fence-aerial.webp" alt="Get your free fence quote in Ocala FL" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
            <div class="absolute inset-0 bg-primary-900/75 group-hover:bg-primary-900/65 transition-colors"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-5">
              <p class="text-[10px] uppercase tracking-[0.3em] font-bold text-highlight mb-2">The Fast & Easy Way</p>
              <p class="text-xl font-extrabold leading-tight mb-3">Get your real<br/>quote online</p>
              <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold border-2 border-white px-5 py-2 group-hover:bg-white group-hover:text-primary-900 transition-colors">Request Now</span>
            </div>
          </a>
        </aside>

      </div>
    </div>
  </section>

  {/* RELATED POSTS */}
  {finalRelated.length > 0 && (
    <section class="bg-gray-50 py-14 lg:py-20 border-t border-gray-200">
      <div class="container-page">
        <div class="text-center mb-10 lg:mb-12">
          <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-primary mb-3">Keep Reading</p>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-primary-900 leading-tight">More articles like this</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
          {finalRelated.map((p) => (
            <a href={`/blog/${p.slug}`} class="group flex flex-col bg-white shadow-md hover:shadow-2xl transition-all duration-300">
              <div class="aspect-[4/3] overflow-hidden">
                <img src={p.image} alt={p.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="450"/>
              </div>
              <div class="p-6 flex-1 flex flex-col">
                <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-primary mb-2">{p.category}</p>
                <h3 class="text-lg font-extrabold text-primary-900 group-hover:text-primary leading-tight transition-colors mb-4 flex-1">{p.title}</h3>
                <p class="text-sm text-gray-500 pt-3 border-t border-gray-200">{p.dateDisplay}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCTA
    title="Ready for your free fence estimate?"
    subtitle="Same-day quote · $0 down financing · Less than 7 days install"
  />
</PageLayout>

<style is:global>
  .blog-content h2 { font-size: 1.875rem; line-height: 1.1; font-weight: 800; color: #136229; margin-top: 3rem; margin-bottom: 1.25rem; }
  @media (min-width: 1024px) { .blog-content h2 { font-size: 2.25rem; } }
  .blog-content h3 { font-size: 1.5rem; line-height: 1.2; font-weight: 800; color: #136229; margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-content p { font-size: 1.125rem; line-height: 1.75; color: #374151; margin-bottom: 1.5rem; }
  .blog-content ul, .blog-content ol { margin-bottom: 2rem; }
  .blog-content a { color: #136229; font-weight: 700; text-decoration: underline; }
  .blog-content a:hover { color: #0f4d20; }
  .blog-content strong { color: #1f2937; font-weight: 700; }
  .blog-content table { font-size: 0.9rem; }
</style>
