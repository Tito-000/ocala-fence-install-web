---
import PageLayout from '@layouts/PageLayout.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { BLOG_POSTS } from '@data/blog-posts';

const sortedPosts = [...BLOG_POSTS].sort((a, b) => (a.date < b.date ? 1 : -1));
const initialCount = 6;
const initialPosts = sortedPosts.slice(0, initialCount);
const remainingPosts = sortedPosts.slice(initialCount);
const sidebarPosts = sortedPosts.slice(0, 5);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://ocalafenceinstall.com/blog' },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${BUSINESS.name} Fence Blog`,
  description: 'Honest fence advice from a Marion County fence installer — material comparisons, pricing, code, HOA, and install tips.',
  url: 'https://ocalafenceinstall.com/blog',
  publisher: { '@type': 'LocalBusiness', name: BUSINESS.name },
  blogPost: sortedPosts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    image: `https://ocalafenceinstall.com${p.image}`,
    datePublished: p.date,
    description: p.excerpt,
    author: { '@type': 'Person', name: p.author.name },
    url: `https://ocalafenceinstall.com/blog/${p.slug}`,
  })),
};
---

<PageLayout
  title={`Fence Blog | ${BUSINESS.name} | Marion County FL Fence Tips & Guides`}
  description={`Honest fence advice from a Marion County installer — vinyl vs composite, fence cost in Ocala, pool code, HOA approval, permits, and install tips. Updated regularly.`}
  activeNav="Blog"
  schemaJsonLd={[breadcrumbSchema, blogSchema]}
>
  {/* HERO — gray band BJF style + founder portrait */}
  <section class="bg-gradient-to-r from-gray-100 to-gray-50 py-12 lg:py-16 border-b border-gray-200">
    <div class="container-page">
      <div class="flex items-center gap-6 lg:gap-10 max-w-6xl mx-auto">
        <div class="hidden md:block w-32 lg:w-44 aspect-square overflow-hidden shadow-xl shrink-0">
          <img
            src="/images/about/founder-portrait.webp"
            alt="Andri Ramírez, founder of Ocala Fence Install"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div>
          <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-primary mb-2">
            Ocala Fence Install — Blog
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-primary-900 leading-[0.95] tracking-tight">
            Fence Tips &amp; Guides<br/>from Marion County
          </h1>
          <p class="text-base lg:text-lg text-gray-700 mt-4 max-w-2xl leading-relaxed">
            Honest answers to the questions Ocala homeowners actually ask — material comparisons, real pricing, code, HOA, and install advice.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* GRID + SIDEBAR */}
  <section class="bg-white py-12 lg:py-16">
    <div class="container-page">
      <div class="grid lg:grid-cols-[2fr_1fr] gap-8 lg:gap-12 max-w-7xl mx-auto">

        {/* LEFT — posts grid */}
        <div>
          <div class="border-t-2 border-primary mb-8 lg:mb-10"></div>

          <div id="posts-grid" class="grid sm:grid-cols-2 gap-6 lg:gap-8">
            {initialPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group flex flex-col">
                <div class="aspect-[4/3] overflow-hidden shadow-md mb-5">
                  <img
                    src={post.image}
                    alt={post.imageAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    width="600"
                    height="450"
                  />
                </div>
                <div class="flex-1 flex flex-col">
                  <p class="text-[10px] lg:text-xs uppercase tracking-[0.2em] font-bold text-primary mb-2">{post.category}</p>
                  <h2 class="text-xl lg:text-2xl font-extrabold text-primary-900 group-hover:text-primary leading-tight transition-colors mb-4 flex-1">
                    {post.title}
                  </h2>
                  <div class="border-t border-gray-200 pt-3">
                    <p class="text-sm text-gray-500">{post.dateDisplay}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* HIDDEN POSTS (loaded by Cargar más) */}
          {remainingPosts.length > 0 && (
            <div id="posts-grid-more" class="grid sm:grid-cols-2 gap-6 lg:gap-8 mt-6 lg:mt-8 hidden">
              {remainingPosts.map((post) => (
                <a href={`/blog/${post.slug}`} class="group flex flex-col">
                  <div class="aspect-[4/3] overflow-hidden shadow-md mb-5">
                    <img
                      src={post.image}
                      alt={post.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      width="600"
                      height="450"
                    />
                  </div>
                  <div class="flex-1 flex flex-col">
                    <p class="text-[10px] lg:text-xs uppercase tracking-[0.2em] font-bold text-primary mb-2">{post.category}</p>
                    <h2 class="text-xl lg:text-2xl font-extrabold text-primary-900 group-hover:text-primary leading-tight transition-colors mb-4 flex-1">
                      {post.title}
                    </h2>
                    <div class="border-t border-gray-200 pt-3">
                      <p class="text-sm text-gray-500">{post.dateDisplay}</p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}

          {/* Load more button */}
          {remainingPosts.length > 0 && (
            <div class="text-center mt-10 lg:mt-12">
              <button
                type="button"
                id="load-more-btn"
                class="bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm lg:text-base px-12 py-4 shadow-lg transition-colors"
              >
                Load More
              </button>
            </div>
          )}
        </div>

        {/* RIGHT — sidebar */}
        <aside class="bg-gray-50 border border-gray-200 p-6 lg:p-8 self-start lg:sticky lg:top-24">
          <h3 class="text-2xl font-extrabold text-primary-900 mb-6 leading-tight">
            Recent posts from<br/>Ocala Fence Install
          </h3>

          <div class="space-y-5">
            {sidebarPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group flex gap-4 items-start border-b border-gray-200 last:border-b-0 pb-5 last:pb-0">
                <div class="w-24 h-20 overflow-hidden shrink-0">
                  <img
                    src={post.image}
                    alt={post.imageAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    width="120"
                    height="100"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-[10px] uppercase tracking-wider font-bold text-gray-500 mb-1">{post.dateDisplay}</p>
                  <h4 class="text-sm font-extrabold text-primary-900 group-hover:text-primary leading-snug transition-colors">{post.title}</h4>
                </div>
              </a>
            ))}
          </div>

          {/* Promo CTA card */}
          <a href="/free-estimate" class="block mt-8 relative aspect-[3/2] overflow-hidden shadow-lg group">
            <img
              src="/images/about/draw-your-fence-aerial.webp"
              alt="Get your free fence quote in Ocala FL"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-primary-900/75 group-hover:bg-primary-900/65 transition-colors"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-6">
              <p class="text-xs uppercase tracking-[0.3em] font-bold text-highlight mb-2">The Fast and Easy Way</p>
              <p class="text-2xl font-extrabold leading-tight mb-1">Get your real</p>
              <p class="text-2xl font-extrabold leading-tight mb-4">quote online</p>
              <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold border-2 border-white px-5 py-2 group-hover:bg-white group-hover:text-primary-900 transition-colors">
                Request It Now
              </span>
            </div>
          </a>
        </aside>

      </div>
    </div>
  </section>

  <FinalCTA
    title="Ready for your free fence estimate?"
    subtitle="Same-day quote · $0 down financing · Less than 7 days install"
  />
</PageLayout>

<script>
  const btn = document.getElementById('load-more-btn');
  const more = document.getElementById('posts-grid-more');
  btn?.addEventListener('click', () => {
    more?.classList.remove('hidden');
    btn.style.display = 'none';
  });
</script>
