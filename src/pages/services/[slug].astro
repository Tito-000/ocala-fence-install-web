---
import PageLayout from '@layouts/PageLayout.astro';
import FAQ from '@components/FAQ.astro';
import ServiceCard from '@components/ServiceCard.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import TrustBar from '@components/TrustBar.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { SERVICES_CONTENT } from '@data/services-content';

export function getStaticPaths() {
  return BUSINESS.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const content = SERVICES_CONTENT[service.slug];
const otherServices = BUSINESS.services.filter((s) => s.slug !== service.slug);

// Styles per service
const stylesBySlug: Record<string, { name: string; desc: string }[]> = {
  'vinyl-privacy-fence': [
    { name: 'Flat Top', desc: 'Classic clean horizontal top — most popular' },
    { name: 'Scalloped', desc: 'Curved decorative top edge for elegance' },
    { name: 'Lattice Top', desc: 'Privacy bottom + decorative lattice top' },
    { name: 'Shadowbox', desc: 'Alternating boards — privacy from both sides' },
  ],
  'vinyl-picket-fence': [
    { name: 'Pointed Top', desc: 'Traditional pointed pickets — timeless' },
    { name: 'Dog-Ear', desc: 'Rounded corners — softer look' },
    { name: 'Gothic Cap', desc: 'Decorative cap on each picket' },
    { name: 'Flat Top', desc: 'Modern flat-top pickets' },
  ],
  'aluminum-fence': [
    { name: '3-Rail Standard', desc: 'Most common — residential & decorative' },
    { name: '4-Rail Premium', desc: 'Extra rail for security & strength' },
    { name: 'Spear Top', desc: 'Decorative pointed picket tops' },
    { name: 'Flat Top', desc: 'Clean modern perimeter look' },
  ],
  'durafence': [
    { name: 'White', desc: 'Classic curb appeal — most popular' },
    { name: 'Bronze', desc: 'Warm modern look for Mediterranean homes' },
    { name: 'Black', desc: 'Sleek contemporary statement' },
    { name: 'Gate Widths', desc: '5ft or 6ft wide gates standard' },
  ],
};
const styles = stylesBySlug[service.slug] || [];

// Gallery images per service slug — unique image set per service, no repeats
const galleryBySlug: Record<string, { src: string; alt: string }[]> = {
  'vinyl-privacy-fence': [
    // White
    { src: '/images/gallery/vinyl-privacy-white-corner-blue-sky.webp', alt: 'White vinyl privacy fence corner install with bright blue sky — Marion County FL' },
    { src: '/images/gallery/vinyl-privacy-white-backyard-pool-cage.webp', alt: 'White vinyl privacy fence wrapping backyard with pool cage view — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-white-driveway-front.webp', alt: 'White vinyl privacy fence along front driveway with shed — Marion County FL' },
    { src: '/images/gallery/vinyl-privacy-white-driveway-gate.webp', alt: 'White vinyl privacy fence with driveway gate next to garage — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-white-trees.webp', alt: 'White vinyl privacy fence along property line with mature oak trees — Marion County FL' },
    { src: '/images/gallery/vinyl-privacy-white-construction.webp', alt: 'White vinyl privacy fence long run during install — Marion County FL' },
    { src: '/images/gallery/vinyl-privacy-white-double-gate.webp', alt: 'White vinyl privacy fence panels with double-swing gate — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-white-long-run.webp', alt: 'White vinyl privacy fence long run along backyard — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-white-backyard.webp', alt: 'White vinyl privacy fence wrapping backyard property line — Marion County FL' },
    // Tan / Cream
    { src: '/images/gallery/vinyl-privacy-tan-modern-home.webp', alt: 'Tan cream vinyl privacy fence framing modern Florida home — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-tan-shed-yard.webp', alt: 'Tan cream vinyl privacy fence with shed and large yard — Marion County FL' },
    { src: '/images/gallery/vinyl-privacy-tan-side.webp', alt: 'Tan cream vinyl privacy fence side panels with home stucco — Ocala FL' },
    { src: '/images/gallery/vinyl-privacy-tan-condo-side.webp', alt: 'Tan cream vinyl privacy fence side yard between homes — Marion County FL' },
  ],
  // No gallery for vinyl-picket-fence and aluminum-fence yet — Andri has not sent real photos
  // Section is hidden via {galleryImages.length > 0 &&} condition
  'durafence': [
    // Hero image is durafence-bronze-long-run.webp — excluded here so gallery shows different photos
    // White
    { src: '/images/gallery/durafence-white-side.webp', alt: 'White Dura Fence install along side of home in Marion Oaks FL' },
    { src: '/images/gallery/durafence-white-gate.webp', alt: 'White Dura Fence with double gate between two homes — Ocala FL' },
    { src: '/images/gallery/durafence-white-driveway.webp', alt: 'White Dura Fence next to driveway and garage — Ocala FL' },
    { src: '/images/gallery/durafence-white-yard.webp', alt: 'White Dura Fence privacy panel along backyard — Ocala FL' },
    // Bronze
    { src: '/images/gallery/durafence-bronze-side-yard.webp', alt: 'Bronze Dura Fence side yard install with AC unit — Marion County FL' },
    { src: '/images/gallery/durafence-bronze-gate.webp', alt: 'Bronze Dura Fence with gate next to garage — Marion County FL' },
    { src: '/images/gallery/durafence-bronze-corner.webp', alt: 'Bronze Dura Fence corner install — Ocala FL' },
    // Black
    { src: '/images/gallery/durafence-black-long-run.webp', alt: 'Black Dura Fence long run with scalloped top — Ocala FL' },
    { src: '/images/gallery/durafence-black-side.webp', alt: 'Black Dura Fence side yard install — Marion County FL' },
    { src: '/images/gallery/durafence-black-gate.webp', alt: 'Black Dura Fence with double gate — Ocala FL' },
    { src: '/images/gallery/durafence-black-side-narrow.webp', alt: 'Black Dura Fence narrow side yard between two homes — Marion County FL' },
    { src: '/images/gallery/durafence-black-corner-gate.webp', alt: 'Black Dura Fence corner with gate at golden hour — Ocala FL' },
    { src: '/images/gallery/durafence-black-long-perspective.webp', alt: 'Black Dura Fence long run perspective along property line — Marion County FL' },
    { src: '/images/gallery/durafence-black-pasture.webp', alt: 'Black Dura Fence framing open pasture — Ocala FL' },
    { src: '/images/gallery/durafence-black-residential-corner.webp', alt: 'Black Dura Fence residential corner install with white home — Marion County FL' },
  ],
  'horse-fence': [
    // Hero image is horse-fence.webp (long run) — excluded here so gallery shows different photos
    { src: '/images/gallery/horse-fence-white-gate.webp', alt: 'White 3-rail vinyl horse fence with X-brace driveway gate — Marion County FL' },
    { src: '/images/gallery/horse-fence-white-driveway.webp', alt: 'White 3-rail vinyl horse fence along driveway entry — Marion County FL' },
    { src: '/images/gallery/horse-fence-white-residential.webp', alt: 'White 3-rail vinyl horse fence framing residential home — Ocala FL' },
    { src: '/images/gallery/horse-fence-white-long-run.webp', alt: 'White 3-rail vinyl horse fence long run across pasture — Marion County FL' },
  ],
};
const galleryImages = galleryBySlug[service.slug] || [];

// Linear-foot pricing helper
const pricePerFoot = (service as { pricePerFoot?: { min: number; max: number } }).pricePerFoot || { min: 30, max: 50 };
const pricePerFootMid = Math.round((pricePerFoot.min + pricePerFoot.max) / 2);

// Schema.org Product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  provider: {
    '@type': 'LocalBusiness',
    name: BUSINESS.name,
    telephone: BUSINESS.phoneE164,
    address: {
      '@type': 'PostalAddress',
      streetAddress: BUSINESS.address.streetAddress,
      addressLocality: BUSINESS.address.addressLocality,
      addressRegion: BUSINESS.address.addressRegion,
      postalCode: BUSINESS.address.postalCode,
    },
  },
  areaServed: 'Marion County, FL',
  description: content.metaDescription,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: service.priceRange.min,
      maxPrice: service.priceRange.max,
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://ocalafenceinstall.com/services' },
    { '@type': 'ListItem', position: 3, name: service.name, item: `https://ocalafenceinstall.com/services/${service.slug}` },
  ],
};

// FAQ Schema — appears as rich snippets in Google search results
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/<[^>]*>/g, ''), // strip HTML tags for schema
    },
  })),
};
---

<PageLayout
  title={content.metaTitle}
  description={content.metaDescription}
  activeNav="Fence Types"
  schemaJsonLd={[productSchema, breadcrumbSchema, faqSchema]}
>
  {/* Breadcrumb */}
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <a href="/services" class="hover:text-primary">Services</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">{service.name}</span>
      </nav>
    </div>
  </div>

  {/* Product Hero — split screen (wireframe-style, distinct from home hero) */}
  <section class="relative bg-gray-50 border-b border-gray-200">
    {/* Subtle diagonal stripe pattern background */}
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: repeating-linear-gradient(135deg, transparent 0, transparent 18px, #136229 18px, #136229 19px, transparent 19px, transparent 38px);"></div>

    <div class="container-page relative py-12 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-6 lg:gap-12 items-center">
        {/* LEFT — content card */}
        <div class="bg-white border border-gray-200 shadow-md p-6 sm:p-8 lg:p-12">
          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-5">
            {service.popular && (
              <span class="inline-block bg-primary text-white text-[10px] sm:text-xs font-extrabold uppercase tracking-wider px-3 py-1.5">
                Most Popular
              </span>
            )}
            {service.windRated && (
              <span class="inline-block bg-accent text-white text-[10px] sm:text-xs font-extrabold uppercase tracking-wider px-3 py-1.5">
                {service.windRated} Wind-Rated
              </span>
            )}
          </div>

          {/* Title */}
          <h1 class="text-2xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-[1.1] lg:leading-[1.05] tracking-tight mb-5 text-balance text-gray-900">
            <span set:html={content.heroTitle}></span>
          </h1>

          {/* Subtitle */}
          <p class="text-base lg:text-lg text-gray-700 mb-6 leading-relaxed">
            {content.heroSubtitle}
          </p>

          {/* Price box */}
          {service.priceFromMonthly && (
            <div class="bg-highlight-50 border-l-4 border-highlight px-4 py-3 mb-7">
              <p class="text-sm lg:text-base text-gray-800">
                From <strong class="text-lg lg:text-xl text-primary">${service.priceFromMonthly}/month</strong> with $0 down financing
              </p>
            </div>
          )}

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/free-estimate" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-6 sm:px-8 py-4 rounded-none shadow-md transition-colors">
              Get Free Estimate
            </a>
            <a href={`tel:${BUSINESS.phoneE164}`} class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-primary border-2 border-primary font-extrabold uppercase tracking-wider text-sm px-6 sm:px-8 py-4 rounded-none transition-colors" data-track="phone_click">
              Call Now
            </a>
          </div>
        </div>

        {/* RIGHT — product image card */}
        <div class="relative">
          <div class="relative aspect-[4/5] lg:aspect-square overflow-hidden border border-gray-200 shadow-xl bg-white">
            <img
              src={service.image}
              alt={`${service.name} installed in Ocala FL — Marion County fence installation`}
              class="w-full h-full object-cover"
              loading="eager"
              width="1200"
              height="1200"
            />
          </div>

          {/* Floating spec badge */}
          {service.popular && (
            <div class="hidden md:block absolute -bottom-4 -left-4 bg-white shadow-2xl border-l-4 border-primary px-5 py-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-1">Marion County's</div>
              <div class="text-base lg:text-lg font-extrabold text-primary">#1 Choice</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* Trust Bar — same as home */}
  <TrustBar />

  {/* Intro + Image */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="mb-5 text-balance">{content.intro.heading}</h2>
          {content.intro.paragraphs.map((p) => (
            <p class="text-gray-700 text-lg leading-relaxed mb-4" set:html={p}></p>
          ))}
        </div>
        <div class="relative">
          <div class="aspect-[4/5] overflow-hidden shadow-2xl">
            <img
              src={(service as any).image2 || service.image}
              alt={`${service.name} installed in Ocala FL`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Specs & Options — single compact section */}
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Specs &amp; Options</span>
        <h2 class="mb-3 text-balance">{service.shortName} at a glance</h2>
      </div>

      {/* Mobile: swipe hint */}
      <div class="md:hidden flex items-center justify-center gap-2 mb-3 text-xs text-gray-500 font-medium uppercase tracking-wider">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        <span>Swipe to view all specs</span>
      </div>

      <div class="overflow-x-auto -mx-4 md:mx-0 px-4 md:px-0">
        <div class="bg-white border border-gray-200 shadow-sm max-w-4xl mx-auto min-w-[560px]">
          <div class="grid grid-cols-4 divide-x divide-gray-200">
            {/* Height + Gate Widths */}
            <div class="p-4 md:p-6 lg:p-8 text-center">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-primary mx-auto mb-2 md:mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
              <div class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-gray-500 font-bold mb-1 md:mb-2">Height · Gates</div>
              <div class="text-xs md:text-sm font-extrabold text-gray-900 leading-tight">{service.heights.join(' · ')} tall<br/><span class="text-[10px] md:text-xs font-bold text-gray-600">Gates: {(service as any).gateWidths?.join(' / ') || '5ft / 6ft'}</span></div>
            </div>

            {/* Colors */}
            <div class="p-4 md:p-6 lg:p-8 text-center">
              <div class="flex justify-center gap-1 mb-2 md:mb-3">
                {service.colors.slice(0, 3).map((color) => {
                  const c = color.toLowerCase();
                  const bg =
                    c.includes('black') ? 'bg-gray-900' :
                    c.includes('bronze') ? 'bg-amber-800' :
                    c.includes('cedar') ? 'bg-orange-800' :
                    c.includes('brown') ? 'bg-amber-900' :
                    c.includes('pine') ? 'bg-amber-200' :
                    c.includes('galvanized') || c.includes('silver') ? 'bg-gray-400' :
                    c.includes('gray') ? 'bg-gray-300' :
                    c.includes('cream') ? 'bg-amber-50' :
                    'bg-white';
                  return (
                    <span class={`w-4 h-4 md:w-5 md:h-5 border-2 border-gray-300 ${bg}`}></span>
                  );
                })}
              </div>
              <div class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-gray-500 font-bold mb-1 md:mb-2">Colors</div>
              <div class="text-xs md:text-sm font-extrabold text-gray-900 leading-tight">{service.colors.join(' · ')}</div>
            </div>

            {/* Wind rated */}
            <div class="p-4 md:p-6 lg:p-8 text-center">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-primary mx-auto mb-2 md:mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.59 4.59A2 2 0 1111 8H2m10.59 11.41A2 2 0 1014 16H2m15.73-8.27A2.5 2.5 0 1119.5 12H2"/></svg>
              <div class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-gray-500 font-bold mb-1 md:mb-2">Wind Rated</div>
              <div class="text-sm md:text-base font-extrabold text-gray-900">{service.windRated || 'N/A'}</div>
            </div>

            {/* Lifespan */}
            <div class="p-4 md:p-6 lg:p-8 text-center">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-primary mx-auto mb-2 md:mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              <div class="text-[10px] md:text-xs uppercase tracking-[0.15em] text-gray-500 font-bold mb-1 md:mb-2">Lifespan</div>
              <div class="text-xs md:text-base font-extrabold text-gray-900 leading-tight">{service.lifespan}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Comparison Table — Which fence is right for you? */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Compare</span>
        <h2 class="mb-3 text-balance">Which fence is right for you?</h2>
        <p class="text-gray-600 text-lg">A side-by-side comparison of all 4 fence types we install.</p>
      </div>

      {/* Mobile: swipe hint */}
      <div class="md:hidden flex items-center justify-center gap-2 mb-3 text-xs text-gray-500 font-medium uppercase tracking-wider">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        <span>Swipe to compare</span>
      </div>

      {/* Comparison table — same on mobile (with horizontal scroll) and desktop */}
      <div class="overflow-x-auto -mx-4 md:mx-0 px-4 md:px-0">
        <table class="w-full bg-white border border-gray-200 text-xs md:text-sm lg:text-base min-w-[560px]">
          <thead>
            <tr class="bg-gray-50 border-b-2 border-gray-200">
              <th class="text-left p-2.5 md:p-4 font-extrabold text-gray-700 uppercase tracking-wider text-[10px] md:text-xs whitespace-nowrap">Feature</th>
              {BUSINESS.services.map((s) => (
                <th class={`text-center p-2.5 md:p-4 font-extrabold uppercase tracking-wider text-[10px] md:text-xs ${s.slug === service.slug ? "bg-primary text-white" : "text-gray-700"}`}>
                  {s.shortName}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="p-2.5 md:p-4 font-semibold text-gray-700 whitespace-nowrap">Price (avg.)</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-2.5 md:p-4 text-center whitespace-nowrap ${s.slug === service.slug ? "bg-primary-50 font-extrabold text-primary" : "text-gray-700"}`}>
                  ${(s.priceRange.min / 1000).toFixed(1)}k–${(s.priceRange.max / 1000).toFixed(0)}k
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-2.5 md:p-4 font-semibold text-gray-700 whitespace-nowrap">Wind Rating</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-2.5 md:p-4 text-center whitespace-nowrap ${s.slug === service.slug ? "bg-primary-50 font-extrabold text-primary" : "text-gray-700"}`}>
                  {s.windRated || '—'}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-2.5 md:p-4 font-semibold text-gray-700 whitespace-nowrap">Lifespan</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-2.5 md:p-4 text-center whitespace-nowrap ${s.slug === service.slug ? "bg-primary-50 font-extrabold text-primary" : "text-gray-700"}`}>
                  {s.lifespan}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-2.5 md:p-4 font-semibold text-gray-700 whitespace-nowrap">Maintenance</td>
              {BUSINESS.services.map((s) => {
                const maintenance = s.slug === 'durafence' ? 'Hose and Paint' : 'Hose only';
                return (
                  <td class={`p-2.5 md:p-4 text-center whitespace-nowrap ${s.slug === service.slug ? "bg-primary-50 font-extrabold text-primary" : "text-gray-700"}`}>
                    {maintenance}
                  </td>
                );
              })}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-2.5 md:p-4 font-semibold text-gray-700 whitespace-nowrap">Privacy</td>
              {BUSINESS.services.map((s) => {
                const privacy = s.slug === 'vinyl-privacy-fence' ? 'Full' :
                                s.slug === 'durafence' ? 'Full' :
                                s.slug === 'composite-fence' ? 'Full' :
                                s.slug === 'vinyl-picket-fence' ? 'Decorative' :
                                'See-through';
                return (
                  <td class={`p-2.5 md:p-4 text-center whitespace-nowrap ${s.slug === service.slug ? "bg-primary-50 font-extrabold text-primary" : "text-gray-700"}`}>
                    {privacy}
