<script is:inline>
  document.querySelectorAll('[data-lf-calc]').forEach((calc) => {
    const min = parseFloat(calc.dataset.min);
    const max = parseFloat(calc.dataset.max);
    const mid = parseFloat(calc.dataset.mid);
    const tiers = { min, mid, max };
    let currentTier = 'mid';

    const input = calc.querySelector('[data-lf-input]');
    const feetEl = calc.querySelector('[data-lf-feet]');
    const totalEl = calc.querySelector('[data-lf-total]');
    const rateEl = calc.querySelector('[data-lf-rate]');
    const monthlyEl = calc.querySelector('[data-lf-monthly]');
    const tierLabel = calc.querySelector('[data-lf-tier-label]');
    const tierBtns = calc.querySelectorAll('[data-lf-tier]');
    const tierLabels = { min: 'Basic', mid: 'Standard', max: 'Premium' };

    function fmt(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    function update() {
      const feet = parseInt(input.value, 10);
      const rate = tiers[currentTier];
      const total = feet * rate;
      // Estimate monthly via 60-month financing at 6.99% APR
      const r = 0.0699 / 12;
      const n = 60;
      const monthly = (total * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      feetEl.textContent = feet + ' ft';
      totalEl.textContent = fmt(total);
      if (rateEl) rateEl.textContent = '$' + rate;
      monthlyEl.textContent = fmt(monthly);
      tierLabel.textContent = tierLabels[currentTier];
    }

    input.addEventListener('input', update);
    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentTier = btn.dataset.lfTier;
        tierBtns.forEach((b) => {
          const active = b === btn;
          b.dataset.active = active ? 'true' : 'false';
          b.classList.toggle('border-highlight', active);
          b.classList.toggle('bg-highlight/15', active);
          b.classList.toggle('border-white/30', !active);
        });
        update();
      });
    });
    update();
  });
</script>
