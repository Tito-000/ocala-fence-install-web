---
import PageLayout from '@layouts/PageLayout.astro';
import FAQ from '@components/FAQ.astro';
import ServiceCard from '@components/ServiceCard.astro';
import FinancingCalculator from '@components/FinancingCalculator.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';
import { SERVICES_CONTENT } from '@data/services-content';

export function getStaticPaths() {
  return BUSINESS.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const content = SERVICES_CONTENT[service.slug];
const otherServices = BUSINESS.services.filter((s) => s.slug !== service.slug);

// Styles per service
const stylesBySlug: Record<string, { name: string; desc: string }[]> = {
  'vinyl-privacy-fence': [
    { name: 'Flat Top', desc: 'Classic clean horizontal top — most popular' },
    { name: 'Scalloped', desc: 'Curved decorative top edge for elegance' },
    { name: 'Lattice Top', desc: 'Privacy bottom + decorative lattice top' },
    { name: 'Shadowbox', desc: 'Alternating boards — privacy from both sides' },
  ],
  'vinyl-picket-fence': [
    { name: 'Pointed Top', desc: 'Traditional pointed pickets — timeless' },
    { name: 'Dog-Ear', desc: 'Rounded corners — softer look' },
    { name: 'Gothic Cap', desc: 'Decorative cap on each picket' },
    { name: 'Flat Top', desc: 'Modern flat-top pickets' },
  ],
  'durafence': [
    { name: 'Stone Texture', desc: 'Realistic stacked stone look' },
    { name: 'Smooth Finish', desc: 'Clean modern smooth surface' },
    { name: 'Combination', desc: 'Stone bottom + smooth top accent' },
    { name: 'Custom Heights', desc: '5ft, 6ft, custom on request' },
  ],
  'aluminum-fence': [
    { name: '3-Rail Standard', desc: 'Most common — pool & residential' },
    { name: '4-Rail Premium', desc: 'Extra rail for security & strength' },
    { name: 'Spear Top', desc: 'Decorative pointed picket tops' },
    { name: 'Flat Top', desc: 'Clean modern look — pool perimeter' },
  ],
  'pool-fence': [
    { name: 'Black Aluminum', desc: 'Most popular — disappears visually' },
    { name: 'White Vinyl Picket', desc: 'Classic white look pool perimeter' },
    { name: 'Self-Closing Gate', desc: 'Magnetic latch · §515 compliant' },
    { name: 'Double Gate', desc: 'Wide access for equipment' },
  ],
};
const styles = stylesBySlug[service.slug] || [];

// Schema.org Product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  provider: {
    '@type': 'LocalBusiness',
    name: BUSINESS.name,
    telephone: BUSINESS.phoneE164,
    address: {
      '@type': 'PostalAddress',
      streetAddress: BUSINESS.address.streetAddress,
      addressLocality: BUSINESS.address.addressLocality,
      addressRegion: BUSINESS.address.addressRegion,
      postalCode: BUSINESS.address.postalCode,
    },
  },
  areaServed: 'Marion County, FL',
  description: content.metaDescription,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: service.priceRange.min,
      maxPrice: service.priceRange.max,
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://ocalafenceinstall.com/services' },
    { '@type': 'ListItem', position: 3, name: service.name, item: `https://ocalafenceinstall.com/services/${service.slug}` },
  ],
};
---

<PageLayout
  title={content.metaTitle}
  description={content.metaDescription}
  activeNav="Services"
  schemaJsonLd={[productSchema, breadcrumbSchema]}
>
  {/* Breadcrumb */}
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <a href="/services" class="hover:text-primary">Services</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">{service.name}</span>
      </nav>
    </div>
  </div>

  {/* Product Hero — split screen (wireframe-style, distinct from home hero) */}
  <section class="relative bg-gray-50 border-b border-gray-200">
    {/* Subtle diagonal stripe pattern background */}
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: repeating-linear-gradient(135deg, transparent 0, transparent 18px, #136229 18px, #136229 19px, transparent 19px, transparent 38px);"></div>

    <div class="container-page relative py-12 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        {/* LEFT — content card */}
        <div class="bg-white border border-gray-200 shadow-md p-8 lg:p-12">
          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-5">
            {service.popular && (
              <span class="inline-block bg-primary text-white text-xs font-extrabold uppercase tracking-wider px-3 py-1.5">
                Most Popular
              </span>
            )}
            {service.windRated && (
              <span class="inline-block bg-accent text-white text-xs font-extrabold uppercase tracking-wider px-3 py-1.5">
                {service.windRated} Wind-Rated
              </span>
            )}
          </div>

          {/* Title */}
          <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold uppercase leading-[1.05] tracking-tight mb-5 text-balance text-gray-900">
            <span set:html={content.heroTitle}></span>
          </h1>

          {/* Subtitle */}
          <p class="text-base lg:text-lg text-gray-700 mb-6 leading-relaxed">
            {content.heroSubtitle}
          </p>

          {/* Price box */}
          {service.priceFromMonthly && (
            <div class="bg-highlight-50 border-l-4 border-highlight px-4 py-3 mb-7">
              <p class="text-sm lg:text-base text-gray-800">
                From <strong class="text-lg lg:text-xl text-primary">${service.priceFromMonthly}/month</strong> with $0 down financing
              </p>
            </div>
          )}

          {/* CTAs */}
          <div class="flex flex-wrap gap-3">
            <a href="/free-estimate" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-8 py-4 rounded-none shadow-md transition-colors">
              Get Free Estimate
            </a>
            <a href={`tel:${BUSINESS.phoneE164}`} class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-primary border-2 border-primary font-extrabold uppercase tracking-wider text-sm px-8 py-4 rounded-none transition-colors" data-track="click_phone">
              Call Now
            </a>
          </div>
        </div>

        {/* RIGHT — product image card */}
        <div class="relative">
          <div class="relative aspect-[4/5] lg:aspect-square overflow-hidden border border-gray-200 shadow-xl bg-white">
            <img
              src={service.image}
              alt={`${service.name} installed in Ocala FL — Marion County fence installation`}
              class="w-full h-full object-cover"
              loading="eager"
              width="1200"
              height="1200"
            />
          </div>

          {/* Floating spec badge */}
          {service.popular && (
            <div class="hidden md:block absolute -bottom-4 -left-4 bg-white shadow-2xl border-l-4 border-primary px-5 py-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-1">Marion County's</div>
              <div class="text-base lg:text-lg font-extrabold text-primary">#1 Choice</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* Quick Specs Bar */}
  <section class="bg-highlight-100 border-y border-highlight-200">
    <div class="container-page py-6 lg:py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5 lg:gap-8">
        <div class="text-center">
          <div class="text-xs uppercase tracking-wider text-accent-700 font-bold mb-1">Heights</div>
          <div class="text-base lg:text-lg font-extrabold text-accent">{service.heights.join(' · ')}</div>
        </div>
        <div class="text-center">
          <div class="text-xs uppercase tracking-wider text-accent-700 font-bold mb-1">Wind Rated</div>
          <div class="text-base lg:text-lg font-extrabold text-accent">{service.windRated || 'N/A'}</div>
        </div>
        <div class="text-center">
          <div class="text-xs uppercase tracking-wider text-accent-700 font-bold mb-1">Lifespan</div>
          <div class="text-base lg:text-lg font-extrabold text-accent">{service.lifespan}</div>
        </div>
        <div class="text-center">
          <div class="text-xs uppercase tracking-wider text-accent-700 font-bold mb-1">Install Time</div>
          <div class="text-base lg:text-lg font-extrabold text-accent">&lt; 7 days</div>
        </div>
      </div>
    </div>
  </section>

  {/* Intro + Image */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="mb-5 text-balance">{content.intro.heading}</h2>
          {content.intro.paragraphs.map((p) => (
            <p class="text-gray-700 text-lg leading-relaxed mb-4">{p}</p>
          ))}
        </div>
        <div class="relative">
          <div class="aspect-[4/5] overflow-hidden shadow-2xl">
            <img
              src={service.image}
              alt={`${service.name} installed in Ocala FL`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Why this product */}
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Why {service.shortName}</span>
        <h2 class="mb-3 text-balance">Why {service.shortName} is right for Florida</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
        {content.whyCards.map((card) => (
          <div class="bg-white border border-gray-200 p-6 lg:p-7">
            <div class="w-12 h-12 bg-primary mb-4 flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h3 class="text-lg font-extrabold mb-3 leading-tight">{card.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Colors & Heights */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Options</span>
        <h2 class="mb-3 text-balance">Available colors &amp; heights</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 lg:gap-12 max-w-4xl mx-auto">
        {/* Colors */}
        <div class="bg-gray-50 p-6 lg:p-8">
          <h3 class="text-xs uppercase tracking-[0.2em] text-gray-500 font-bold mb-4">Colors</h3>
          <ul class="space-y-3">
            {service.colors.map((color) => (
              <li class="flex items-center gap-3">
                <span class={`w-6 h-6 border-2 border-gray-300 shrink-0 ${
                  color.toLowerCase().includes('black') ? 'bg-gray-900' :
                  color.toLowerCase().includes('bronze') ? 'bg-amber-800' :
                  color.toLowerCase().includes('gray') ? 'bg-gray-300' :
                  color.toLowerCase().includes('cream') ? 'bg-amber-50' :
                  'bg-white'
                }`}></span>
                <span class="text-base font-semibold text-gray-800">{color}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Heights */}
        <div class="bg-gray-50 p-6 lg:p-8">
          <h3 class="text-xs uppercase tracking-[0.2em] text-gray-500 font-bold mb-4">Heights Available</h3>
          <ul class="space-y-3">
            {service.heights.map((h) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-base font-semibold text-gray-800">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Styles / Variants */}
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Styles</span>
        <h2 class="mb-3 text-balance">{service.shortName} styles &amp; variants</h2>
        <p class="text-gray-600 text-lg">Common configurations we install across Marion County.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-5">
        {styles.map((style) => (
          <div class="bg-white border border-gray-200 p-5 hover:border-primary hover:shadow-md transition-all">
            <h3 class="text-base lg:text-lg font-extrabold text-gray-900 mb-2 leading-tight">{style.name}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{style.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Comparison Table — Which fence is right for you? */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Compare</span>
        <h2 class="mb-3 text-balance">Which fence is right for you?</h2>
        <p class="text-gray-600 text-lg">A side-by-side comparison of all 5 fence types we install.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full bg-white border border-gray-200 text-sm lg:text-base">
          <thead>
            <tr class="bg-gray-50 border-b-2 border-gray-200">
              <th class="text-left p-4 font-extrabold text-gray-700 uppercase tracking-wider text-xs">Feature</th>
              {BUSINESS.services.map((s) => (
                <th class={`text-center p-4 font-extrabold uppercase tracking-wider text-xs ${s.slug === service.slug ? 'bg-primary text-white' : 'text-gray-700'}`}>
                  {s.shortName}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="p-4 font-semibold text-gray-700">Price (avg.)</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50 font-extrabold text-primary' : 'text-gray-700'}`}>
                  ${(s.priceRange.min / 1000).toFixed(1)}k–${(s.priceRange.max / 1000).toFixed(0)}k
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-4 font-semibold text-gray-700">Wind Rating</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50 font-extrabold text-primary' : 'text-gray-700'}`}>
                  {s.windRated || '—'}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-4 font-semibold text-gray-700">Lifespan</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50 font-extrabold text-primary' : 'text-gray-700'}`}>
                  {s.lifespan}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-4 font-semibold text-gray-700">Maintenance</td>
              {BUSINESS.services.map((s) => (
                <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50 font-extrabold text-primary' : 'text-gray-700'}`}>
                  {s.slug.includes('aluminum') || s.slug.includes('pool') ? 'None' : 'Hose only'}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-100">
              <td class="p-4 font-semibold text-gray-700">Privacy</td>
              {BUSINESS.services.map((s) => {
                const privacy = s.slug === 'vinyl-privacy-fence' ? 'Full' :
                                s.slug === 'durafence' ? 'Full' :
                                s.slug === 'vinyl-picket-fence' ? 'Decorative' :
                                'See-through';
                return (
                  <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50 font-extrabold text-primary' : 'text-gray-700'}`}>
                    {privacy}
                  </td>
                );
              })}
            </tr>
            <tr>
              <td class="p-4 font-semibold text-gray-700">Pool Code</td>
              {BUSINESS.services.map((s) => {
                const compliant = s.slug === 'pool-fence' || s.slug === 'aluminum-fence';
                return (
                  <td class={`p-4 text-center ${s.slug === service.slug ? 'bg-primary-50' : ''}`}>
                    {compliant ? (
                      <svg class="w-6 h-6 text-primary mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    ) : (
                      <span class="text-gray-300 text-xl">—</span>
                    )}
                  </td>
                );
              })}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Financing Calculator */}
  <section class="section relative overflow-hidden bg-gradient-to-b from-gray-100 via-gray-50 to-gray-100 border-y border-gray-200">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: linear-gradient(0deg, transparent 24px, #136229 25px, transparent 26px), linear-gradient(90deg, transparent 24px, #136229 25px, transparent 26px); background-size: 25px 25px;"></div>

    <div class="container-page relative">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="inline-block text-primary text-xs lg:text-sm font-extrabold uppercase tracking-[0.2em] mb-4">
          Financing Available
        </span>
        <h2 class="mb-5 text-balance">Calculate your monthly payment</h2>
        <p class="text-gray-600 text-lg lg:text-xl leading-relaxed">
          Most {service.shortName.toLowerCase()} projects fit between <strong>$80 and $200/month</strong> with $0 down. Move the sliders.
        </p>
      </div>

      <FinancingCalculator
        defaultAmount={Math.round((service.priceRange.min + service.priceRange.max) / 2)}
        minAmount={service.priceRange.min}
        maxAmount={service.priceRange.max}
      />
    </div>
  </section>

  {/* Process — same visual style as home page (photo + numbered badge) */}
  <section class="section bg-highlight-50">
    <div class="container-page">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-14">
        <span class="badge-highlight mb-4">Our Process</span>
        <h2 class="mb-3 text-balance">Four easy steps to your perfect fence</h2>
        <p class="text-gray-600 text-lg">No phone games. No surprise charges. Same-day quotes Mon through Sun.</p>
      </div>

      <ProcessSteps />
    </div>
  </section>

  {/* Gallery filtered (placeholders) */}
  <section class="section bg-gray-50">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Gallery</span>
        <h2 class="mb-3 text-balance">Recent {service.shortName.toLowerCase()} projects</h2>
        <p class="text-gray-600 text-lg">A look at our recent {service.shortName.toLowerCase()} installations across Marion County.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 lg:gap-4">
        {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
          <div class="relative aspect-square overflow-hidden bg-gray-100 border border-gray-200">
            <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-gray-100 to-highlight-50"></div>
            <div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(45deg, transparent 49%, #136229 49%, #136229 51%, transparent 51%); background-size: 16px 16px;"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/gallery" class="inline-flex items-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-extrabold uppercase tracking-wider text-base px-10 py-4 rounded-none transition-colors">
          View Full Gallery
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="section bg-white">
    <div class="container-page max-w-3xl">
      <div class="text-center mb-10">
        <span class="badge-highlight mb-4">FAQ</span>
        <h2 class="mb-3 text-balance">{service.shortName} questions, answered</h2>
      </div>
      <FAQ items={content.faqs} />
    </div>
  </section>

  {/* Other services */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Other Services</span>
        <h2 class="mb-3 text-balance">Other fence types we install</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-5">
        {otherServices.map((s) => (
          <ServiceCard
            slug={s.slug}
            name={s.shortName}
            tagline={s.tagline}
            image={s.image}
            priceFromMonthly={s.priceFromMonthly}
            popular={s.popular}
          />
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    title={`Ready for your ${service.shortName.toLowerCase()} estimate?`}
    subtitle="Same-day quote · $0 down financing · Less than 7 days install"
  />
</PageLayout>
