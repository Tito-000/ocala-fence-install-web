---
import PageLayout from '@layouts/PageLayout.astro';
import { BUSINESS } from '@data/business';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Cotización Gratis', item: 'https://ocalafenceinstall.com/cotizacion-gratis' },
  ],
};
---

<PageLayout
  title="Cotización Gratis de Cercas en Ocala FL | El Mismo Día · $0 Inicial"
  description="Recibe una cotización escrita y gratis para tu cerca en Ocala o Marion County. Visita a domicilio el mismo día o al día siguiente. Hablamos español."
  activeNav="Contact"
  noindex={true}
  schemaJsonLd={breadcrumbSchema}
>
  <!-- Breadcrumb -->
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">Cotización Gratis</span>
      </nav>
    </div>
  </div>

  <!-- Form Hero (split screen) -->
  <section class="bg-gradient-to-b from-gray-50 via-white to-gray-50 py-12 lg:py-16 border-b border-gray-200">
    <div class="container-page">
      <div class="grid lg:grid-cols-[1fr_1.2fr] gap-8 lg:gap-12 items-start">
        <!-- LEFT: Value props -->
        <div>
          <span class="inline-block bg-primary text-white text-xs font-extrabold uppercase tracking-wider px-3 py-1.5 rounded-none mb-5">
            Cotización Gratis
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-[1.05] tracking-tight uppercase mb-5 text-balance">
            Recibe tu <span class="text-primary">cotización gratis de cerca en Ocala</span> en 60 segundos
          </h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            Cuéntanos unos detalles y vamos a medir tu propiedad — normalmente en 24-48 horas. Precio escrito en el momento. Sin juegos por teléfono, sin cargos sorpresa.
          </p>

          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>El mismo día o al siguiente</strong> — estimado a domicilio</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Precio escrito</strong> en el momento — sin juegos por teléfono</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Financiamiento $0 inicial</strong> — pre-califica en 60 segundos</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Nosotros tramitamos el permiso</strong> por ti</span>
            </li>
          </ul>

          <!-- Phone preferred? -->
          <div class="bg-highlight-50 border-l-4 border-highlight p-5 rounded-none">
            <p class="text-sm text-gray-800">
              <strong>¿Prefieres llamar?</strong> Llama al <a href={`tel:${BUSINESS.phoneE164}`} class="text-primary font-extrabold hover:underline" data-track="phone_click">{BUSINESS.phone}</a><br>
              <span class="text-xs text-gray-600">Lun–Dom · 9am a 9pm · Hablamos español</span>
            </p>
          </div>
        </div>

        <!-- RIGHT: Multi-step form -->
        <div class="bg-white border-2 border-gray-300 shadow-2xl p-6 lg:p-8" data-estimate-form>
          <!-- Step indicator -->
          <div class="flex items-center justify-center gap-2 mb-6" data-step-indicator>
            {[1, 2, 3, 4].map((n) => (
              <div
                class={`h-1.5 w-12 rounded-none transition-all ${n === 1 ? 'bg-primary' : 'bg-gray-200'}`}
                data-step-bar={n}
              ></div>
            ))}
          </div>

          <p class="text-xs uppercase tracking-wider text-gray-500 font-bold text-center mb-6" data-step-label>
            Paso 1 de 4
          </p>

          <form id="estimate-form" action="/api/lead" method="post" novalidate data-ghl-endpoint="/api/lead">
            <input type="hidden" name="redirect" value="/gracias" />
            <input type="hidden" name="fence_type" id="fence_type" />
            <input type="hidden" name="size" id="size" />
            <input type="hidden" name="timeline" id="timeline" />

            <!-- STEP 1 — Fence type (with images) -->
            <div class="form-step" data-step="1">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">¿Qué tipo de cerca?</h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {[
                  { value: 'dura_fence',    label: 'Dura Fence',     image: '/images/services/durafence.webp', popular: true },
                  { value: 'vinyl_privacy', label: 'Vinyl Privacidad', image: '/images/services/vinyl-privacy.webp' },
                  { value: 'vinyl_picket',  label: 'Vinyl Picket',   image: '/images/services/vinyl-picket.webp' },
                  { value: 'aluminum',      label: 'Aluminio',       image: '/images/services/aluminum.webp' },
                  { value: 'horse_fence',   label: 'Cerca de Caballo', image: '/images/services/horse-fence.webp' },
                  { value: 'chain_link',    label: 'Chain Link',     image: '/images/services/chain-link.webp' },
                  { value: 'wood_fence',    label: 'Madera',         image: '/images/services/wood-fence.webp' },
                  { value: 'not_sure',      label: 'No estoy seguro', icon: 'help' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt relative border-2 border-gray-300 overflow-hidden hover:border-primary transition-all aspect-[4/5]"
                    data-option-step="1"
                    data-option-value={opt.value}
                  >
                    {opt.image ? (
                      <img src={opt.image} alt={opt.label} class="absolute inset-0 w-full h-full object-cover group-hover/opt:scale-105 transition-transform pointer-events-none" loading="lazy" />
                    ) : (
                      <div class="absolute inset-0 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center pointer-events-none">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      </div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>
                    {opt.popular && (
                      <span class="absolute top-2 left-2 bg-highlight text-primary-900 text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider px-2 py-1 rounded-sm shadow pointer-events-none">
                        Más Popular
                      </span>
                    )}
                    <span class="absolute inset-x-0 bottom-0 p-3 text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider text-center leading-tight drop-shadow-lg pointer-events-none">
                      {opt.label}
                    </span>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 2 — Size (with icons) -->
            <div class="form-step hidden" data-step="2">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">Tamaño aproximado de la propiedad</h3>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { value: '<100ft', label: '< 100 ft', sub: 'Patio pequeño', size: 'xs' },
                  { value: '100-200ft', label: '100–200 ft', sub: 'Patio mediano', size: 'sm' },
                  { value: '200-400ft', label: '200–400 ft', sub: 'Patio grande', size: 'md' },
                  { value: '400+ft', label: '400+ ft', sub: 'Extra grande', size: 'lg' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt border-2 border-gray-300 p-5 hover:border-primary hover:bg-primary-50 transition-colors text-center"
                    data-option-step="2"
                    data-option-value={opt.value}
                  >
                    {/* Yard size icon — house + scaled fence */}
                    <div class="flex items-center justify-center mb-3 h-14">
                      <div class="relative flex items-end gap-1">
                        <svg class="w-8 h-8 text-primary shrink-0" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 3l-9 8h2v9h5v-6h4v6h5v-9h2z"/>
                        </svg>
                        <div class={`bg-primary ${opt.size === 'xs' ? 'w-4 h-4' : opt.size === 'sm' ? 'w-7 h-5' : opt.size === 'md' ? 'w-12 h-6' : 'w-16 h-7'}`}></div>
                      </div>
                    </div>
                    <div class="text-base font-extrabold text-gray-900 mb-1">{opt.label}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider">{opt.sub}</div>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 3 — Timeline (with icons) -->
            <div class="form-step hidden" data-step="3">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">¿Cuándo la necesitas?</h3>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { value: 'asap', label: 'Lo antes posible', sub: '2–3 días', icon: 'fire' },
                  { value: 'this-month', label: 'Este mes', sub: 'En 30 días', icon: 'calendar' },
                  { value: '1-3-months', label: 'En 1–3 meses', sub: 'Pronto', icon: 'clock' },
                  { value: 'exploring', label: 'Solo explorando', sub: 'Investigando', icon: 'search' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt border-2 border-gray-300 p-5 hover:border-primary hover:bg-primary-50 transition-colors text-center"
                    data-option-step="3"
                    data-option-value={opt.value}
                  >
                    <div class="flex items-center justify-center mb-3 h-14">
                      {opt.icon === 'fire' && (
                        <svg class="w-12 h-12 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67M11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/>
                        </svg>
                      )}
                      {opt.icon === 'calendar' && (
                        <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      )}
                      {opt.icon === 'clock' && (
                        <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      )}
                      {opt.icon === 'search' && (
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                      )}
                    </div>
                    <div class="text-base font-extrabold text-gray-900 mb-1">{opt.label}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider">{opt.sub}</div>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 4 — Contact info -->
            <div class="form-step hidden" data-step="4">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">Tus datos de contacto</h3>
              <div class="space-y-4">
                <div>
                  <label for="full_name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Nombre completo</label>
                  <input type="text" id="full_name" name="full_name" required autocomplete="name"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Teléfono (preferido)</label>
                  <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(___) ___-____"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Correo electrónico</label>
                  <input type="email" id="email" name="email" autocomplete="email"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="address" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Dirección de la propiedad (ciudad / código postal)</label>
                  <input type="text" id="address" name="address" required autocomplete="street-address"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">¿Algo más? (opcional)</label>
                  <textarea id="notes" name="notes" rows="3"
                    class="w-full px-4 py-3 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors"></textarea>
                </div>
              </div>
            </div>

            <!-- Solo aparece si el lead NO llegó al CRM — nunca perder un lead
                 en silencio (ni contar una conversión falsa). -->
            <div
              id="estimate-error"
              role="alert"
              class="hidden mt-6 border-2 border-red-500 bg-red-50 text-red-800 px-4 py-3 text-sm font-semibold"
            >
              No pudimos enviar tu solicitud. Intenta de nuevo, o escríbenos al
              <a href={`tel:${BUSINESS.phoneE164}`} class="underline font-extrabold" data-track="phone_click">{BUSINESS.phone}</a>
              o por
              <a href={`https://wa.me/${BUSINESS.whatsappE164}`} target="_blank" rel="noopener" class="underline font-extrabold" data-track="whatsapp_click">WhatsApp</a>.
            </div>

            <!-- Form nav -->
            <div class="flex gap-3 mt-6">
              <button type="button" data-prev-btn
                class="flex-1 h-12 border-2 border-gray-300 text-gray-700 font-extrabold uppercase tracking-wider text-sm hover:border-primary hover:text-primary transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                disabled>
                ← Atrás
              </button>
              <button type="button" data-next-btn
                class="flex-1 h-12 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm transition-colors">
                Siguiente →
              </button>
              <button type="submit" data-submit-btn
                class="flex-1 h-12 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm transition-colors hidden">
                Recibir mi cotización →
              </button>
            </div>
          </form>

          <!-- Trust row -->
          <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-gray-200 text-center">
            <div>
              <div class="text-yellow-400 text-sm mb-1">★★★★★</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Reseñas</div>
            </div>
            <div>
              <div class="text-primary text-sm font-extrabold mb-1">FL</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Con Licencia y Asegurados</div>
            </div>
            <div>
              <div class="text-primary text-sm font-extrabold mb-1">$0</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Inicial · Financiamiento</div>
            </div>
          </div>

          <p class="text-[11px] text-center text-gray-500 mt-4 italic flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Nunca compartimos tu información. Una llamada de nuestra parte — sin spam.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Phone allergic? Alternatives -->
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Otras Formas</span>
        <h2 class="mb-3 text-balance">¿Prefieres no llenar un formulario?</h2>
        <p class="text-gray-600 text-lg">Contacta a Andri directamente por el canal que prefieras.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 lg:gap-6 max-w-5xl mx-auto">
        <!-- Call -->
        <a href={`tel:${BUSINESS.phoneE164}`} class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-primary hover:shadow-lg transition-all" data-track="phone_click">
          <div class="w-14 h-14 bg-primary mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-primary transition-colors">Llámanos</h3>
          <p class="text-sm text-gray-600 mb-4">{BUSINESS.phone} · Lun–Dom 9am-9pm</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-primary">Llamar ahora →</span>
        </a>

        <!-- WhatsApp -->
        <a href={`https://wa.me/${BUSINESS.whatsappE164}?text=${encodeURIComponent('¡Hola! Quiero una cotización gratis para una cerca en Ocala.')}`} target="_blank" rel="noopener" class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-primary hover:shadow-lg transition-all" data-track="whatsapp_click">
          <div class="w-14 h-14 bg-primary mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-primary transition-colors">WhatsApp</h3>
          <p class="text-sm text-gray-600 mb-4">Escríbele a Andri · Respuesta rápida</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-primary">Abrir WhatsApp →</span>
        </a>

        <!-- Email -->
        <a href={`mailto:${BUSINESS.email}?subject=Solicitud%20de%20cotizaci%C3%B3n%20de%20cerca`} class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-accent hover:shadow-lg transition-all" data-track="click_email">
          <div class="w-14 h-14 bg-accent mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-accent transition-colors">Escríbenos</h3>
          <p class="text-sm text-gray-600 mb-4">Envía fotos y detalles · Respuesta en 24h</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-accent">Enviar correo →</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const wrapper = document.querySelector('[data-estimate-form]');
      if (!wrapper) return;
      const form = document.getElementById('estimate-form');
      if (!form) return;
      const steps = wrapper.querySelectorAll('.form-step');
      const stepBars = wrapper.querySelectorAll('[data-step-bar]');
      const stepLabel = wrapper.querySelector('[data-step-label]');
      const prevBtn = wrapper.querySelector('[data-prev-btn]');
      const nextBtn = wrapper.querySelector('[data-next-btn]');
      const submitBtn = wrapper.querySelector('[data-submit-btn]');
      const totalSteps = 4;
      let current = 1;

      function render() {
        steps.forEach((s) => {
          const n = parseInt(s.getAttribute('data-step'));
          s.classList.toggle('hidden', n !== current);
        });
        stepBars.forEach((b) => {
          const n = parseInt(b.getAttribute('data-step-bar'));
          b.classList.toggle('bg-primary', n <= current);
          b.classList.toggle('bg-gray-200', n > current);
        });
        stepLabel.textContent = `Paso ${current} de ${totalSteps}`;
        prevBtn.disabled = current === 1;
        nextBtn.classList.toggle('hidden', current === totalSteps);
        submitBtn.classList.toggle('hidden', current !== totalSteps);
      }

      form.addEventListener('click', (e) => {
        const card = e.target.closest('[data-option-value]');
        if (!card || !form.contains(card)) return;
        const step = card.getAttribute('data-option-step');
        const value = card.getAttribute('data-option-value');
        if (!step || !value) return;

        form.querySelectorAll('[data-option-step="' + step + '"]').forEach((c) => {
          c.classList.remove('border-primary', 'ring-4', 'ring-primary/30');
          c.classList.add('border-gray-300');
        });
        card.classList.remove('border-gray-300');
        card.classList.add('border-primary', 'ring-4', 'ring-primary/30');

        if (step === '1') document.getElementById('fence_type').value = value;
        if (step === '2') document.getElementById('size').value = value;
        if (step === '3') document.getElementById('timeline').value = value;

        setTimeout(() => {
          if (current < totalSteps) {
            current++;
            render();
          }
        }, 250);
      });

      nextBtn.addEventListener('click', () => {
        if (current < totalSteps) {
          current++;
          render();
        }
      });
      prevBtn.addEventListener('click', () => {
        if (current > 1) {
          current--;
          render();
        }
      });

      // Pre-fill ZIP from URL ?zip=XXXXX
      const params = new URLSearchParams(window.location.search);
      const zip = params.get('zip');
      if (zip) {
        const addr = document.getElementById('address');
        if (addr) addr.value = `Ocala — ZIP ${zip}`;
      }

      // Submit handler — POST to /api/lead, then redirect to /gracias.
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Enviando…';
        }

        const data = new FormData(form);
        function gcl(k) {
          try {
            return new URLSearchParams(window.location.search).get(k) || localStorage.getItem('ofi_' + k) || '';
          } catch (_) { return ''; }
        }
        const payload = {
          full_name:   data.get('full_name') || '',
          phone:       data.get('phone') || '',
          email:       data.get('email') || '',
          address:     data.get('address') || '',
          notes:       data.get('notes') || '',
          fence_type:  data.get('fence_type') || '',
          size:        data.get('size') || '',
          timeline:    data.get('timeline') || '',
          gclid:       gcl('gclid'),
          wbraid:      gcl('wbraid'),
          gbraid:      gcl('gbraid'),
        };

        // Solo avanzamos si el lead LLEGÓ al CRM. Redirigir tras un POST fallido
        // mostraría "gracias", dispararía la conversión y perdería el lead — un
        // fallo silencioso que en los reportes parece una victoria.
        let ok = false;
        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          ok = res.ok;
        } catch (_) { ok = false; }

        if (!ok) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Recibir mi cotización →';
          }
          const errBox = document.getElementById('estimate-error');
          if (errBox) {
            errBox.classList.remove('hidden');
            errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          return;
        }

        // La conversión de lead se dispara al CARGAR /gracias (confiable, sin
        // carrera con el redirect). Solo pasamos params no-PII + un id único.
        const qs = new URLSearchParams({
          lead: String(Date.now()),
          fence_type: payload.fence_type,
          size: payload.size,
          timeline: payload.timeline,
        }).toString();
        window.location.href = `/gracias?${qs}`;
      });

      render();
    })();
  </script>
</PageLayout>
