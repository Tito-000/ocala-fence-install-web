---
import PageLayout from '@layouts/PageLayout.astro';
import { BUSINESS } from '@data/business';

const whatsappUrl = `https://wa.me/${BUSINESS.whatsappE164}?text=${encodeURIComponent('Hi! I just submitted a quote request on your website and wanted to follow up.')}`;
const phoneUrl = `tel:${BUSINESS.phoneE164}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Thank You', item: 'https://ocalafenceinstall.com/thank-you' },
  ],
};
---

<PageLayout
  title={`Thank You! | ${BUSINESS.name}`}
  description="Thanks for your fence quote request. We'll be in touch within 24 hours with your written estimate."
  activeNav=""
  noindex={true}
  schemaJsonLd={[breadcrumbSchema]}
>
  {/* HERO — green checkmark + headline */}
  <section class="bg-gradient-to-b from-primary-900 via-primary to-primary-700 py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>

    <div class="container-page relative">
      <div class="max-w-3xl mx-auto text-center text-white">
        {/* Animated checkmark circle */}
        <div class="w-24 h-24 lg:w-32 lg:h-32 rounded-full bg-highlight flex items-center justify-center mx-auto mb-8 shadow-2xl animate-pulse-slow">
          <svg class="w-14 h-14 lg:w-20 lg:h-20 text-primary-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>

        <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-highlight mb-4">
          Got It — We're On It
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[0.95] tracking-tight mb-6 text-balance drop-shadow-2xl">
          Thanks for reaching out!
        </h1>

        <p class="text-base lg:text-xl text-white/95 max-w-2xl mx-auto leading-relaxed font-semibold">
          Your fence quote request just landed in our inbox. A real person from our team will reach out <strong class="text-highlight">within 24 hours</strong> with your written estimate.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 lg:gap-4 mt-10">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm lg:text-base px-8 py-4 shadow-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            WhatsApp Us Now
          </a>
          <a
            href={phoneUrl}
            class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-primary-900 font-extrabold uppercase tracking-wider text-sm lg:text-base px-8 py-4 shadow-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515L10.42 8.03a2 2 0 01-.45 1.95l-1.27 1.27a11 11 0 005.05 5.05l1.27-1.27a2 2 0 011.95-.45l3.515.879A2 2 0 0122 17.72V20a2 2 0 01-2 2h-1C9.611 22 2 14.389 2 5V5a2 2 0 011-2z"/></svg>
            Call {BUSINESS.phone}
          </a>
        </div>

        <p class="text-xs text-white/70 mt-5 leading-relaxed">
          Hablamos español también.
        </p>
      </div>
    </div>
  </section>

  {/* WHAT HAPPENS NEXT — 3-step timeline */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-14">
        <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-primary mb-3">What Happens Next</p>
        <h2 class="text-3xl lg:text-4xl xl:text-5xl font-extrabold text-primary-900 leading-[1.05]">Here's exactly how this goes</h2>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
        <div class="relative bg-white border-2 border-gray-200 hover:border-primary p-7 lg:p-8 shadow-md hover:shadow-xl transition-all">
          <div class="absolute -top-5 left-7 w-12 h-12 rounded-full bg-primary text-white text-2xl font-extrabold flex items-center justify-center shadow-lg border-4 border-white">1</div>
          <div class="mt-3">
            <p class="text-xs uppercase tracking-[0.2em] font-bold text-primary mb-2">Within 24 hours</p>
            <h3 class="text-xl font-extrabold text-primary-900 mb-3 leading-tight">We call or text you</h3>
            <p class="text-base text-gray-700 leading-relaxed">A real person from our Ocala team confirms project details, asks any quick questions, and schedules your on-site visit.</p>
          </div>
        </div>

        <div class="relative bg-white border-2 border-gray-200 hover:border-primary p-7 lg:p-8 shadow-md hover:shadow-xl transition-all">
          <div class="absolute -top-5 left-7 w-12 h-12 rounded-full bg-primary text-white text-2xl font-extrabold flex items-center justify-center shadow-lg border-4 border-white">2</div>
          <div class="mt-3">
            <p class="text-xs uppercase tracking-[0.2em] font-bold text-primary mb-2">Day 2-3</p>
            <h3 class="text-xl font-extrabold text-primary-900 mb-3 leading-tight">Free on-site visit</h3>
            <p class="text-base text-gray-700 leading-relaxed">We measure your yard, walk the fence line with you, and discuss material options. <strong>No high-pressure sales</strong>, no obligation.</p>
          </div>
        </div>

        <div class="relative bg-white border-2 border-gray-200 hover:border-primary p-7 lg:p-8 shadow-md hover:shadow-xl transition-all">
          <div class="absolute -top-5 left-7 w-12 h-12 rounded-full bg-primary text-white text-2xl font-extrabold flex items-center justify-center shadow-lg border-4 border-white">3</div>
          <div class="mt-3">
            <p class="text-xs uppercase tracking-[0.2em] font-bold text-primary mb-2">Day 3-4</p>
            <h3 class="text-xl font-extrabold text-primary-900 mb-3 leading-tight">Written quote in your inbox</h3>
            <p class="text-base text-gray-700 leading-relaxed">Sketch, dimensions, materials, warranty info, and total price. Sign online and we schedule install — typically within 7 days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WHILE YOU WAIT — cross-sell to Gallery + Blog */}
  <section class="bg-gray-50 py-16 lg:py-20">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
        <p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-bold text-primary mb-3">While You Wait</p>
        <h2 class="text-3xl lg:text-4xl font-extrabold text-primary-900 leading-tight">Get inspired or get smarter</h2>
      </div>

      <div class="grid sm:grid-cols-3 gap-5 lg:gap-6 max-w-6xl mx-auto">
        <a href="/gallery" class="group relative aspect-[4/3] overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300">
          <img src="/images/gallery/vinyl-privacy-tan.webp" alt="Browse fence install gallery" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
          <div class="absolute inset-0 bg-primary-900/65 group-hover:bg-primary-900/55 transition-colors"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-6">
            <p class="text-xs uppercase tracking-[0.3em] font-bold text-highlight mb-2">Browse</p>
            <p class="text-2xl lg:text-3xl font-extrabold leading-tight mb-3">Project Gallery</p>
            <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold border-2 border-white px-5 py-2 group-hover:bg-white group-hover:text-primary-900 transition-colors">See Recent Installs →</span>
          </div>
        </a>

        <a href="/financing" class="group relative aspect-[4/3] overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300">
          <img src="/images/about/draw-your-fence-aerial.webp" alt="Fence financing options" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
          <div class="absolute inset-0 bg-primary-900/75 group-hover:bg-primary-900/65 transition-colors"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-6">
            <p class="text-xs uppercase tracking-[0.3em] font-bold text-highlight mb-2">Try It</p>
            <p class="text-2xl lg:text-3xl font-extrabold leading-tight mb-3">Finance Calculator</p>
            <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold border-2 border-white px-5 py-2 group-hover:bg-white group-hover:text-primary-900 transition-colors">$0 Down · No Credit Hit →</span>
          </div>
        </a>

        <a href="/blog" class="group relative aspect-[4/3] overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300">
          <img src="/images/blog/vinyl-vs-composite-fence-florida.webp" alt="Fence install tips and guides" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy"/>
          <div class="absolute inset-0 bg-primary-900/65 group-hover:bg-primary-900/55 transition-colors"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-6">
            <p class="text-xs uppercase tracking-[0.3em] font-bold text-highlight mb-2">Read</p>
            <p class="text-2xl lg:text-3xl font-extrabold leading-tight mb-3">Fence Tips &amp; Guides</p>
            <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold border-2 border-white px-5 py-2 group-hover:bg-white group-hover:text-primary-900 transition-colors">Visit Blog →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* TRUST FOOTER STRIP */}
  <section class="bg-primary-900 text-white py-10 lg:py-12">
    <div class="container-page">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-1 mb-3">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6 text-highlight" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <p class="text-base lg:text-lg font-semibold leading-relaxed">
          <strong class="text-highlight">Marion County's family-owned fence team since 2021.</strong> 100% bilingual English &amp; español.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  @keyframes pulse-slow {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  .animate-pulse-slow {
    animation: pulse-slow 2.5s ease-in-out infinite;
  }
</style>
