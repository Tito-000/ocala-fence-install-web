---
import PageLayout from '@layouts/PageLayout.astro';
import { BUSINESS } from '@data/business';

const LAST_UPDATED = 'July 2026';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: 'https://ocalafenceinstall.com/terms' },
  ],
};
---

<PageLayout
  title={`Terms of Service | ${BUSINESS.name}`}
  description="The terms that apply when you use the Ocala Fence Install website or request an estimate."
  activeNav=""
  schemaJsonLd={[breadcrumbSchema]}
>
  <section class="bg-black py-16 lg:py-20">
    <div class="container-page">
      <p class="text-highlight text-sm uppercase tracking-[0.3em] font-bold mb-4">Legal</p>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white leading-tight tracking-tight">Terms of Service</h1>
      <p class="text-white/60 mt-4 text-sm">Last updated: {LAST_UPDATED}</p>
    </div>
  </section>

  <section class="bg-white py-14 lg:py-20">
    <div class="container-page max-w-3xl legal-prose">
      <p>
        These terms apply to your use of <a href="https://ocalafenceinstall.com">ocalafenceinstall.com</a>, operated by
        {BUSINESS.legalName} (d/b/a {BUSINESS.name}). By using this site or submitting a request, you agree to these terms.
      </p>

      <h2>Estimates and quotes</h2>
      <p>
        Any price ranges, monthly payment figures, or timelines shown on this site are for general information only. They
        are not a formal quote or a binding offer. Your actual price and schedule are confirmed in a written estimate or
        agreement after we review your specific project, materials, site conditions, and any permit requirements.
      </p>

      <h2>The work we do</h2>
      <p>
        The scope, materials, price, payment terms, and any warranty for your project are set out in the written agreement
        you sign with us. If anything on this website differs from that signed agreement, the signed agreement controls.
      </p>

      <h2>Financing</h2>
      <p>
        Financing options mentioned on this site are offered by third-party lenders. Approval, rates, and terms are set by
        the lender, subject to their criteria, and are not guaranteed by us.
      </p>

      <h2>Website content</h2>
      <p>
        We work to keep information on this site accurate and current, but we do not warrant that it is complete or
        error-free. Photos may show representative projects. Content, logos, and images on this site are owned by us or our
        licensors and may not be copied without permission.
      </p>

      <h2>Communications</h2>
      <p>
        When you contact us or submit a form, you agree that we may reach you by phone, text, email, or WhatsApp about your
        request. See our <a href="/privacy-policy">Privacy Policy</a> for how we handle your information.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        This website is provided "as is." To the extent permitted by law, we are not liable for indirect or incidental
        damages arising from your use of the site. Nothing here limits the rights or obligations set out in a signed
        installation agreement.
      </p>

      <h2>Governing law</h2>
      <p>These terms are governed by the laws of the State of Florida.</p>

      <h2>Changes</h2>
      <p>
        We may update these terms from time to time. The "last updated" date above shows when they last changed. Continued
        use of the site means you accept the current version.
      </p>

      <h2>Contact us</h2>
      <p>
        {BUSINESS.legalName} (d/b/a {BUSINESS.name})<br />
        {BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion}<br />
        Phone: <a href={`tel:${BUSINESS.phoneE164}`}>{BUSINESS.phone}</a><br />
        Email: <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .legal-prose { color: #374151; line-height: 1.75; }
  .legal-prose > p { margin-bottom: 1.25rem; }
  .legal-prose h2 { color: #134529; font-weight: 800; font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 0.9rem; }
  .legal-prose ul { list-style: disc; padding-left: 1.4rem; margin-bottom: 1.25rem; }
  .legal-prose li { margin-bottom: 0.55rem; }
  .legal-prose a { color: #136229; text-decoration: underline; font-weight: 600; }
</style>
