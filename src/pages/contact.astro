---
import PageLayout from '@layouts/PageLayout.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';

const waUrl = `https://wa.me/${BUSINESS.whatsappE164}?text=${encodeURIComponent("Hi! I'm interested in a fence estimate for my property in Ocala.")}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FenceContractor',
  '@id': 'https://ocalafenceinstall.com/contact#business',
  name: BUSINESS.name,
  url: 'https://ocalafenceinstall.com/contact',
  telephone: BUSINESS.phoneE164,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.latitude,
    longitude: BUSINESS.geo.longitude,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: BUSINESS.hours.phone.open,
    closes: BUSINESS.hours.phone.close,
  }],
  priceRange: '$$$',
  areaServed: BUSINESS.serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.name}, ${a.state}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://ocalafenceinstall.com/contact' },
  ],
};

// Google Maps embed for Ocala office
const fullAddress = `${BUSINESS.address.streetAddress}, ${BUSINESS.address.addressLocality}, ${BUSINESS.address.addressRegion} ${BUSINESS.address.postalCode}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
---

<PageLayout
  title={`Contact ${BUSINESS.name} | ${BUSINESS.phone} · Ocala FL Fence Company`}
  description={`Contact Ocala Fence Install — call ${BUSINESS.phone}, WhatsApp us, or email. Same-day estimates Mon-Sun 9am-9pm. Marion County's family-owned fence team.`}
  activeNav="Contact"
  schemaJsonLd={[localBusinessSchema, breadcrumbSchema]}
>
  {/* Breadcrumb */}
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">Contact</span>
      </nav>
    </div>
  </div>

  {/* HERO */}
  <section class="relative overflow-hidden bg-primary-900 text-white">
    <div class="absolute inset-0">
      <img
        src="/images/services/vinyl-privacy.webp"
        alt=""
        class="w-full h-full object-cover opacity-30"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/95 via-primary-900/85 to-primary-900/70"></div>
    </div>

    <div class="container-page relative py-20 lg:py-28">
      <div class="max-w-3xl">
        <span class="inline-block bg-highlight/20 border border-highlight/40 text-highlight text-xs font-bold uppercase tracking-wider px-3 py-1.5 mb-6 backdrop-blur-sm">
          We're here to help
        </span>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-[0.95] tracking-tight mb-6 text-balance drop-shadow-lg">
          Get in touch with <span class="text-highlight">Ocala Fence Install</span>
        </h1>
        <p class="text-lg lg:text-xl text-white/95 mb-8 max-w-2xl leading-relaxed drop-shadow">
          Same-day estimates. WhatsApp, phone, or email — whatever works for you. Marion County's family-owned fence team.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={`tel:${BUSINESS.phoneE164}`} class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-10 py-5 shadow-lg transition-colors" data-track="phone_click">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
          <a href={waUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-highlight hover:bg-highlight-200 text-primary-900 font-extrabold uppercase tracking-wider text-sm px-10 py-5 shadow-lg transition-colors" data-track="whatsapp_click">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* QUICK CONTACT INFO — 4 cards */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-4 text-balance">Reach us your way</h2>
        <p class="text-lg text-gray-600">Phone, WhatsApp, email, or in-person — pick what's easiest.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 max-w-6xl mx-auto">
        {/* Phone */}
        <a href={`tel:${BUSINESS.phoneE164}`} data-track="phone_click" class="group block bg-white hover:bg-primary p-7 transition-all border border-gray-200 hover:border-primary hover:shadow-xl hover:-translate-y-1">
          <div class="w-14 h-14 rounded-full bg-primary-50 group-hover:bg-highlight flex items-center justify-center mb-5 transition-colors">
            <svg class="w-7 h-7 text-primary group-hover:text-primary-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <div class="text-xs uppercase tracking-[0.2em] font-bold text-gray-500 group-hover:text-highlight mb-2 transition-colors">Call us</div>
          <div class="text-xl lg:text-2xl font-extrabold text-primary-900 group-hover:text-white transition-colors">{BUSINESS.phone}</div>
          <div class="text-sm text-gray-600 group-hover:text-white/90 mt-2 transition-colors">Mon–Sun · 9am to 9pm</div>
        </a>

        {/* WhatsApp */}
        <a href={waUrl} target="_blank" rel="noopener" data-track="whatsapp_click" class="group block bg-white hover:bg-primary p-7 transition-all border border-gray-200 hover:border-primary hover:shadow-xl hover:-translate-y-1">
          <div class="w-14 h-14 rounded-full bg-primary-50 group-hover:bg-highlight flex items-center justify-center mb-5 transition-colors">
            <svg class="w-7 h-7 text-primary group-hover:text-primary-900 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </div>
          <div class="text-xs uppercase tracking-[0.2em] font-bold text-gray-500 group-hover:text-highlight mb-2 transition-colors">WhatsApp</div>
          <div class="text-xl lg:text-2xl font-extrabold text-primary-900 group-hover:text-white transition-colors">Message Us</div>
          <div class="text-sm text-gray-600 group-hover:text-white/90 mt-2 transition-colors">Fastest response</div>
        </a>

        {/* Email */}
        <a href={`mailto:${BUSINESS.email}`} class="group block bg-white hover:bg-primary p-7 transition-all border border-gray-200 hover:border-primary hover:shadow-xl hover:-translate-y-1">
          <div class="w-14 h-14 rounded-full bg-primary-50 group-hover:bg-highlight flex items-center justify-center mb-5 transition-colors">
            <svg class="w-7 h-7 text-primary group-hover:text-primary-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div class="text-xs uppercase tracking-[0.2em] font-bold text-gray-500 group-hover:text-highlight mb-2 transition-colors">Email</div>
          <div class="text-base lg:text-lg font-extrabold text-primary-900 group-hover:text-white transition-colors break-all">{BUSINESS.email}</div>
          <div class="text-sm text-gray-600 group-hover:text-white/90 mt-2 transition-colors">Reply within 24 hours</div>
        </a>

        {/* Address */}
        <a href={`https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}`} target="_blank" rel="noopener" class="group block bg-white hover:bg-primary p-7 transition-all border border-gray-200 hover:border-primary hover:shadow-xl hover:-translate-y-1">
          <div class="w-14 h-14 rounded-full bg-primary-50 group-hover:bg-highlight flex items-center justify-center mb-5 transition-colors">
            <svg class="w-7 h-7 text-primary group-hover:text-primary-900 transition-colors" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
          </div>
          <div class="text-xs uppercase tracking-[0.2em] font-bold text-gray-500 group-hover:text-highlight mb-2 transition-colors">Visit us</div>
          <div class="text-base lg:text-lg font-extrabold text-primary-900 group-hover:text-white transition-colors">
            {BUSINESS.address.streetAddress}<br/>
            {BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}
          </div>
          <div class="text-sm text-gray-600 group-hover:text-white/90 mt-2 transition-colors">Get directions →</div>
        </a>
      </div>
    </div>
  </section>

  {/* CONTACT FORM + MAP — split layout */}
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 max-w-6xl mx-auto items-start">
        {/* LEFT — form */}
        <div>
          <span class="inline-block text-xs uppercase tracking-[0.2em] font-bold text-primary mb-4">Send a message</span>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
            Tell us about your project
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            Fill out the form and our team will get back to you within 24 hours. For faster response, use WhatsApp.
          </p>

          <form
            class="space-y-5"
            action={BUSINESS.ghlWebhookUrl || '#'}
            method="POST"
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">Phone *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900"
              />
            </div>

            <div>
              <label for="zip" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">ZIP code</label>
              <input
                type="text"
                id="zip"
                name="zip"
                inputmode="numeric"
                pattern="[0-9]{5}"
                maxlength="5"
                placeholder="34471"
                class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900"
              />
            </div>

            <div>
              <label for="fence-type" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">Fence type</label>
              <select
                id="fence-type"
                name="fence-type"
                class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900"
              >
                <option value="">Not sure yet — help me decide</option>
                {BUSINESS.services.map((s) => (
                  <option value={s.slug}>{s.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs uppercase tracking-wider font-bold text-gray-700 mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Tell us about your property, fence length, timeline, anything you'd like us to know..."
                class="w-full px-5 py-4 bg-white border border-gray-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 text-gray-900 resize-y"
              ></textarea>
            </div>

            <input type="hidden" name="source" value="contact-page" />

            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm px-12 py-5 shadow-lg transition-colors"
            >
              Send Message
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>

            <p class="text-xs text-gray-500 italic">
              By submitting, you agree to be contacted by Ocala Fence Install. We never share your info.
            </p>
          </form>
        </div>

        {/* RIGHT — map + info card */}
        <div class="lg:sticky lg:top-24 space-y-6">
          {/* Map */}
          <div class="relative aspect-[4/3] lg:aspect-square overflow-hidden border border-gray-200 shadow-lg bg-white">
            <iframe
              src={mapEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`${BUSINESS.name} — Ocala FL location map`}
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>

          {/* Hours card */}
          <div class="bg-primary-900 text-white p-7 lg:p-8">
            <div class="flex items-center gap-3 mb-5">
              <svg class="w-6 h-6 text-highlight" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-xs uppercase tracking-[0.2em] font-bold text-highlight">Hours of Operation</span>
            </div>

            <div class="space-y-3 mb-6">
              <div class="flex justify-between items-baseline border-b border-white/15 pb-3">
                <span class="font-bold">Phone &amp; WhatsApp</span>
                <span class="text-highlight font-extrabold">9am – 9pm</span>
              </div>
              <div class="flex justify-between items-baseline border-b border-white/15 pb-3">
                <span class="font-bold">On-site Estimates</span>
                <span class="text-highlight font-extrabold">11am – 7pm</span>
              </div>
              <div class="flex justify-between items-baseline">
                <span class="font-bold">Days</span>
                <span class="text-highlight font-extrabold">Mon – Sun</span>
              </div>
            </div>

            <div class="border-t border-white/20 pt-5">
              <div class="text-xs uppercase tracking-[0.2em] font-bold text-highlight mb-3">Service Area</div>
              <p class="text-sm text-white/90 leading-relaxed">
                Ocala · Belleview · Summerfield · Silver Springs · Dunnellon · The Villages · Lady Lake · all of Marion County
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    title="Ready to start your fence project?"
    subtitle="Get a free same-day estimate · $0 down financing · Less than 7 days install"
  />
</PageLayout>
