---
import PageLayout from '@layouts/PageLayout.astro';
import { BUSINESS } from '@data/business';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'Free Estimate', item: 'https://ocalafenceinstall.com/free-estimate' },
  ],
};
---

<PageLayout
  title="Free Fence Estimate Ocala FL | Same-Day Quote · $0 Down"
  description="Get a free, written fence estimate for your Ocala or Marion County property. Same-day or next-day on-site visit. Vinyl, DuraFence, aluminum, and pool fences."
  activeNav="Contact"
  schemaJsonLd={breadcrumbSchema}
>
  <!-- Breadcrumb -->
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">Free Estimate</span>
      </nav>
    </div>
  </div>

  <!-- Form Hero (split screen) -->
  <section class="bg-gradient-to-b from-gray-50 via-white to-gray-50 py-12 lg:py-16 border-b border-gray-200">
    <div class="container-page">
      <div class="grid lg:grid-cols-[1fr_1.2fr] gap-8 lg:gap-12 items-start">
        <!-- LEFT: Value props -->
        <div>
          <span class="inline-block bg-primary text-white text-xs font-extrabold uppercase tracking-wider px-3 py-1.5 rounded-none mb-5">
            Free Estimate
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-[1.05] tracking-tight uppercase mb-5 text-balance">
            Get your free <span class="text-primary">Ocala fence estimate</span> in 60 seconds
          </h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            Tell us a few details and we'll come measure your property — usually within 24-48 hours. Written quote on the spot. No phone games, no surprise charges.
          </p>

          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Same-day or next-day</strong> on-site estimate</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Written price</strong> on the spot — no phone games</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>$0 down financing</strong> — pre-qualify in 60 seconds</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-gray-800"><strong>Lifetime materials warranty</strong> — transferable</span>
            </li>
          </ul>

          <!-- Phone preferred? -->
          <div class="bg-highlight-50 border-l-4 border-highlight p-5 rounded-none">
            <p class="text-sm text-gray-800">
              <strong>Phone preferred?</strong> Call <a href={`tel:${BUSINESS.phoneE164}`} class="text-primary font-extrabold hover:underline" data-track="click_phone">{BUSINESS.phone}</a><br>
              <span class="text-xs text-gray-600">Mon–Sun · 9am to 9pm</span>
            </p>
          </div>
        </div>

        <!-- RIGHT: Multi-step form -->
        <div class="bg-white border-2 border-gray-300 shadow-2xl p-6 lg:p-8" data-estimate-form>
          <!-- Step indicator -->
          <div class="flex items-center justify-center gap-2 mb-6" data-step-indicator>
            {[1, 2, 3, 4].map((n) => (
              <div
                class={`h-1.5 w-12 rounded-none transition-all ${n === 1 ? 'bg-primary' : 'bg-gray-200'}`}
                data-step-bar={n}
              ></div>
            ))}
          </div>

          <p class="text-xs uppercase tracking-wider text-gray-500 font-bold text-center mb-6" data-step-label>
            Step 1 of 4
          </p>

          <form id="estimate-form" action="/thank-you" method="get" novalidate>
            <input type="hidden" name="fence_type" id="fence_type" />
            <input type="hidden" name="size" id="size" />
            <input type="hidden" name="timeline" id="timeline" />

            <!-- STEP 1 — Fence type (with images) -->
            <div class="form-step" data-step="1">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">What kind of fence?</h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {[
                  { value: 'vinyl-privacy', label: 'Vinyl Privacy', image: '/images/services/vinyl-privacy.jpg' },
                  { value: 'vinyl-picket', label: 'Vinyl Picket', image: '/images/services/vinyl-picket.jpg' },
                  { value: 'durafence', label: 'DuraFence', image: '/images/services/durafence.jpg' },
                  { value: 'aluminum', label: 'Aluminum', image: '/images/services/aluminum.jpg' },
                  { value: 'pool-fence', label: 'Pool Fence', image: '/images/services/pool-fence.jpg' },
                  { value: 'not-sure', label: 'Not sure', icon: 'help' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt relative border-2 border-gray-300 overflow-hidden hover:border-primary transition-all aspect-[4/5]"
                    data-option-step="1"
                    data-option-value={opt.value}
                  >
                    {opt.image ? (
                      <img src={opt.image} alt={opt.label} class="absolute inset-0 w-full h-full object-cover group-hover/opt:scale-105 transition-transform" loading="lazy" />
                    ) : (
                      <div class="absolute inset-0 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      </div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
                    <span class="absolute inset-x-0 bottom-0 p-3 text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider text-center leading-tight drop-shadow-lg">
                      {opt.label}
                    </span>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 2 — Size (with icons) -->
            <div class="form-step hidden" data-step="2">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">Approximate property size</h3>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { value: '<100ft', label: '< 100 ft', sub: 'Small yard', size: 'xs' },
                  { value: '100-200ft', label: '100–200 ft', sub: 'Medium yard', size: 'sm' },
                  { value: '200-400ft', label: '200–400 ft', sub: 'Large yard', size: 'md' },
                  { value: '400+ft', label: '400+ ft', sub: 'Extra large', size: 'lg' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt border-2 border-gray-300 p-5 hover:border-primary hover:bg-primary-50 transition-colors text-center"
                    data-option-step="2"
                    data-option-value={opt.value}
                  >
                    {/* Yard size icon — house + scaled fence */}
                    <div class="flex items-center justify-center mb-3 h-14">
                      <div class="relative flex items-end gap-1">
                        <svg class="w-8 h-8 text-primary shrink-0" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 3l-9 8h2v9h5v-6h4v6h5v-9h2z"/>
                        </svg>
                        <div class={`bg-primary ${opt.size === 'xs' ? 'w-4 h-4' : opt.size === 'sm' ? 'w-7 h-5' : opt.size === 'md' ? 'w-12 h-6' : 'w-16 h-7'}`}></div>
                      </div>
                    </div>
                    <div class="text-base font-extrabold text-gray-900 mb-1">{opt.label}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider">{opt.sub}</div>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 3 — Timeline (with icons) -->
            <div class="form-step hidden" data-step="3">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">When do you need it?</h3>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { value: 'asap', label: 'ASAP', sub: '2–3 days', icon: 'fire' },
                  { value: 'this-month', label: 'This month', sub: 'Within 30 days', icon: 'calendar' },
                  { value: '1-3-months', label: 'Next 1–3 months', sub: 'Soon', icon: 'clock' },
                  { value: 'exploring', label: 'Just exploring', sub: 'Researching', icon: 'search' },
                ].map((opt) => (
                  <button
                    type="button"
                    class="option-card group/opt border-2 border-gray-300 p-5 hover:border-primary hover:bg-primary-50 transition-colors text-center"
                    data-option-step="3"
                    data-option-value={opt.value}
                  >
                    <div class="flex items-center justify-center mb-3 h-14">
                      {opt.icon === 'fire' && (
                        <svg class="w-12 h-12 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67M11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/>
                        </svg>
                      )}
                      {opt.icon === 'calendar' && (
                        <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      )}
                      {opt.icon === 'clock' && (
                        <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      )}
                      {opt.icon === 'search' && (
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                      )}
                    </div>
                    <div class="text-base font-extrabold text-gray-900 mb-1">{opt.label}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider">{opt.sub}</div>
                  </button>
                ))}
              </div>
            </div>

            <!-- STEP 4 — Contact info -->
            <div class="form-step hidden" data-step="4">
              <h3 class="text-xl lg:text-2xl font-extrabold mb-5">Your contact info</h3>
              <div class="space-y-4">
                <div>
                  <label for="full_name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Full name</label>
                  <input type="text" id="full_name" name="full_name" required autocomplete="name"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Phone (preferred)</label>
                  <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(___) ___-____"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Email</label>
                  <input type="email" id="email" name="email" autocomplete="email"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="address" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Property address (city / ZIP)</label>
                  <input type="text" id="address" name="address" required autocomplete="street-address"
                    class="w-full h-12 px-4 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Anything else? (optional)</label>
                  <textarea id="notes" name="notes" rows="3"
                    class="w-full px-4 py-3 text-base rounded-none bg-gray-50 text-gray-900 border-2 border-gray-300 focus:border-primary focus:bg-white focus:outline-none transition-colors"></textarea>
                </div>
              </div>
            </div>

            <!-- Form nav -->
            <div class="flex gap-3 mt-6">
              <button type="button" data-prev-btn
                class="flex-1 h-12 border-2 border-gray-300 text-gray-700 font-extrabold uppercase tracking-wider text-sm hover:border-primary hover:text-primary transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                disabled>
                ← Back
              </button>
              <button type="button" data-next-btn
                class="flex-1 h-12 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm transition-colors">
                Next →
              </button>
              <button type="submit" data-submit-btn
                class="flex-1 h-12 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-sm transition-colors hidden">
                Get My Estimate →
              </button>
            </div>
          </form>

          <!-- Trust row -->
          <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-gray-200 text-center">
            <div>
              <div class="text-yellow-400 text-sm mb-1">★★★★★</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Reviews</div>
            </div>
            <div>
              <div class="text-primary text-sm font-extrabold mb-1">FL</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Licensed &amp; Insured</div>
            </div>
            <div>
              <div class="text-primary text-sm font-extrabold mb-1">$0</div>
              <div class="text-[11px] text-gray-600 font-semibold uppercase tracking-wider">Down Financing</div>
            </div>
          </div>

          <p class="text-[11px] text-center text-gray-500 mt-4 italic flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            We never share your info. One call from us — no spam ever.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Phone allergic? Alternatives -->
  <section class="section bg-white">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="badge-highlight mb-4">Other Ways</span>
        <h2 class="mb-3 text-balance">Prefer not to fill out a form?</h2>
        <p class="text-gray-600 text-lg">Reach Andry directly through the channel you prefer.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 lg:gap-6 max-w-5xl mx-auto">
        <!-- Call -->
        <a href={`tel:${BUSINESS.phoneE164}`} class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-primary hover:shadow-lg transition-all" data-track="click_phone">
          <div class="w-14 h-14 bg-primary mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-primary transition-colors">Call us</h3>
          <p class="text-sm text-gray-600 mb-4">{BUSINESS.phone} · Mon–Sun 9am-9pm</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-primary">Call now →</span>
        </a>

        <!-- WhatsApp -->
        <a href={`https://wa.me/${BUSINESS.whatsappE164}`} target="_blank" rel="noopener" class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-[#25D366] hover:shadow-lg transition-all" data-track="click_whatsapp">
          <div class="w-14 h-14 bg-[#25D366] mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-[#25D366] transition-colors">WhatsApp</h3>
          <p class="text-sm text-gray-600 mb-4">Text Andry direct · Quick replies</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-[#25D366]">Open WhatsApp →</span>
        </a>

        <!-- Email -->
        <a href={`mailto:${BUSINESS.email}?subject=Fence%20estimate%20request`} class="group block bg-white border-2 border-gray-200 p-6 lg:p-8 text-center hover:border-accent hover:shadow-lg transition-all" data-track="click_email">
          <div class="w-14 h-14 bg-accent mx-auto mb-4 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 group-hover:text-accent transition-colors">Email us</h3>
          <p class="text-sm text-gray-600 mb-4">Send photos &amp; details · Reply within 24h</p>
          <span class="inline-block text-sm font-bold uppercase tracking-wider text-accent">Send email →</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('[data-estimate-form]');
      if (!form) return;
      const steps = form.querySelectorAll('.form-step');
      const stepBars = form.querySelectorAll('[data-step-bar]');
      const stepLabel = form.querySelector('[data-step-label]');
      const prevBtn = form.querySelector('[data-prev-btn]');
      const nextBtn = form.querySelector('[data-next-btn]');
      const submitBtn = form.querySelector('[data-submit-btn]');
      const totalSteps = 4;
      let current = 1;

      function render() {
        steps.forEach((s) => {
          const n = parseInt(s.getAttribute('data-step'));
          s.classList.toggle('hidden', n !== current);
        });
        stepBars.forEach((b) => {
          const n = parseInt(b.getAttribute('data-step-bar'));
          b.classList.toggle('bg-primary', n <= current);
          b.classList.toggle('bg-gray-200', n > current);
        });
        stepLabel.textContent = `Step ${current} of ${totalSteps}`;
        prevBtn.disabled = current === 1;
        nextBtn.classList.toggle('hidden', current === totalSteps);
        submitBtn.classList.toggle('hidden', current !== totalSteps);
      }

      // Option cards (steps 1, 2, 3) — click sets value + advances
      form.querySelectorAll('[data-option-value]').forEach((card) => {
        card.addEventListener('click', () => {
          const step = card.getAttribute('data-option-step');
          const value = card.getAttribute('data-option-value');
          // Mark selected within step (highlight border + ring)
          form.querySelectorAll(`[data-option-step="${step}"]`).forEach((c) => {
            c.classList.remove('border-primary', 'ring-4', 'ring-primary/30');
            c.classList.add('border-gray-300');
          });
          card.classList.remove('border-gray-300');
          card.classList.add('border-primary', 'ring-4', 'ring-primary/30');
          // Save to hidden input
          if (step === '1') document.getElementById('fence_type').value = value;
          if (step === '2') document.getElementById('size').value = value;
          if (step === '3') document.getElementById('timeline').value = value;
          // Auto-advance
          setTimeout(() => {
            if (current < totalSteps) {
              current++;
              render();
            }
          }, 250);
        });
      });

      nextBtn.addEventListener('click', () => {
        if (current < totalSteps) {
          current++;
          render();
        }
      });
      prevBtn.addEventListener('click', () => {
        if (current > 1) {
          current--;
          render();
        }
      });

      // Pre-fill ZIP from URL ?zip=XXXXX (deep link from header search)
      const params = new URLSearchParams(window.location.search);
      const zip = params.get('zip');
      if (zip) {
        const addr = document.getElementById('address');
        if (addr) addr.value = `Ocala area — ZIP ${zip}`;
      }

      render();
    })();
  </script>
</PageLayout>
