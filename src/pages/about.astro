---
import PageLayout from '@layouts/PageLayout.astro';
import FAQ from '@components/FAQ.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { BUSINESS } from '@data/business';

const faqs = [
  { q: 'Are you licensed and insured in Florida?', a: 'Yes — fully licensed Florida fence contractor and carrying full liability and workers\' comp insurance. We can provide our license number and certificate of insurance on request.' },
  { q: 'How long have you been installing fences in Marion County?', a: 'We\'ve been a family-owned fence company in Ocala since 2021. Five years of installs across every Marion County ZIP code.' },
  { q: 'Do you really speak Spanish?', a: 'Sí — Andri y todo el equipo somos bilingües. Talk to us in English or Spanish, your choice. The on-site estimate, contract, and install walk-through can all be done en español.' },
  { q: 'Why should I pick you over a national fence chain?', a: 'No call centers. No out-of-state bosses. Andri runs every install personally. Same crew start to finish. Local accountability — if something is off, you call him directly.' },
  { q: 'How fast can you install my fence?', a: '<strong>Less than 7 days</strong> from signed contract is the norm. Urgent jobs (pool inspection, new pet, HOA notice) we can do in 2-3 days when the schedule allows.' },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FenceContractor',
  '@id': 'https://ocalafenceinstall.com/about#business',
  name: BUSINESS.name,
  url: 'https://ocalafenceinstall.com/about',
  telephone: BUSINESS.phoneE164,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  founder: {
    '@type': 'Person',
    name: 'Andri Ramírez',
    jobTitle: 'Founder',
  },
  foundingDate: '2021',
  description: 'Family-owned fence installation company serving Marion County, FL. Bilingual English/Spanish team. Premium vinyl, DuraFence, aluminum, and pool fences with $0 down financing.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ocalafenceinstall.com' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://ocalafenceinstall.com/about' },
  ],
};
---

<PageLayout
  title={`About ${BUSINESS.name} | Family-Owned Marion County Fence Company`}
  description={`Family-owned fence company in Ocala, FL since 2021. Bilingual English/Spanish team. Built on trust. Powered by people. Backed by 5+ years in Marion County.`}
  activeNav="About"
  schemaJsonLd={[localBusinessSchema, breadcrumbSchema]}
>
  {/* Breadcrumb */}
  <div class="bg-highlight-50 border-b border-highlight-200 py-3">
    <div class="container-page">
      <nav class="text-sm text-accent" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2 text-accent/50">›</span>
        <span class="font-semibold text-primary">About</span>
      </nav>
    </div>
  </div>

  {/* HERO — narrower band (BJF style) */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/about/hero-aerial-fence.jpg"
        alt="Aerial view of an Ocala FL backyard with newly installed black aluminum fence"
        class="w-full h-full object-cover object-center"
        loading="eager"
        width="1920"
        height="600"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/85 via-primary-900/70 to-primary-900/55"></div>
    </div>

    <div class="container-page relative py-12 lg:py-16 text-center text-white">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-[1.05] tracking-tight mb-3 text-balance drop-shadow-2xl">
        About <span class="text-highlight">Ocala Fence Install</span>
      </h1>
      <p class="text-base lg:text-lg text-white/95 max-w-2xl mx-auto leading-relaxed drop-shadow font-semibold">
        Built on Trust. Powered by Family. Backed by 5+ Years in Marion County.
      </p>
    </div>
  </section>

  {/* SUB-NAV — 4 link buttons to actual sub-pages (BJF style) */}
  <section class="bg-white border-b border-gray-200">
    <div class="container-page py-6 lg:py-7">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4 max-w-5xl mx-auto">
        <a href="/about/reviews" class="group bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-[0.12em] text-[11px] lg:text-xs xl:text-sm h-20 lg:h-24 flex items-center justify-center text-center px-3 leading-tight transition-colors shadow-md hover:shadow-xl">
          Customer Reviews
        </a>
        <a href="/about/our-process" class="group bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-[0.12em] text-[11px] lg:text-xs xl:text-sm h-20 lg:h-24 flex items-center justify-center text-center px-3 leading-tight transition-colors shadow-md hover:shadow-xl">
          Our Process
        </a>
        <a href="/about/faqs" class="group bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-[0.12em] text-[11px] lg:text-xs xl:text-sm h-20 lg:h-24 flex items-center justify-center text-center px-3 leading-tight transition-colors shadow-md hover:shadow-xl">
          FAQs
        </a>
        <a href="/about/preparing" class="group bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-[0.12em] text-[11px] lg:text-xs xl:text-sm h-20 lg:h-24 flex items-center justify-center text-center px-3 leading-tight transition-colors shadow-md hover:shadow-xl">
          Preparing for Your Fence
        </a>
      </div>
    </div>
  </section>

  {/* INTRO — 2-col split: left text card with sub-nav links / right founder image */}
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start max-w-6xl mx-auto">
        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-3 text-balance leading-[1.05]">
            About Ocala Fence Install
          </h2>
          <div class="w-16 h-1 bg-primary mb-6"></div>
          <p class="text-lg lg:text-xl text-gray-700 mb-8 leading-relaxed">
            We make buying fences fast and easy so you can protect your loved ones and your investments.
          </p>

          <div class="text-2xl mb-3">⭐⭐⭐⭐⭐</div>
          <a href="/about/reviews" class="inline-block text-xs uppercase tracking-[0.2em] font-bold text-primary hover:text-primary-700 transition-colors">
            Read Customer Reviews →
          </a>
        </div>

        <div class="bg-white border border-gray-200 p-7 lg:p-9">
          <a href="/about/our-process" class="block py-4 border-b border-gray-200 hover:text-primary transition-colors group">
            <div class="flex items-center justify-between">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider">Our Process</span>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          <a href="#our-mission" class="block py-4 border-b border-gray-200 hover:text-primary transition-colors group">
            <div class="flex items-center justify-between">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider">Our Mission</span>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          <a href="/about/faqs" class="block py-4 border-b border-gray-200 hover:text-primary transition-colors group">
            <div class="flex items-center justify-between">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider">FAQs</span>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          <a href="/about/preparing" class="block py-4 hover:text-primary transition-colors group">
            <div class="flex items-center justify-between">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider flex items-center gap-3">
                <span class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center">
                  <svg class="w-3 h-3 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </span>
                Preparing for Your Fence
              </span>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* BODY INTRO — text + founder image */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
        <div>
          <p class="text-lg lg:text-xl text-gray-700 mb-6 leading-relaxed">
            <strong>Ocala Fence Install</strong> is a family-owned, full-service residential fence company dedicated to delivering <strong>exceptional customer service, premium fencing products, and a hassle-free experience</strong> from start to finish.
          </p>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            We believe buying a fence shouldn't be complicated, confusing, or stressful. That's why we've built a company that puts <strong>people first</strong> — from the Marion County families we serve to the local crew we work with — using <strong>proven processes and bilingual service</strong> to deliver consistent, reliable results at a fair price.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            We are a Florida fence company that uses <strong class="text-primary">modern installation techniques and a clear, transparent process</strong> to install fences that last decades — and look good doing it.
          </p>
        </div>

        <div class="relative">
          <img
            src="/images/about/founder-portrait.jpg"
            alt="Andri Ramírez, founder of Ocala Fence Install — Marion County's family-owned fence team"
            class="w-full aspect-[4/5] object-cover shadow-2xl"
            loading="lazy"
          />
          <div class="absolute -bottom-4 -right-4 bg-primary text-white px-6 py-4 shadow-xl border-l-4 border-highlight">
            <div class="text-xs uppercase tracking-[0.2em] font-bold text-highlight">Founder</div>
            <div class="text-xl font-extrabold">Andri Ramírez</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* OUR MISSION */}
  <section id="our-mission" class="bg-gray-50 py-16 lg:py-24 scroll-mt-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start max-w-6xl mx-auto">
        <div>
          <h2 class="text-5xl lg:text-6xl font-extrabold text-primary-900 mb-6 text-balance leading-[0.95]">
            Our Mission
          </h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-5">
            <strong>Ocala Fence Install</strong> is committed to being Marion County's leading fence company by upholding the highest standard of customer service and offering premium products at a fair price.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            We are improving the fencing experience in Florida by hiring great local people, using modern installation techniques, providing transparent estimates, and treating every customer's home like our own. By truly listening to what each family needs, we keep getting better at what we do — install after install.
          </p>
        </div>

        <div>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">We are improving the fencing experience in Marion County by:</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-7 h-7 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-lg text-gray-800"><strong>Hiring great local people</strong></span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-7 h-7 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-lg text-gray-800"><strong>Bilingual service</strong> — English &amp; español</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-7 h-7 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-lg text-gray-800"><strong>Providing fair, transparent estimates</strong></span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-7 h-7 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-lg text-gray-800"><strong>Delivering a hassle-free experience</strong> every time</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* HOW WE GOT STARTED — Andri's story (replaces BJF Franchise) */}
  <section class="bg-white py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
        <div class="relative">
          <img
            src="/images/about/team-installing.jpg"
            alt="Ocala Fence Install crew installing a vinyl privacy fence in a Marion County backyard"
            class="w-full aspect-[4/3] object-cover shadow-2xl"
            loading="lazy"
          />
          <div class="absolute -bottom-4 -left-4 bg-highlight px-5 py-3 shadow-xl">
            <div class="text-xs uppercase tracking-[0.2em] font-bold text-primary-900">Family-Owned</div>
            <div class="text-lg font-extrabold text-primary-900">Since 2021</div>
          </div>
        </div>

        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
            How We Got Started
          </h2>
          <p class="text-lg text-gray-700 mb-5 leading-relaxed">
            Like it does for many Marion County homeowners, the time came when our founder, <strong>Andri Ramírez</strong>, needed a fence for his own home in Ocala. He found that process more difficult and stressful than he'd ever imagined. The challenges that came from other fence companies were widespread, but one thing was clear — there was a problem in the Florida fence industry that needed to be solved.
          </p>

          <p class="text-base lg:text-lg italic text-gray-600 mb-3">Pain points with other Florida fence companies:</p>
          <ul class="text-gray-700 space-y-2 mb-6 text-base lg:text-lg">
            <li>• Slow or no responses</li>
            <li>• High prices with vague quotes</li>
            <li>• Limited fence options</li>
            <li>• English-only service in a bilingual market</li>
            <li>• Missed appointments &amp; conflicting schedules</li>
            <li>• Subcontracted crews with no accountability</li>
          </ul>

          <p class="text-lg text-gray-700 leading-relaxed">
            This led Andri to start <strong>Ocala Fence Install in 2021</strong> — with a goal to make buying fences fast, fair, and bilingual so Marion County families can protect their loved ones and investments without the headache.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* BUILT FOR GROWTH + READY TO START — 2 col CTA panel */}
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 max-w-6xl mx-auto">
        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
            Built for Growth.<br/>Focused on Service.
          </h2>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            Ocala Fence Install continues to grow — but our focus stays the same:
          </p>
          <ul class="space-y-4 mb-6">
            <li class="text-2xl lg:text-3xl font-extrabold text-primary-900">Hire great local people</li>
            <li class="text-2xl lg:text-3xl font-extrabold text-primary-900">Serve Marion County well</li>
            <li class="text-2xl lg:text-3xl font-extrabold text-primary-900">Improve every install</li>
            <li class="text-2xl lg:text-3xl font-extrabold text-primary-900">Deliver consistent quality</li>
          </ul>
          <p class="text-lg text-gray-700 leading-relaxed">
            Whether you're fencing a backyard, securing a pool, or replacing an old fence, you can trust Ocala Fence Install to deliver a professional experience from start to finish.
          </p>
        </div>

        <div class="lg:pl-10 lg:border-l border-gray-300">
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
            Ready to Get Started?
          </h2>
          <p class="text-lg text-gray-700 mb-5 leading-relaxed">
            If you're looking for a Marion County fence company that values <strong>transparency, quality, and customer experience</strong>, you're in the right place.
          </p>
          <p class="text-lg text-gray-700 mb-8 leading-relaxed">
            Add protection, privacy, and value to your home with Ocala Fence Install.
          </p>
          <a href="/free-estimate" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-700 text-white font-extrabold uppercase tracking-wider text-base px-12 py-5 shadow-lg transition-colors">
            Get Your Quote
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* PREPARING FOR YOUR FENCE INSTALLATION */}
  <section id="preparing" class="bg-white py-16 lg:py-24 scroll-mt-24">
    <div class="container-page text-center max-w-3xl mx-auto">
      <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
        Preparing for Your Fence Installation
      </h2>
      <p class="text-lg lg:text-xl text-gray-700 mb-7 leading-relaxed">
        A successful installation starts with preparation. We guide every Marion County customer through everything they need to know before installation day.
      </p>
      <a href="/blog/fence-installation-timeline-ocala" class="inline-flex items-center gap-2 text-primary hover:text-primary-700 font-extrabold text-lg lg:text-xl transition-colors">
        How to Prepare for Your Fence Installation
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  {/* OUR PROCESS — split image + text */}
  <section id="our-process" class="bg-gray-50 py-16 lg:py-24 scroll-mt-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-6 text-balance leading-[1.05]">
            Our Process: Simple, Transparent, Proven
          </h2>
          <p class="text-lg text-gray-700 mb-7 leading-relaxed">
            We've refined our process to eliminate confusion and keep your project moving smoothly from first contact to final walkthrough.
          </p>

          <p class="text-lg font-extrabold text-primary-900 mb-5">Here's what to expect:</p>
          <div class="space-y-5">
            <div>
              <h3 class="text-lg lg:text-xl font-extrabold text-primary-900 mb-1">Request an Estimate</h3>
              <p class="text-base lg:text-lg text-gray-700">— Fast, easy, and pressure-free. Same-day response Mon–Sun.</p>
            </div>
            <div>
              <h3 class="text-lg lg:text-xl font-extrabold text-primary-900 mb-1">On-Site Consultation</h3>
              <p class="text-base lg:text-lg text-gray-700">— We listen to your needs and recommend the right solution. Hablamos español.</p>
            </div>
            <div>
              <h3 class="text-lg lg:text-xl font-extrabold text-primary-900 mb-1">Scheduling &amp; Preparation</h3>
              <p class="text-base lg:text-lg text-gray-700">— Clear timelines. Permits handled. No surprises.</p>
            </div>
            <div>
              <h3 class="text-lg lg:text-xl font-extrabold text-primary-900 mb-1">Professional Installation</h3>
              <p class="text-base lg:text-lg text-gray-700">— Efficient, clean, and precise. Done in less than 7 days.</p>
            </div>
          </div>

          <a href="/our-process" class="inline-flex items-center gap-2 mt-8 text-primary hover:text-primary-700 font-extrabold text-lg transition-colors">
            View Our Full Fence Installation Process
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div>
          <img
            src="/images/about/process-consultation.jpg"
            alt="Ocala Fence Install on-site consultation with a Marion County homeowner"
            class="w-full aspect-[4/3] object-cover shadow-2xl border-4 border-primary"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {/* CUSTOMER REVIEWS — placeholder featured review + apart bullets */}
  <section id="customer-reviews" class="bg-white py-16 lg:py-24 scroll-mt-24">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
        <div class="relative aspect-square overflow-hidden shadow-2xl">
          <img
            src="/images/services/vinyl-privacy.jpg"
            alt="A finished vinyl privacy fence install for a Marion County customer"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-primary-900/70"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white p-8">
            <div class="text-xs uppercase tracking-[0.2em] font-bold text-highlight mb-2">Real Google Review</div>
            <div class="text-lg font-extrabold text-highlight mb-6">Maria G. · Marion Oaks</div>
            <p class="text-base lg:text-lg leading-relaxed mb-5">
              "Andri's team finished our vinyl fence in 4 days. Same crew start to finish. We're really happy with the result and the price was honest from the first visit. Hablan español también — eso fue clave para mí."
            </p>
            <div class="text-2xl">⭐⭐⭐⭐⭐</div>
          </div>
        </div>

        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold text-primary-900 mb-7 text-balance leading-[1.05]">
            What Sets Ocala Fence Install Apart
          </h2>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-7 h-7 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-lg text-gray-800">Exceptional customer service</span>
            </li>
            <li class="flex items-start gap-3">
