---
import { BUSINESS } from '@data/business';

interface Props {
  items?: { label: string; value: string }[];
}

const { items = BUSINESS.trustBadges } = Astro.props;
---

<section class="bg-highlight-100 border-y border-highlight-200">
  <div class="container-page py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
      {items.map((item) => (
        <div class="flex items-center gap-3 justify-center md:justify-start">
          <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-sm font-bold text-accent leading-tight">{item.value}</div>
            <div class="text-xs text-accent-700 leading-tight">{item.label}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
