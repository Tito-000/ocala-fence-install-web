---
// Minimal trust bar — 3 big bold items, single line
---

<section class="bg-highlight-100 border-y border-highlight-200">
  <div class="container-page py-5 lg:py-6">
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 lg:gap-x-12 text-accent">
      <div class="flex items-center gap-2.5">
        <svg class="w-6 h-6 lg:w-7 lg:h-7 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span class="text-sm sm:text-base lg:text-lg font-extrabold uppercase tracking-wider">5+ Years in Ocala</span>
      </div>

      <span class="hidden sm:inline w-1.5 h-1.5 rounded-full bg-accent/40"></span>

      <div class="flex items-center gap-2.5">
        <svg class="w-6 h-6 lg:w-7 lg:h-7 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-sm sm:text-base lg:text-lg font-extrabold uppercase tracking-wider">$0 Down Financing</span>
      </div>

      <span class="hidden sm:inline w-1.5 h-1.5 rounded-full bg-accent/40"></span>

      <div class="flex items-center gap-2.5">
        <svg class="w-6 h-6 lg:w-7 lg:h-7 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="text-sm sm:text-base lg:text-lg font-extrabold uppercase tracking-wider">Licensed &amp; Insured</span>
      </div>
    </div>
  </div>
</section>
