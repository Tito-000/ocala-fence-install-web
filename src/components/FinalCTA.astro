---
import { BUSINESS } from '@data/business';

interface Props {
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
}

const {
  title = 'Ready for your free estimate?',
  subtitle = 'Same-day quote · $0 down financing · Less than 7 days install',
  primaryCta = { label: 'Get Your Free Estimate', href: '/free-estimate' },
} = Astro.props;
---

<section class="bg-primary text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
  <div class="container-page relative py-16 lg:py-20 text-center">
    <h2 class="text-3xl lg:text-5xl font-extrabold mb-4 text-balance">{title}</h2>
    <p class="text-lg lg:text-xl text-white/90 mb-8 text-balance max-w-2xl mx-auto">{subtitle}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={primaryCta.href} class="btn bg-highlight text-gray-900 hover:bg-highlight-200 text-base px-8 py-4 font-bold">
        {primaryCta.label}
      </a>
      <a href={`tel:${BUSINESS.phoneE164}`} class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary text-base px-8 py-4" data-track="phone_click">
        Call {BUSINESS.phone}
      </a>
    </div>
  </div>
</section>
