---
interface Props {
  description: string;
  aspect?: 'square' | 'wide' | 'tall' | '4-3' | '16-9';
  rounded?: boolean;
  className?: string;
}

const { description, aspect = '4-3', rounded = true, className = '' } = Astro.props;

const aspectClasses = {
  'square': 'aspect-square',
  'wide': 'aspect-[16/10]',
  'tall': 'aspect-[3/4]',
  '4-3': 'aspect-[4/3]',
  '16-9': 'aspect-[16/9]',
};
---

<div class={`relative overflow-hidden bg-gradient-to-br from-primary-50 via-highlight-50 to-primary-100 ${rounded ? 'rounded-none' : ''} ${aspectClasses[aspect]} ${className}`}>
  <!-- Diagonal stripe pattern -->
  <div class="absolute inset-0 opacity-30" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 14px, rgba(19, 98, 41, 0.08) 14px, rgba(19, 98, 41, 0.08) 28px);"></div>

  <!-- Center content -->
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
    <div class="w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center mb-3">
      <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <span class="text-xs font-bold uppercase tracking-wider text-primary mb-1">Photo placeholder</span>
    <span class="text-sm text-gray-700 max-w-xs">{description}</span>
  </div>
</div>
