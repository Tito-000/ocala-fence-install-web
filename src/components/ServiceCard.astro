---
interface Props {
  slug: string;
  name: string;
  tagline?: string;
  image?: string;
  priceFromMonthly?: number;
  popular?: boolean;
}

const { slug, name, image, popular } = Astro.props;
---

<a
  href={`/services/${slug}`}
  class="group relative block rounded-none overflow-hidden aspect-[4/5] shadow-lg hover:shadow-2xl transition-all duration-300"
>
  {/* Background image */}
  {image ? (
    <img
      src={image}
      alt={name}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
      loading="lazy"
    />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700 to-primary-900 flex items-center justify-center text-white/40 text-9xl font-black">
      {name.charAt(0)}
    </div>
  )}

  {/* Dark overlay — bottom-up for text legibility */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent group-hover:from-black/90 group-hover:via-black/45 transition-all duration-300"></div>

  {/* Most Popular badge — top right */}
  {popular && (
    <span class="absolute top-3 right-3 bg-highlight text-primary-900 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded shadow-md">
      Most Popular
    </span>
  )}

  {/* Title only — bottom-centered, big white uppercase */}
  <div class="absolute inset-x-0 bottom-0 px-3 pb-5 lg:pb-6 text-center">
    <h3 class="text-white text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight leading-[1.05] drop-shadow-lg">
      {name}
    </h3>
  </div>
</a>
