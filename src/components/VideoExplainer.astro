---
// Video explainer section — replaces ProcessScrollyAnimation
// Uses optimized 720p MP4 with poster, lazy-loaded for performance
---

<section class="section bg-highlight-50 video-explainer">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14">
      <span class="badge-highlight mb-4">How It Works</span>
      <h2 class="mb-3 text-balance">From quote to install in less than 7 days</h2>
      <p class="text-gray-600 text-lg">Watch how we get your fence done — same crew, no surprises.</p>
    </div>

    <div class="video-wrapper">
      <video
        id="explainer-video"
        controls
        playsinline
        preload="metadata"
        poster="/videos/ocala-fence-explainer-poster.jpg"
        aria-label="Ocala Fence Install — explainer video showing the 7-day install process"
      >
        <source src="/videos/ocala-fence-explainer-720p.mp4" type="video/mp4" />
        <source src="/videos/ocala-fence-explainer.mp4" type="video/mp4" />
        Your browser doesn't support video playback.
        <a href="/videos/ocala-fence-explainer-720p.mp4">Download the video</a>.
      </video>

      <button class="play-overlay" type="button" aria-label="Play video">
        <svg viewBox="0 0 80 80" fill="none">
          <circle cx="40" cy="40" r="40" fill="rgba(19, 98, 41, 0.95)"/>
          <path d="M32 26L56 40L32 54V26Z" fill="white"/>
        </svg>
        <span class="play-label">Watch · 35 sec</span>
      </button>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/free-estimate" class="btn-primary">Get Your Free Quote</a>
      <a href="tel:+18633770928" class="btn-outline">Call (863) 377-0928</a>
    </div>
  </div>
</section>

<style>
  .video-explainer { padding: 5rem 0; }

  .video-wrapper {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 32px 64px -16px rgba(19, 98, 41, 0.25),
      0 16px 32px -8px rgba(0, 0, 0, 0.15);
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .video-wrapper video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.45) 100%);
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
    z-index: 2;
  }
  .play-overlay:hover { background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.55) 100%); }
  .play-overlay.is-hidden { display: none; }

  .play-overlay svg {
    width: 96px;
    height: 96px;
    filter: drop-shadow(0 8px 16px rgba(0,0,0,0.3));
    transition: transform 0.3s ease;
  }
  .play-overlay:hover svg { transform: scale(1.08); }

  .play-label {
    color: white;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(0,0,0,0.6);
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
</style>

<script>
  const video = document.getElementById('explainer-video') as HTMLVideoElement | null;
  const overlay = document.querySelector('.video-explainer .play-overlay') as HTMLButtonElement | null;

  if (video && overlay) {
    overlay.addEventListener('click', () => {
      overlay.classList.add('is-hidden');
      video.play();
    });
    video.addEventListener('play', () => overlay.classList.add('is-hidden'));
    video.addEventListener('pause', () => {
      // Keep overlay hidden once user has interacted — only show on initial state
    });
    video.addEventListener('ended', () => overlay.classList.remove('is-hidden'));
  }
</script>
