---
import { PRIMARY_NAV } from '@data/nav';
import { BUSINESS } from '@data/business';

interface Props {
  activeNav?: string;
}
const { activeNav } = Astro.props;
---

<style>
  /* Mega-menu panels — hidden by default, shown when triggered */
  .mega-menu-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 200ms ease-out, transform 200ms ease-out, visibility 200ms;
  }
  .mega-menu-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<header class="sticky top-0 z-40 bg-white shadow-sm">
  <!-- TOP BAR (dark) -->
  <div class="bg-gradient-to-r from-gray-900 via-gray-900 to-primary-900 text-white">
    <div class="container-page">
      <div class="flex items-center justify-between gap-4 py-3 lg:py-4">
        <!-- Logo (left) -->
        <a href="/" class="flex items-center gap-2 shrink-0" aria-label={BUSINESS.name}>
          <img
            src="/images/logo/master.jpeg"
            alt={BUSINESS.name}
            class="h-12 lg:h-14 w-auto rounded-none"
            loading="eager"
            width="180"
            height="56"
          />
        </a>

        <!-- Contact strip (center, desktop only) -->
        <div class="hidden lg:flex items-center gap-8 flex-1 justify-center">
          <a href={`tel:${BUSINESS.phoneE164}`} class="flex items-center gap-2 text-sm font-semibold hover:text-highlight transition-colors" data-track="click_phone">
            <svg class="w-5 h-5 text-highlight" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            <span class="text-base">{BUSINESS.phone}</span>
          </a>
          <div class="flex items-center gap-2 text-sm">
            <svg class="w-5 h-5 text-highlight" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            <div>
              <div class="text-xs text-white/70 leading-tight">Mon - Sun</div>
              <div class="font-semibold text-sm leading-tight">9:00 am - 9:00 pm</div>
            </div>
          </div>
        </div>

        <!-- CTAs (right) -->
        <div class="flex items-center gap-2 shrink-0">
          <a href="/free-estimate" class="hidden sm:inline-flex items-center bg-primary hover:bg-primary-700 text-white font-bold uppercase tracking-wider text-xs lg:text-sm px-4 lg:px-6 py-3 lg:py-3.5 rounded-none shadow transition-colors">
            Get Your Free Estimate
          </a>

          <!-- ZIP search (desktop only) -->
          <form action="/free-estimate" method="get" class="hidden xl:flex items-center gap-2 ml-3">
            <input
              type="text"
              name="zip"
              placeholder="Zip Code"
              maxlength="5"
              pattern="[0-9]{5}"
              class="w-28 h-12 px-4 text-sm font-medium rounded-none bg-white text-gray-900 border-0 focus:ring-2 focus:ring-highlight focus:outline-none placeholder:text-gray-500"
            />
            <button
              type="submit"
              class="w-12 h-12 bg-primary hover:bg-primary-700 text-white font-bold uppercase text-sm rounded-none border-2 border-white/30 transition-colors flex items-center justify-center"
              aria-label="Search by ZIP"
            >
              GO
            </button>
          </form>

          <!-- Mobile menu toggle -->
          <button
            type="button"
            class="lg:hidden inline-flex items-center justify-center p-2 rounded-none text-white hover:bg-white/10"
            aria-controls="mobile-menu"
            aria-expanded="false"
            id="mobile-menu-toggle"
          >
            <span class="sr-only">Open menu</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- NAV BAR (white) — wrapper hosts mega-menu full-width -->
  <div class="hidden lg:block border-b border-gray-200 bg-white relative" data-nav-wrapper>
    <div class="container-page">
      <nav class="flex items-center justify-center gap-1 py-3" aria-label="Primary">
        {PRIMARY_NAV.map((item) => {
          const isMega = item.label === 'Fence Types' || item.label === 'Areas' || item.label === 'About';
          return (
            <div class={`relative ${!isMega ? 'group' : ''}`} data-mega-trigger={isMega ? item.label : undefined}>
              <a
                href={item.href}
                class={`inline-flex items-center gap-1 px-4 py-2 text-sm font-bold uppercase tracking-wider rounded-none hover:text-primary transition-colors ${activeNav === item.label ? 'text-primary' : 'text-gray-800'}`}
              >
                {item.label}
                {item.children && <span class="text-xs">▾</span>}
              </a>

              {/* DROPDOWN — exact BJF replica: gray box, separators inside items (not full width), green stroke play icon */}
              {!isMega && item.children && (
                <div class="absolute top-full left-1/2 -translate-x-1/2 hidden group-hover:block bg-gray-100 shadow-2xl px-9 py-7 min-w-[460px] z-50">
                  {item.children.map((child, i) => (
                    <a
                      href={child.href}
                      class={`group/item flex items-center gap-3 py-5 hover:text-primary transition-colors ${i < item.children.length - 1 ? 'border-b border-gray-300' : ''}`}
                    >
                      {child.icon === 'play' && (
                        <span class="shrink-0 w-8 h-8 rounded-full border-2 border-primary bg-white flex items-center justify-center group-hover/item:bg-primary transition-colors">
                          <svg class="w-3 h-3 ml-0.5 text-primary group-hover/item:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        </span>
                      )}
                      <span class="text-xl font-extrabold uppercase tracking-wider text-gray-900 group-hover/item:text-primary transition-colors">{child.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>
    </div>

    {/* MEGA-MENU — Fence Types (square image cards, brand-coherent) */}
    <div
      class="mega-menu-panel absolute left-0 right-0 top-full z-50 bg-gradient-to-b from-primary-900 via-primary to-primary-700 text-white shadow-2xl border-t-2 border-highlight"
      data-mega-panel="Fence Types"
    >
      <div class="container-page py-8 lg:py-10">
        <div class="grid grid-cols-5 gap-6 lg:gap-8">
          {BUSINESS.services.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="group/card flex flex-col items-center text-center gap-3 hover:opacity-95 transition-opacity"
            >
              <div class="relative w-24 h-24 lg:w-28 lg:h-28 rounded-full overflow-hidden border-2 border-highlight/40 shadow-lg group-hover/card:border-highlight group-hover/card:scale-105 transition-all duration-300">
                {s.image ? (
                  <img src={s.image} alt={s.shortName} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-primary-700 flex items-center justify-center text-white/40 text-3xl font-extrabold">
                    {s.shortName.charAt(0)}
                  </div>
                )}
                <div class="absolute inset-0 rounded-full ring-1 ring-inset ring-black/20"></div>
              </div>
              <span class="text-white text-xs lg:text-sm font-bold leading-tight">{s.shortName}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    {/* MEGA-MENU — About (full-width gray band, BJF replica: title left + 2-col grid right with horizontal items + play icon) */}
    <div
      class="mega-menu-panel absolute left-0 right-0 top-full z-50 bg-gray-100 shadow-2xl border-t border-gray-200"
      data-mega-panel="About"
    >
      <div class="container-page py-12 lg:py-16">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start max-w-6xl mx-auto">
          {/* LEFT — title + tagline + stars + reviews link */}
          <div>
            <h2 class="text-3xl lg:text-4xl xl:text-5xl font-extrabold text-primary-900 mb-3 leading-[1.05]">
              About Ocala Fence Install
            </h2>
            <div class="w-16 h-1 bg-primary mb-6"></div>
            <p class="text-base lg:text-lg text-gray-700 mb-6 leading-relaxed">
              We make buying fences fast and easy so you can protect your loved ones and your investments.
            </p>
            <div class="text-2xl mb-3">⭐⭐⭐⭐⭐</div>
            <a href="/about/reviews" class="inline-block text-xs uppercase tracking-[0.2em] font-extrabold text-primary hover:text-primary-700 transition-colors">
              Read Customer Reviews →
            </a>
          </div>

          {/* RIGHT — 4 menu items with separators + play icon on last */}
          <div>
            <a href="/about/our-process" class="group/item flex items-center gap-3 py-4 border-b border-gray-300 hover:text-primary transition-colors">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider text-gray-900 group-hover/item:text-primary transition-colors">Our Process</span>
            </a>
            <a href="/about/our-mission" class="group/item flex items-center gap-3 py-4 border-b border-gray-300 hover:text-primary transition-colors">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider text-gray-900 group-hover/item:text-primary transition-colors">Our Mission</span>
            </a>
            <a href="/about/faqs" class="group/item flex items-center gap-3 py-4 border-b border-gray-300 hover:text-primary transition-colors">
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider text-gray-900 group-hover/item:text-primary transition-colors">FAQs</span>
            </a>
            <a href="/about/preparing" class="group/item flex items-center gap-3 py-4 hover:text-primary transition-colors">
              <span class="shrink-0 w-9 h-9 rounded-full border-2 border-primary bg-white flex items-center justify-center group-hover/item:bg-primary transition-colors">
                <svg class="w-3.5 h-3.5 ml-0.5 text-primary group-hover/item:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="text-xl lg:text-2xl font-extrabold uppercase tracking-wider text-gray-900 group-hover/item:text-primary transition-colors">Preparing for Your Fence</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* MEGA-MENU — Areas (square image cards, brand-coherent) */}
    <div
      class="mega-menu-panel absolute left-0 right-0 top-full z-50 bg-gradient-to-b from-primary-900 via-primary to-primary-700 text-white shadow-2xl border-t-2 border-highlight"
      data-mega-panel="Areas"
    >
      <div class="container-page py-8 lg:py-10">
        <div class="grid grid-cols-4 lg:grid-cols-8 gap-4 lg:gap-5">
          {BUSINESS.serviceAreas.map((c) => (
            <a
              href={`/areas/${c.slug}`}
              class="group/card flex flex-col items-center text-center gap-3 hover:opacity-95 transition-opacity"
            >
              <div class="relative w-20 h-20 lg:w-24 lg:h-24 rounded-full overflow-hidden border-2 border-highlight/40 shadow-lg group-hover/card:border-highlight group-hover/card:scale-105 transition-all duration-300">
                {c.image ? (
                  <img src={c.image} alt={c.name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-primary-700 flex items-center justify-center text-white/40 text-2xl font-extrabold">
                    {c.name.charAt(0)}
                  </div>
                )}
                <div class="absolute inset-0 rounded-full ring-1 ring-inset ring-black/20"></div>
              </div>
              <span class="text-white text-xs lg:text-sm font-bold leading-tight">{c.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- MOBILE MENU -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-200 bg-white">
    <nav class="container-page py-4 space-y-1" aria-label="Mobile primary">
      {PRIMARY_NAV.map((item) => (
        <details class="group">
          <summary class={`flex items-center justify-between px-3 py-2.5 text-base font-medium rounded-none hover:bg-gray-50 cursor-pointer ${item.children ? '' : 'list-none'}`}>
            <a href={item.href} class="flex-1">{item.label}</a>
            {item.children && <span class="text-xs group-open:rotate-180 transition-transform">▾</span>}
          </summary>
          {item.children && (
            <div class="ml-4 mt-1 mb-2 space-y-1">
              {item.children.map((child) => (
                <a href={child.href} class="block px-3 py-2 text-sm text-gray-600 hover:bg-primary-50 hover:text-primary rounded-none">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </details>
      ))}
      <div class="pt-4 mt-4 border-t border-gray-200 space-y-2">
        <a href={`tel:${BUSINESS.phoneE164}`} class="btn-outline w-full" data-track="click_phone">
          Call {BUSINESS.phone}
        </a>
        <a href="/free-estimate" class="btn-primary w-full">
          Free Estimate
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', (e) => {
    const btn = e.currentTarget;
    const menu = document.getElementById('mobile-menu');
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  // Mega-menu hover handling — show panel matching trigger, hide others
  (() => {
    const wrapper = document.querySelector('[data-nav-wrapper]');
    if (!wrapper) return;
    const triggers = wrapper.querySelectorAll('[data-mega-trigger]');
    const panels = wrapper.querySelectorAll('[data-mega-panel]');
    let hideTimer;

    function showPanel(name) {
      clearTimeout(hideTimer);
      panels.forEach((p) => {
        p.classList.toggle('is-open', p.getAttribute('data-mega-panel') === name);
      });
    }
    function scheduleHide() {
      hideTimer = setTimeout(() => {
        panels.forEach((p) => p.classList.remove('is-open'));
      }, 150);
    }

    triggers.forEach((t) => {
      const name = t.getAttribute('data-mega-trigger');
      t.addEventListener('mouseenter', () => showPanel(name));
      t.addEventListener('mouseleave', scheduleHide);
    });
    panels.forEach((p) => {
      p.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      p.addEventListener('mouseleave', scheduleHide);
    });
  })();
</script>
