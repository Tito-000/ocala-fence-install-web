---
import { BUSINESS } from '@data/business';

interface Props {
  minAmount?: number;
  maxAmount?: number;
  defaultAmount?: number;
  defaultMonths?: number;
  defaultApr?: number;
  compact?: boolean;
}

const {
  minAmount = 2000,
  maxAmount = 20000,
  defaultAmount = 7500,
  defaultMonths = BUSINESS.financing.defaultMonths,
  defaultApr = BUSINESS.financing.typicalApr,
  compact = false,
} = Astro.props;
---

<div class={`grid md:grid-cols-[1.4fr_1fr] gap-6 lg:gap-8 ${compact ? '' : 'max-w-5xl mx-auto'}`} data-financing-calc>
  {/* Inputs panel */}
  <div class="bg-primary-900 text-white p-7 lg:p-9 shadow-xl">
    <div class="mb-7">
      <label class="flex items-center justify-between text-base font-extrabold mb-3">
        <span>Fence Financing Amount ($) <span class="text-highlight">*</span></span>
      </label>
      <input
        type="number"
        min={minAmount}
        max={maxAmount}
        step="100"
        value={defaultAmount}
        data-fc-amount
        class="w-full bg-white/10 border-2 border-white/20 focus:border-highlight px-4 py-3 text-2xl font-extrabold text-white placeholder-white/40 outline-none transition-colors"
        aria-label="Fence cost"
      />
      <p class="text-xs text-white/60 mt-2">Min: ${minAmount.toLocaleString()} — Max: ${maxAmount.toLocaleString()}</p>
    </div>

    <div class="mb-7">
      <label class="flex items-center justify-between text-base font-extrabold mb-3">
        <span>Interest Rate (APR)</span>
        <span data-fc-apr-display class="text-highlight text-lg">{defaultApr}%</span>
      </label>
      <input
        type="range"
        min="0"
        max="15"
        step="0.25"
        value={defaultApr}
        data-fc-apr
        class="w-full accent-highlight"
        aria-label="APR"
      />
      <div class="flex justify-between text-xs text-white/60 mt-1">
        <span>0%</span>
        <span>15%</span>
      </div>
    </div>

    <div>
      <label class="flex items-center justify-between text-base font-extrabold mb-3">
        <span>Length of Loan</span>
        <span data-fc-term-display class="text-highlight text-lg">{defaultMonths} months</span>
      </label>
      <input
        type="range"
        min={BUSINESS.financing.minMonths}
        max={BUSINESS.financing.maxMonths}
        step="12"
        value={defaultMonths}
        data-fc-term
        class="w-full accent-highlight"
        aria-label="Loan term"
      />
      <div class="flex justify-between text-xs text-white/60 mt-1">
        <span>{BUSINESS.financing.minMonths} mo</span>
        <span>{BUSINESS.financing.maxMonths} mo</span>
      </div>
    </div>
  </div>

  {/* Summary panel */}
  <div class="bg-primary-900 text-white p-7 lg:p-9 shadow-xl flex flex-col justify-center">
    <div class="text-xs uppercase tracking-[0.2em] font-bold text-highlight mb-2">Summary</div>
    <div class="flex items-baseline justify-between border-b border-white/20 pb-5 mb-5">
      <div class="text-xl lg:text-2xl font-extrabold">Monthly Payment</div>
      <div class="text-3xl lg:text-4xl font-extrabold text-highlight" data-fc-payment>$148</div>
    </div>
    <div class="space-y-3 text-sm lg:text-base">
      <div class="flex justify-between text-white/85">
        <span>Total of Payments</span>
        <span data-fc-total class="font-bold">$8,907</span>
      </div>
      <div class="flex justify-between text-white/85">
        <span>Total Interest</span>
        <span data-fc-interest class="font-bold">$1,407</span>
      </div>
    </div>
    <a
      href="/free-estimate"
      class="mt-7 inline-flex items-center justify-center gap-2 bg-highlight hover:bg-highlight/90 text-primary-900 font-extrabold uppercase tracking-wider text-sm px-6 py-4 shadow-lg transition-colors"
      data-track="lead_calculator_used"
    >
      Pre-Qualify Now
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
    </a>
    <p class="text-[11px] text-white/55 mt-3 leading-relaxed">
      * Estimate only. $0 down · No credit impact · {BUSINESS.financing.preQualifyTime} pre-qualify. Final terms depend on lender, credit, and approval.
    </p>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-financing-calc]').forEach((calc) => {
    const amountInput = calc.querySelector('[data-fc-amount]');
    const termSlider = calc.querySelector('[data-fc-term]');
    const aprSlider = calc.querySelector('[data-fc-apr]');
    const termDisplay = calc.querySelector('[data-fc-term-display]');
    const aprDisplay = calc.querySelector('[data-fc-apr-display]');
    const paymentDisplay = calc.querySelector('[data-fc-payment]');
    const totalDisplay = calc.querySelector('[data-fc-total]');
    const interestDisplay = calc.querySelector('[data-fc-interest]');

    function fmt(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    function pmt(p, r, n) {
      if (r === 0) return p / n;
      const monthlyRate = r / 100 / 12;
      return (p * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -n));
    }

    function update() {
      const amount = Math.max(0, +amountInput.value || 0);
      const term = +termSlider.value || 1;
      const apr = +aprSlider.value || 0;
      termDisplay.textContent = term + ' months';
      aprDisplay.textContent = apr.toFixed(2) + '%';
      const monthly = pmt(amount, apr, term);
      const total = monthly * term;
      const interest = Math.max(0, total - amount);
      paymentDisplay.textContent = fmt(monthly);
      totalDisplay.textContent = fmt(total);
      interestDisplay.textContent = fmt(interest);
    }

    [amountInput, termSlider, aprSlider].forEach((s) => s.addEventListener('input', update));
    update();

    // Track first interaction (once per session)
    let tracked = false;
    [amountInput, termSlider, aprSlider].forEach((s) => {
      s.addEventListener('change', () => {
        if (tracked) return;
        tracked = true;
        if (window.gtag) gtag('event', 'lead_calculator_used');
      });
    });
  });
</script>
