---
interface Step {
  n: number;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
}

interface Props {
  steps?: Step[];
}

const defaultSteps: Step[] = [
  {
    n: 1,
    title: 'Get a Quick Quote',
    body: 'Submit our 60-second form or call Andry direct. Same-day phone response — we give you a ballpark range so you know what to expect.',
    image: '/images/process/01-quote.jpg',
    imageAlt: 'Ocala homeowner filling out a fence quote request form on their phone',
  },
  {
    n: 2,
    title: 'Free On-Site Estimate',
    body: 'We come measure within 24-48 hours. Written quote on the spot — no phone games, no surprise charges.',
    image: '/images/process/02-estimate.jpg',
    imageAlt: 'Ocala Fence Install contractor measuring a Florida residential backyard with a tape measure',
  },
  {
    n: 3,
    title: 'We Install',
    body: 'Our own crew, no subcontractors. Most fences finished in less than 7 days from signed contract. Urgent? 2-3 days possible.',
    image: '/images/process/03-install.jpg',
    imageAlt: 'Ocala Fence Install crew installing a white vinyl privacy fence in a Florida backyard',
  },
  {
    n: 4,
    title: 'Enjoy & Relax',
    body: 'Walk-through when 100% happy. Lifetime materials warranty + 1-year workmanship. Transferable to next homeowner.',
    image: '/images/process/04-enjoy.jpg',
    imageAlt: 'Happy Florida homeowner couple enjoying their newly installed fence in their backyard',
  },
];

const { steps = defaultSteps } = Astro.props;
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
  {steps.map((step) => (
    <div class="group">
      {/* Image with number badge */}
      <div class="relative aspect-square rounded-none overflow-hidden shadow-lg group-hover:shadow-2xl transition-all">
        <img
          src={step.image}
          alt={step.imageAlt}
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        {/* Subtle gradient on top edge so the badge reads cleanly */}
        <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/40 to-transparent pointer-events-none"></div>
        {/* Number badge — top left circle */}
        <div class="absolute top-4 left-4 w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-primary border-2 border-white shadow-xl flex items-center justify-center">
          <span class="text-white text-xl lg:text-2xl font-extrabold leading-none">
            {step.n}
          </span>
        </div>
      </div>

      {/* Title + body below image */}
      <div class="text-center mt-5 lg:mt-6">
        <h3 class="text-lg lg:text-xl font-extrabold mb-2 text-gray-900">
          {step.title}
        </h3>
        <p class="text-sm lg:text-base text-gray-600 leading-relaxed max-w-xs mx-auto">
          {step.body}
        </p>
      </div>
    </div>
  ))}
</div>
