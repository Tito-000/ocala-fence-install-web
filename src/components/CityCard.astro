---
interface Props {
  slug: string;
  name: string;
  state: string;
  county?: string;
  primaryZip?: string;
  image?: string;
}

const { slug, name, state, county, primaryZip, image } = Astro.props;
---

<a
  href={`/areas/${slug}`}
  class="group relative block aspect-[4/3] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300"
>
  {/* Background image */}
  {image ? (
    <img
      src={image}
      alt={`${name}, ${state} — fence installation service area`}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
      loading="lazy"
    />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-primary-700 to-primary-900"></div>
  )}

  {/* Dark overlay — bottom-up for text legibility */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/15 group-hover:from-black/90 group-hover:via-black/50 transition-all"></div>

  {/* Content — bottom */}
  <div class="absolute inset-x-0 bottom-0 p-5 lg:p-6">
    <div class="flex items-end justify-between gap-3">
      <div class="min-w-0">
        <h3 class="text-white text-xl lg:text-2xl font-extrabold uppercase leading-tight drop-shadow-lg">
          {name}, {state}
        </h3>
        {(county || primaryZip) && (
          <p class="text-white/85 text-xs lg:text-sm font-semibold mt-1 drop-shadow">
            {county}{primaryZip && ` · ${primaryZip}`}
          </p>
        )}
      </div>
      <svg class="shrink-0 w-6 h-6 text-white opacity-80 group-hover:opacity-100 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
