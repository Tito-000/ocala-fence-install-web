---
import '../styles/global.css';
import { BUSINESS } from '@data/business';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'es';
  alternateLanguages?: { lang: string; href: string }[];
  schemaJsonLd?: object | object[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image = '/images/og/default.webp',
  noindex = false,
  lang = 'en',
  alternateLanguages = [],
  schemaJsonLd,
} = Astro.props;

const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;

// Analytics IDs (from env)
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;
// Hotjar — heatmaps + session recordings (public site ID, not a secret).
const HOTJAR_ID = import.meta.env.PUBLIC_HOTJAR_ID || '6746771';

// Google Ads conversion tracking (AW id + per-action labels).
// These are PUBLIC conversion IDs (visible in page source — not secrets),
// so they ship as defaults and work on deploy; an env var still overrides
// them if ever needed. Conversion actions live in Google Ads account
// 310-158-7931 ("Ocala Fence Install"): OFI - Lead Form Submit / WhatsApp
// Click / Phone Call Click.
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-18276061492';
const GADS_LABEL_LEAD = import.meta.env.PUBLIC_GADS_LABEL_LEAD || 'l3J4CMuf3MYcELSi2opE';
const GADS_LABEL_CALL = import.meta.env.PUBLIC_GADS_LABEL_CALL || '99lWCNGf3MYcELSi2opE';
const GADS_LABEL_WHATSAPP = import.meta.env.PUBLIC_GADS_LABEL_WHATSAPP || 'nLy1CM6f3MYcELSi2opE';
const GADS_LABEL_EMAIL = import.meta.env.PUBLIC_GADS_LABEL_EMAIL || 'zqQpCMXDpsocELSi2opE';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- hreflang -->
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  {alternateLanguages.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={alt.href} />
  ))}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={BUSINESS.name} />
  <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Theme -->
  <meta name="theme-color" content={BUSINESS.colors.primary} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />

  <!-- Schema JSON-LD -->
  {schemaJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} />
  )}

  <!-- GA4 -->
  {GA4_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID, { send_page_view: true });
      </script>
    </>
  )}

  <!-- Google Ads — reuses the gtag.js already loaded by GA4; loads it
       standalone if GA4 is absent. Conversions fire from the track() helper. -->
  {GOOGLE_ADS_ID && (
    <>
      {!GA4_ID && (
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}></script>
      )}
      <script is:inline define:vars={{ GOOGLE_ADS_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){dataLayer.push(arguments);};
        gtag('js', new Date());
        gtag('config', GOOGLE_ADS_ID);
      </script>
    </>
  )}

  <!-- Meta Pixel -->
  {META_PIXEL_ID && (
    <script is:inline define:vars={{ META_PIXEL_ID }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', META_PIXEL_ID);
      fbq('track', 'PageView');
    </script>
  )}

  <!-- Hotjar — heatmaps + session recordings (see where visitors drop off) -->
  {HOTJAR_ID && (
    <script is:inline define:vars={{ HOTJAR_ID }}>
      (function (h, o, t, j, a, r) {
        h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments); };
        h._hjSettings = { hjid: Number(HOTJAR_ID), hjsv: 6 };
        a = o.getElementsByTagName('head')[0];
        r = o.createElement('script'); r.async = 1;
        r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
        a.appendChild(r);
      })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
    </script>
  )}

  <!-- Global event tracking — fires GA4 + Google Ads conversions + Meta Pixel -->
  <script is:inline define:vars={{ GOOGLE_ADS_ID, GADS_LABEL_LEAD, GADS_LABEL_CALL, GADS_LABEL_WHATSAPP, GADS_LABEL_EMAIL }}>
    (() => {
      // Map key events to their Google Ads conversion label. A placeholder
      // label (e.g. the email one until its action exists) simply won't
      // match a real conversion, so nothing breaks.
      var GADS_LABELS = {
        lead_form_submit: GADS_LABEL_LEAD,
        phone_click:      GADS_LABEL_CALL,
        whatsapp_click:   GADS_LABEL_WHATSAPP,
        click_email:      GADS_LABEL_EMAIL,
      };
      var GADS_PLACEHOLDER = 'GADS_EMAIL_LABEL';

      // Helper: send event to GA4 + Google Ads + (optionally) Meta Pixel
      function track(eventName, params) {
        params = params || {};
        if (window.gtag) gtag('event', eventName, params);

        // Google Ads conversion (only for mapped key events, only if configured)
        if (window.gtag && GOOGLE_ADS_ID) {
          var label = GADS_LABELS[eventName];
          if (label && label !== GADS_PLACEHOLDER) {
            gtag('event', 'conversion', { send_to: GOOGLE_ADS_ID + '/' + label });
          }
        }

        // Map key events to Meta Pixel standard events
        if (window.fbq) {
          if (eventName === 'lead_form_submit')   fbq('track', 'Lead', params);
          else if (eventName === 'phone_click')    fbq('track', 'Contact');
          else if (eventName === 'whatsapp_click') fbq('track', 'Contact');
          else if (eventName === 'click_email')    fbq('track', 'Contact');
          else if (eventName === 'cta_estimate_click') fbq('trackCustom', 'CTAEstimateClick', params);
        }
      }
      window.__track = track;

      // 0. Capture Google click IDs on ANY page and persist them, so the
      // lead form can attach them to the contact (offline conversion import).
      try {
        var _q = new URLSearchParams(window.location.search);
        ['gclid', 'wbraid', 'gbraid'].forEach(function (k) {
          var v = _q.get(k);
          if (v) { try { localStorage.setItem('ofi_' + k, v); } catch (_) {} }
        });
      } catch (_) {}

      // Infer a contact conversion from a link's href, so EVERY phone,
      // WhatsApp and email link is counted even if it has no data-track.
      function contactEventFromHref(href) {
        if (!href) return '';
        if (href.indexOf('tel:') === 0) return 'phone_click';
        if (/wa\.me|whatsapp\.com|api\.whatsapp/.test(href)) return 'whatsapp_click';
        if (href.indexOf('mailto:') === 0) return 'click_email';
        return '';
      }

      // Someone who taps "call" never submits the form, so their Google click
      // id dies in the browser and the sale they close on that call can never
      // be sent back to Google. This records the click id in the CRM at the
      // moment of the tap, so a won deal from that call can be attributed.
      //
      // Fires at most once per visitor (sessionStorage) — a person who taps
      // call three times is one lead, not three. keepalive lets the request
      // survive the browser leaving the page to open the dialer.
      function recordCallIntent(source) {
        try {
          if (sessionStorage.getItem('ofi_call_recorded')) return;
          var gclid = '';
          try {
            gclid = new URLSearchParams(window.location.search).get('gclid')
                 || localStorage.getItem('ofi_gclid') || '';
          } catch (_) {}
          // No click id means nothing to attribute — don't clutter the CRM.
          if (!gclid) return;
          sessionStorage.setItem('ofi_call_recorded', '1');
          fetch('/api/call-intent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              gclid: gclid,
              source: source,
              page: window.location.pathname,
            }),
          }).catch(function () {});
        } catch (_) {}
      }

      // 1. Unified click listener — fires the right conversion for any
      // [data-track] element AND auto-detects contact links by href.
      // Bubble phase + try/catch so tracking never breaks the interaction.
      document.addEventListener('click', (e) => {
        try {
          if (!e.target || !e.target.closest) return;
          const el = e.target.closest('[data-track]');
          const a = e.target.closest('a');
          let eventName = el ? el.getAttribute('data-track') : '';
          if (eventName === 'click_phone') eventName = 'phone_click'; // legacy alias
          if (!eventName && a) {
            eventName = contactEventFromHref(a.getAttribute('href') || a.href || '');
          }
          if (!eventName) return;
          const node = el || a;
          track(eventName, {
            link_url: (a && a.href) ? a.href : '',
            link_text: ((node && node.textContent) || '').trim().slice(0, 80),
          });
          if (eventName === 'phone_click' || eventName === 'whatsapp_click') {
            recordCallIntent(eventName);
          }
        } catch (_) { /* never break the page */ }
      });

      // 2. CTA Estimate clicks (any link to /free-estimate)
      document.addEventListener('click', (e) => {
        try {
          if (!e.target || !e.target.closest) return;
          const a = e.target.closest('a[href*="/free-estimate"]');
          if (!a) return;
          // Skip if the element already has data-track (avoid double-firing)
          if (a.hasAttribute('data-track')) return;
          track('cta_estimate_click', { link_text: (a.textContent || '').trim().slice(0, 80) });
        } catch (_) { /* never break the page */ }
      });

      // 3. Scroll 75% (fires once per page)
      let scrolled75 = false;
      window.addEventListener('scroll', () => {
        if (scrolled75) return;
        const h = document.documentElement;
        const scrollTop = h.scrollTop || document.body.scrollTop;
        const scrollHeight = h.scrollHeight || document.body.scrollHeight;
        const clientHeight = h.clientHeight;
        const pct = (scrollTop + clientHeight) / scrollHeight;
        if (pct >= 0.75) {
          scrolled75 = true;
          track('engaged_scroll', { percent: 75 });
        }
      }, { passive: true });

      // 4. Time on page > 60s (fires once per page)
      setTimeout(() => track('engaged_time', { seconds: 60 }), 60000);
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-900">
  <slot />
</body>
</html>
